        box-shadow: 0 1px 3px rgba(56, 65, 74, .08);
    }

    .opd-left {
        background: #f8f8fb;
        border-right-color: #eff0f2;
    }

    .left-section,
    .right-block {
        border-bottom-color: #eff0f2;
    }

    .left-section-title,
    .hist-section-title,
    .field-label {
        color: #74788d;
        letter-spacing: .35px;
    }

    .vital-input-card,
    .hist-item,
    .history-visit-card {
        border-color: #eff0f2;
        border-radius: 4px;
        box-shadow: none;
    }

    .vital-input-card input,
    .field-input,
    .field-textarea,
    .search-input,
    .hist-form-input,
    .hist-form-select,
    .hist-form-textarea,
    .when-select,
    .days-input {
        border-color: #ced4da;
        border-radius: 4px;
        color: #495057;
        font-family: inherit;
        background: #fff;
    }

    .field-input,
    .field-textarea,
    .search-input {
        box-shadow: none;
    }

    .field-input:focus,
    .field-textarea:focus,
    .search-input:focus,
    .hist-form-input:focus,
    .hist-form-select:focus,
    .hist-form-textarea:focus {
        border-color: #aab6f4;
        box-shadow: 0 0 0 .15rem rgba(85, 110, 230, .12);
    }

    .right-block {
        padding: 20px 22px;
    }

    .block-title {
        color: #495057;
        font-size: 15px;
        font-weight: 600;
    }

    .block-title .block-icon {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        background: #eef1ff;
        color: #556ee6;
    }

    .btn-add-hist,
    .btn-block-action,
    .btn-hist-cancel {
        border-radius: 4px;
        background: #fff;
        border-color: #ced4da;
        color: #556ee6;
    }

    .btn-hist-save,
    .freq-chip.active,
    .timing-toggle.active,
    .followup-chip.active {
        background: #556ee6;
        border-color: #556ee6;
    }

    .hist-form-panel,
    .upload-area,
    .opd-right .rx-table thead tr {
        border-radius: 4px;
        background: #f8f8fb;
    }

    .upload-area {
        border-color: #ced4da;
    }

    .rx-table th {
        color: #74788d;
        background: #f8f8fb;
    }

    .save-bar {
        padding: 12px 22px;
        background: #fff;
        border-top-color: #eff0f2;
    }

    @@media (max-width: 900px) {
        .opd-toolbar {
            margin: 0 -12px;
        }

        .opd-workspace {
            height: auto;
            min-height: 0;
        }

        .opd-section-nav {
            margin: 0 -12px;
            padding: 0 10px;
        }

        .opd-section-nav a {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>

<input type="hidden" id="hf_OPDId" value="@Model.Id" />
<input type="hidden" id="hf_AppointmentId" value="@Model.AppointmentId" />
<input type="hidden" id="hf_PatientId" value="@Model.PatientId" />

@* ══════════ TOP TOOLBAR ══════════ *@
<div class="opd-toolbar">
    <div class="patient-header">
        <div class="patient-avatar" id="patientAvatar">?</div>
        <div>
            <div class="patient-name" id="patientNameDisplay">Loading...</div>
            <div class="patient-meta" id="patientMetaDisplay">—</div>
        </div>
    </div>
    <div class="toolbar-actions">
@{
            var backUrl = ViewBag.IsWalkIn == true
                ? Url.Action("Index", "WalkInConsultation")
                : Url.Action("Index", "OPDAppointment");
        }
        <a href="@backUrl" class="btn-toolbar-action">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>Back
        </a>
    </div>
</div>

<div class="opd-section-nav" aria-label="Consultation sections">
    <a href="#opdSymptoms" class="active"><i class="fas fa-notes-medical"></i> Consultation</a>
    <a href="#opdDiagnosis"><i class="fas fa-stethoscope"></i> Diagnosis</a>
    <a href="#opdMedicines"><i class="fas fa-pills"></i> Medicines</a>
    <a href="#opdFollowup"><i class="fas fa-calendar-check"></i> Follow-up</a>
</div>

<div class="opd-workspace">

    @* ══════════ LEFT PANEL ══════════ *@
    <div class="opd-left">

        @* — Vitals — *@
        <div class="left-section">
            <div class="left-section-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                Vitals &amp; Body Composition
            </div>
            <div class="vitals-grid">
                <div class="vital-input-card"><label>Temperature</label><input type="text" id="vit_temp" placeholder="98.6" /><div class="vital-unit">°F (97–99)</div></div>
                <div class="vital-input-card"><label>Pulse Rate</label><input type="text" id="vit_pulse_left" placeholder="72" /><div class="vital-unit">bpm</div></div>
                <div class="vital-input-card"><label>BP Systolic</label><input type="text" id="vit_bp_sys" placeholder="120" /><div class="vital-unit">mmHg</div></div>
                <div class="vital-input-card"><label>BP Diastolic</label><input type="text" id="vit_bp_dia" placeholder="80" /><div class="vital-unit">mmHg</div></div>
                <div class="vital-input-card"><label>SPO₂</label><input type="text" id="vit_spo2" placeholder="98" /><div class="vital-unit">% (95–100)</div></div>
                <div class="vital-input-card"><label>RBS</label><input type="text" id="vit_rbs" placeholder="100" /><div class="vital-unit">mg/dL</div></div>
                <div class="vital-input-card"><label>Weight</label><input type="text" id="vit_weight" placeholder="70" /><div class="vital-unit">kg</div></div>
                <div class="vital-input-card"><label>Height</label><input type="text" id="vit_height" placeholder="170" /><div class="vital-unit">cm</div></div>
                <div class="vital-input-card"><label>Respiration</label><input type="text" id="vit_resp" placeholder="16" /><div class="vital-unit">breaths/min</div></div>
                <div class="vital-input-card"><label>Waist</label><input type="text" id="vit_waist" placeholder="85" /><div class="vital-unit">cm</div></div>
                <div class="vital-input-card" style="grid-column:span 2;"><label>FIB-4 Index</label><input type="text" id="vit_fib4" placeholder="e.g. 1.3" /><div class="vital-unit">Liver fibrosis score</div></div>
            </div>
            <div id="bmiDisplay" style="margin-top:8px;font-size:12px;color:var(--clr-muted);display:none;">
                BMI: <strong id="bmiValue"></strong> <span id="bmiCategory"></span>
            </div>
            <button class="btn-add-hist" style="margin-top:10px;width:100%;justify-content:center;" onclick="saveVitals()">💾 Save Vitals</button>
        </div>

        @* — Medical Conditions — *@
        <div class="left-section">
            <div class="hist-section-header">
                <div class="hist-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4" /><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                    Medical Conditions
                </div>
                <button class="btn-add-hist" onclick="toggleHistForm('condForm')">+ Add</button>
            </div>
            <div class="hist-form-panel" id="condForm">
                <input type="hidden" id="condId" value="0" />
                <div class="hist-form-row">
                    <label class="hist-form-label">Condition Name *</label>
                    <input type="text" class="hist-form-input" id="condName" placeholder="e.g. Diabetes, Hypertension..." />
                </div>
                {{! ✅ FIX: Duration Since row - full width with flex inline }}
                <div class="hist-form-row">
                    <label class="hist-form-label">Duration Since</label>
                    <div style="display:flex;gap:6px;">
                        <input type="number" class="hist-form-input" id="condDays" placeholder="e.g. 3" min="0" style="flex:1;min-width:0;" />
                        <select class="hist-form-select" id="condSinceUnit" style="flex:0 0 100px;">
                            <option value="Hours">Hours</option>
                            <option value="Days" selected>Days</option>
                            <option value="Months">Months</option>
                            <option value="Years">Years</option>
                        </select>
                    </div>
                </div>
                {{! ✅ FIX: Status on its own full-width row — no longer gets cut off }}
                <div class="hist-form-row">
                    <label class="hist-form-label">Status</label>
                    <select class="hist-form-select" id="condStatus">
                        <option value="Active">Active</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </div>
                <div class="hist-form-row" style="flex-direction:row;align-items:center;gap:8px;">
                    <input type="checkbox" id="condOnMed" style="width:16px;height:16px;cursor:pointer;" />
                    <label for="condOnMed" class="hist-form-label" style="margin:0;cursor:pointer;">On Medication</label>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Notes</label>
                    <textarea class="hist-form-textarea" id="condNotes" placeholder="Additional details..."></textarea>
                </div>
                <div class="hist-form-actions">
                    <button class="btn-hist-save" onclick="saveCondition()">Save</button>
                    <button class="btn-hist-cancel" onclick="closeHistForm('condForm')">Cancel</button>
                </div>
            </div>
            <div id="condList"><div class="empty-state" id="condEmpty">No conditions recorded</div></div>
        </div>

        @* — Allergies — *@
        <div class="left-section">
            <div class="hist-section-header">
                <div class="hist-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Allergies
                </div>
                <button class="btn-add-hist" onclick="toggleHistForm('allergyForm')">+ Add</button>
            </div>
            <div class="hist-form-panel" id="allergyForm">
                <input type="hidden" id="allergyId" value="0" />
                <div class="hist-form-row">
                    <label class="hist-form-label">Allergic To *</label>
                    <input type="text" class="hist-form-input" id="allergyTo" placeholder="e.g. Penicillin, Peanuts, Dust..." />
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Since</label>
                    <div style="display:flex;gap:6px;">
                        <input type="number" class="hist-form-input" id="allergySince" placeholder="e.g. 2" min="0" style="flex:1;min-width:0;" />
                        <select class="hist-form-select" id="allergySinceUnit" style="flex:0 0 100px;">
                            <option value="Hours" selected>Hours</option>
                            <option value="Days">Days</option>
                            <option value="Months">Months</option>
                            <option value="Years">Years</option>
                        </select>
                    </div>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Status</label>
                    <select class="hist-form-select" id="allergyStatus">
                        <option value="Active">Active</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Notes</label>
                    <textarea class="hist-form-textarea" id="allergyNotes" placeholder="Reaction description..."></textarea>
                </div>
                <div class="hist-form-actions">
                    <button class="btn-hist-save" onclick="saveAllergy()">Save</button>
                    <button class="btn-hist-cancel" onclick="closeHistForm('allergyForm')">Cancel</button>
                </div>
            </div>
            <div id="allergyList"><div class="empty-state" id="allergyEmpty">No allergies recorded</div></div>
        </div>

        @* — Surgical History — *@
        <div class="left-section">
            <div class="hist-section-header">
                <div class="hist-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    Surgical History
                </div>
                <button class="btn-add-hist" onclick="toggleHistForm('surgForm')">+ Add</button>
            </div>
            <div class="hist-form-panel" id="surgForm">
                <input type="hidden" id="surgId" value="0" />
                <div class="hist-form-row">
                    <label class="hist-form-label">Procedure Name *</label>
                    <input type="text" class="hist-form-input" id="surgName" placeholder="e.g. Appendectomy, CABG..." />
                </div>
                <div class="hist-form-grid2-wide">
                    <div class="hist-form-row">
                        <label class="hist-form-label">Surgery Date</label>
                        <input type="date" class="hist-form-input" id="surgDate" />
                    </div>
                    <div class="hist-form-row">
                        <label class="hist-form-label">Location / Site</label>
                        <input type="text" class="hist-form-input" id="surgLocation" placeholder="e.g. Abdomen" />
                    </div>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Notes</label>
                    <textarea class="hist-form-textarea" id="surgNotes" placeholder="Complications, hospital..."></textarea>
                </div>
                <div class="hist-form-actions">
                    <button class="btn-hist-save" onclick="saveSurgery()">Save</button>
                    <button class="btn-hist-cancel" onclick="closeHistForm('surgForm')">Cancel</button>
                </div>
            </div>
            <div id="surgList"><div class="empty-state" id="surgEmpty">No surgical history recorded</div></div>
        </div>

        @* — Family History — *@
        <div class="left-section">
            <div class="hist-section-header">
                <div class="hist-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    Family History
                </div>
                <button class="btn-add-hist" onclick="toggleHistForm('famForm')">+ Add</button>
            </div>
            <div class="hist-form-panel" id="famForm">
                <input type="hidden" id="famId" value="0" />
                <div class="hist-form-row">
                    <label class="hist-form-label">Relation *</label>
                    <select class="hist-form-select" id="famRelation">
                        <option value="">Select...</option>
                        <option value="Father">Father</option>
                        <option value="Mother">Mother</option>
                        <option value="Brother">Brother</option>
                        <option value="Sister">Sister</option>
                        <option value="Son">Son</option>
                        <option value="Daughter">Daughter</option>
                        <option value="Grandfather">Grandfather</option>
                        <option value="Grandmother">Grandmother</option>
                        <option value="Uncle">Uncle</option>
                        <option value="Aunt">Aunt</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Condition *</label>
                    <input type="text" class="hist-form-input" id="famCondition" placeholder="e.g. Diabetes..." />
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Notes</label>
                    <textarea class="hist-form-textarea" id="famNotes" placeholder="Age of onset, severity..."></textarea>
                </div>
                <div class="hist-form-actions">
                    <button class="btn-hist-save" onclick="saveFamilyHistory()">Save</button>
                    <button class="btn-hist-cancel" onclick="closeHistForm('famForm')">Cancel</button>
                </div>
            </div>
            <div id="famList"><div class="empty-state" id="famEmpty">No family history recorded</div></div>
        </div>

        @* — Lab Results — *@
        <div class="left-section">
            <div class="hist-section-header">
                <div class="hist-section-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                    Lab Results
                </div>
                <button class="btn-add-hist" onclick="toggleHistForm('labForm')">+ Add</button>
            </div>
            <div class="hist-form-panel" id="labForm">
                <input type="hidden" id="labId" value="0" />
                <div class="hist-form-row">
                    <label class="hist-form-label">Test Name *</label>
                    <input type="text" class="hist-form-input" id="labTest" placeholder="e.g. HbA1c, CBC, LFT..." />
                </div>
                <div class="hist-form-grid2-wide">
                    <div class="hist-form-row">
                        <label class="hist-form-label">Result Value</label>
                        <input type="text" class="hist-form-input" id="labResult" placeholder="e.g. 7.2" />
                    </div>
                    <div class="hist-form-row">
                        <label class="hist-form-label">Unit</label>
                        <input type="text" class="hist-form-input" id="labUnit" placeholder="e.g. %" />
                    </div>
                </div>
                <div class="hist-form-grid2-wide">
                    <div class="hist-form-row">
                        <label class="hist-form-label">Normal Range</label>
                        <input type="text" class="hist-form-input" id="labRange" placeholder="e.g. 4–5.6%" />
                    </div>
                    <div class="hist-form-row">
                        <label class="hist-form-label">Result Date</label>
                        <input type="date" class="hist-form-input" id="labDate" />
                    </div>
                </div>
                <div class="hist-form-row" style="flex-direction:row;align-items:center;gap:8px;">
                    <input type="checkbox" id="labAbnormal" style="width:16px;height:16px;cursor:pointer;" />
                    <label for="labAbnormal" class="hist-form-label" style="margin:0;color:var(--clr-danger);cursor:pointer;">Mark as Abnormal</label>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Notes</label>
                    <textarea class="hist-form-textarea" id="labNotes" placeholder="Clinical interpretation..."></textarea>
                </div>
                <div class="hist-form-row">
                    <label class="hist-form-label">Upload Report (PDF/Image)</label>
                    <input type="file" class="hist-form-input" id="labFile" accept=".pdf,.jpg,.jpeg,.png" style="padding:4px;" />
                </div>
                <div class="hist-form-actions">
                    <button class="btn-hist-save" onclick="saveLabResult()">Save</button>
                    <button class="btn-hist-cancel" onclick="closeHistForm('labForm')">Cancel</button>
                </div>
            </div>
            <div id="labList"><div class="empty-state" id="labEmpty">No lab results recorded</div></div>
        </div>

        @* — Past Visits — *@
        <div class="left-section">
            <div class="left-section-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                Past Visits
            </div>
            <div id="historyLoadingLeft" class="history-loading">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin .8s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg> Loading...
            </div>
            <div class="history-timeline" id="historyTimeline"></div>
            <div class="empty-state" id="historyEmpty" style="display:none;">No past visits found</div>
        </div>

        @* — Private Notes — *@
        <div class="left-section">
            <div class="left-section-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                Private Notes
                <span style="margin-left:auto;font-size:10px;color:var(--clr-danger);background:var(--clr-danger-lt);padding:2px 6px;border-radius:4px;">Internal Only</span>
            </div>
            <textarea class="private-notes-area" id="privateNotes" placeholder="Internal clinical notes (not shown on prescription)..."></textarea>
        </div>

    </div><!-- /opd-left -->
    @* ══════════ RIGHT PANEL ══════════ *@
    <div class="opd-right">

        @* — Symptoms — *@
        <div class="right-block" id="opdSymptoms">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">🤒</div>Symptoms (Chief Complaints)</div>
                <div class="block-actions">
                    <button class="btn-block-action" onclick="clearSymptoms()">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>Clear
                    </button>
                </div>
            </div>
            <div class="search-input-wrap" style="position:relative;">
                <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" class="search-input" id="symptomSearch" placeholder="Search symptoms..." autocomplete="off" oninput="filterSymptoms(this.value)" />
                <div class="autocomplete-dropdown" id="symptomDropdown"></div>
            </div>
            <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
                <span style="font-size:12px;color:var(--clr-muted);white-space:nowrap;">Since:</span>
                <input type="number" id="symSinceVal" placeholder="e.g. 3" min="0" style="width:70px;padding:4px 6px;border:1px solid var(--clr-border);border-radius:6px;font-size:12px;" />
                <select id="symSinceUnit" style="padding:4px 6px;border:1px solid var(--clr-border);border-radius:6px;font-size:12px;">
                    <option value="Hours">Hours</option>
                    <option value="Days" selected>Days</option>
                    <option value="Months">Months</option>
                    <option value="Years">Years</option>
                </select>
                <button type="button" class="btn-add-hist" id="btnAddSymptom" onclick="confirmAddSymptom()" style="display:none;">+ Add</button>
            </div>
            <div class="chips-container" id="symptomChips">
                <div class="empty-state" style="padding:12px 0;"><div>Type to search, set Since, then click + Add</div></div>
            </div>
        </div>

        @* — Examination — *@
        <div class="right-block" id="opdDiagnosis">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">🩺</div>Examination &amp; Vitals</div>
            </div>
            <div class="vitals-row">
                <div class="field-group">
                    <label class="field-label">Blood Pressure</label>
                    <input type="text" class="field-input" id="fld_bp" value="@Model.BP" placeholder="120/80 mmHg" />
                </div>
                <div class="field-group">
                    <label class="field-label">Pulse Rate</label>
                    <input type="text" class="field-input" id="fld_pulse" value="@Model.Pulse" placeholder="72 bpm" />
                </div>
                
                <div class="field-group">
                    <label class="field-label">Respiration</label>
                    <input type="text" class="field-input" id="fld_resp" placeholder="16 /min" />
                </div>
            </div>
        </div>

        @* — Diagnosis — *@
        <div class="right-block" id="opdMedicines">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">🧠</div>Diagnosis &amp; DDx</div>
                <div class="block-actions">
                    <button class="btn-ddx-ai" onclick="runDDxAI()">✨ DDx Assistant</button>
                    <button class="btn-block-action" onclick="clearDiagnosis()">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>Clear
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:8px;margin-bottom:10px;">
                <button class="freq-chip active" id="diagTypeFinal" onclick="setDiagType('Final',this)">Final</button>
                <button class="freq-chip" id="diagTypeProvisional" onclick="setDiagType('Provisional',this)">Provisional / DDx</button>
            </div>
            <div class="search-input-wrap" style="position:relative;">
                <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" class="search-input" id="diagSearch" placeholder="Type diagnosis and press Enter, or search..." autocomplete="off" oninput="filterDiagnosis(this.value)" onkeydown="diagEnterKey(event)" />
                <div class="autocomplete-dropdown" id="diagDropdown"></div>
            </div>
            <div class="chips-container" id="diagChips">
                <div class="empty-state" style="padding:12px 0;"><div>Type a diagnosis name and press Enter to add</div></div>
            </div>
            <div id="ddxPanel" style="display:none;margin-top:12px;background:var(--clr-surface);border:1.5px solid #e9d5ff;border-radius:var(--radius-md);padding:12px;">
                <div style="font-size:12px;font-weight:700;color:var(--clr-primary);margin-bottom:8px;">✨ AI Suggested Differentials</div>
                <div id="ddxList"></div>
            </div>
        </div>

        @* — Investigation — *@
        <div class="right-block" id="opdFollowup">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">🔬</div>Investigation &amp; Examination Notes</div>
            </div>
            <textarea class="field-textarea" id="fld_investigation" rows="4" placeholder="Enter clinical examination findings, lab orders, radiology requests...">@Model.Investigation</textarea>
        </div>

        @* — Report + Upload — *@
        <div class="right-block">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">📄</div>Report Detail &amp; Upload</div>
            </div>
            <textarea class="field-textarea" id="fld_reportDetail" rows="3" placeholder="Enter report interpretation, diagnosis notes...">@Model.ReportDetail</textarea>
            <div style="margin-top:12px;">
                <label class="field-label" style="margin-bottom:6px;display:block;">Attach Report File</label>
                <div class="upload-area" onclick="document.getElementById('reportFileInput').click()">
                    <div style="font-size:22px;">📎</div>
                    <div class="upload-text" id="uploadLabel">Click to upload report (PDF, JPG, PNG)</div>
                    <input type="file" id="reportFileInput" name="ReportFile" form="opdForm" accept=".pdf,.jpg,.jpeg,.png" onchange="handleFileSelect(this)" />
                </div>
                <div class="selected-file-actions" id="selectedReportActions">
                    <span class="file-name" id="selectedReportName"></span>
                    <a class="file-action" id="viewSelectedReport" href="#" target="_blank" rel="noopener">View selected report</a>
                    <button type="button" class="file-action" onclick="clearSelectedReport(event)">Remove</button>
                </div>
                @if (!string.IsNullOrEmpty(Model.ReportFilePath))
                {
                    <a href="@Model.ReportFilePath" target="_blank" class="existing-file-link">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>View existing report
                    </a>
                }
            </div>
        </div>

        @* — Medications — *@
        <div class="right-block">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">💊</div>Medications (Rx)</div>
                <div class="block-actions">
                    <button class="btn-block-action" onclick="clearMedicines()">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>Clear All
                    </button>
                </div>
            </div>
            <div style="background:var(--clr-surface);border:1.5px solid var(--clr-border);border-radius:var(--radius-md);padding:14px;margin-bottom:14px;">
                <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end;margin-bottom:12px;">
                    <div class="field-group">
                        <label class="field-label">Search Drug</label>
                        <div class="search-input-wrap" style="position:relative;">
                            <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                            <input type="text" class="search-input" id="medicineSearch" placeholder="Search medicine by name..." autocomplete="off" oninput="filterMedicines(this.value)" />
                            <div class="autocomplete-dropdown" id="medicineDropdown"></div>
                        </div>
                        <input type="hidden" id="selectedMedicineId" value="0" />
                        <div id="selectedMedicineName" style="font-size:12px;color:var(--clr-primary);margin-top:4px;"></div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Days</label>
                        <input type="number" class="days-input" id="rxDays" value="5" min="1" max="365" style="width:70px;padding:9px 10px;font-size:14px;" />
                    </div>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;">
                    <div>
                        <div class="field-label" style="margin-bottom:5px;">Frequency</div>
                        <div class="freq-chips">
                            <button class="freq-chip" onclick="setFreq(this,'OD',1,0,0)">OD</button>
                            <button class="freq-chip" onclick="setFreq(this,'BD',1,0,1)">BD</button>
                            <button class="freq-chip active" onclick="setFreq(this,'TDS',1,1,1)">TDS</button>
                            <button class="freq-chip" onclick="setFreq(this,'QID',1,1,1)">QID</button>
                            <button class="freq-chip" onclick="setFreq(this,'PRN',0,0,0)">PRN</button>
                        </div>
                    </div>
                    <div>
                        <div class="field-label" style="margin-bottom:5px;">Timing</div>
                        <div class="timing-toggles">
                            <button class="timing-toggle active" id="tog_morning" onclick="toggleTiming(this,'morning')" title="Morning">M</button>
                            <button class="timing-toggle active" id="tog_afternoon" onclick="toggleTiming(this,'afternoon')" title="Afternoon">A</button>
                            <button class="timing-toggle active" id="tog_evening" onclick="toggleTiming(this,'evening')" title="Evening">E</button>
                        </div>
                    </div>
                    <div>
                        <div class="field-label" style="margin-bottom:5px;">When</div>
                        <select class="when-select" id="rxWhen">
                            <option value="After Food">After Food</option>
                            <option value="Before Food">Before Food</option>
                            <option value="With Food">With Food</option>
                            <option value="Empty Stomach">Empty Stomach</option>
                            <option value="Bedtime">Bedtime</option>
                            <option value="SOS">SOS / As Needed</option>
                        </select>
                    </div>
                    <div style="margin-left:auto;">
                        <button class="btn-toolbar-action btn-primary-action" onclick="addMedicine()" style="padding:8px 16px;">+ Add Medicine</button>
                    </div>
                </div>
            </div>
            <div id="rxTableWrap">
                @* {{! ✅ CHANGED: Column order is now #, Medicine, M, A, E, When, Days, Total Qty, Action }} *@
                <table class="rx-table" id="rxTable" style="display:none;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Medicine</th>
                            <th>M</th>
                            <th>A</th>
                            <th>E</th>
                            <th>When</th>
                            <th>Days</th>
                            <th>Total Qty</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="rxTableBody"></tbody>
                </table>
                <div class="empty-state" id="rxEmpty">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                    <div>No medicines added yet</div>
                </div>
            </div>
        </div>

        @* — Follow-up — *@
        <div class="right-block">
            <div class="block-header">
                <div class="block-title"><div class="block-icon">📅</div>Follow-up &amp; Next Appointment</div>
            </div>
            <div class="field-group" style="max-width:220px;">
                <label class="field-label">Next Visit Date</label>
                <input type="date" class="field-input" id="fld_followup" value="@(Model.NextAppointmentDate?.ToString("yyyy-MM-dd"))" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="followup-chips">
                <button class="followup-chip" onclick="setFollowup(2)">2 Days</button>
                <button class="followup-chip" onclick="setFollowup(7)">1 Week</button>
                <button class="followup-chip" onclick="setFollowup(14)">2 Weeks</button>
                <button class="followup-chip" onclick="setFollowup(30)">1 Month</button>
                <button class="followup-chip" onclick="setFollowup(90)">3 Months</button>
            </div>
        </div>

        @* — Save Bar — *@
        <div class="save-bar">
            <span style="font-size:12px;color:var(--clr-muted);" id="autoSaveStatus"></span>
            <div style="margin-left:auto; display:flex; gap:10px; align-items:center;">
                @if (Model.AppointmentId > 0)
                {
                    <a href="@Url.Action("PrintPriscription", "Patient", new { appointmentId = Model.AppointmentId })" target="_blank" class="btn btn-secondary btn-sm">
                        📄 Print Rx
                    </a>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.location='@backUrl';">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="submitOPD('save')" id="btnSaveBottom">
                    @if (Model.Id > 0)
                    {
                        <text>💾 Update OPD</text>
                    }
                    else
                    {
                        <text>💾 Save OPD</text>
                    }
                </button>
             
            </div>
        </div>

    </div><!-- /opd-right -->
</div><!-- /opd-workspace -->

<form id="opdForm" method="post" asp-action="AddOPD" asp-controller="Patient" enctype="multipart/form-data" style="display:none;">
    <input type="hidden" name="Id" id="form_Id" value="@Model.Id" />
    <input type="hidden" name="AppointmentId" id="form_AppointmentId" value="@Model.AppointmentId" />
    <input type="hidden" name="PatientId" id="form_PatientId" value="@Model.PatientId" />
    <input type="hidden" name="HospitalId" id="form_HospitalId" value="@Model.HospitalId" />
    <input type="hidden" name="SubHospitalId" id="form_SubHospitalId" value="@(Model.SubHospitalId?.ToString() ?? string.Empty)" />
    <input type="hidden" name="BP" id="form_BP" />
    <input type="hidden" name="Pulse" id="form_Pulse" />
    <input type="hidden" name="Investigation" id="form_Investigation" />
    <input type="hidden" name="ReportDetail" id="form_ReportDetail" />
    <input type="hidden" name="NextAppointmentDate" id="form_NextAppointmentDate" />
    <input type="hidden" name="SymptomsJson" id="form_SymptomsJson" />
    <input type="hidden" name="MedicinesJson" id="form_MedicinesJson" />
    <input type="hidden" name="DiagnosesJson" id="form_DiagnosesJson" />
</form>

<div class="toast-container-custom" id="toastContainer"></div>

@section Scripts {
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script>
        /* ════════ STATE ════════ */
        var S = {
            opdId:         parseInt($('#hf_OPDId').val())         || 0,
            appointmentId: parseInt($('#hf_AppointmentId').val()) || 0,
            patientId:     parseInt($('#hf_PatientId').val())     || 0,
            symptoms: [], medicines: [], diagnosis: [],
            allSymptoms: [], allMedicines: [], allDiagnosis: [],
            timing: { morning:true, afternoon:true, evening:true },
            diagType: 'Final'
        };
        var _cond=[], _allergy=[], _surg=[], _fam=[], _lab=[];

        /* ════════ INIT ════════ */
        $(function(){
            loadMasterData(); loadPatientInfo(); loadPatientHistory();
            if (S.patientId) reloadFullHistory();
            if (S.opdId > 0) { loadExistingSymptoms(); loadExistingMedicines(); loadExistingDiagnosis(); }
            initBMICalc(); closeDropdownsOnClickOutside();
        });

        /* ════════ MASTER DATA ════════ */
        function loadMasterData(){
            $.getJSON('@Url.Action("GetAllSymptoms", "Patient")', function(d){ S.allSymptoms = d||[]; });
            $.getJSON('@Url.Action("GetAllMedicines", "Patient")', function(d){ S.allMedicines = d||[]; });
            $.getJSON('/PatientHistory/GetDiagnosisMaster', function(d){ S.allDiagnosis = d||[]; }).fail(function(){ S.allDiagnosis=[]; });
        }

        /* ════════ PATIENT INFO ════════ */
        function loadPatientInfo(){
            if (!S.patientId) return;
            $.getJSON('/Patient/GetPatientInfo?patientId='+S.patientId, function(d){
                if (!d) return;
                var name = ((d.firstName||'')+' '+(d.lastName||'')).trim()||'Patient';
                $('#patientNameDisplay').text(name);
                $('#patientMetaDisplay').text([d.gender, d.age?d.age+'y':'', d.phoneNumber].filter(Boolean).join(' · '));
                $('#patientAvatar').text(name.split(' ').map(function(w){return w[0]||'';}).slice(0,2).join('').toUpperCase()||'?');
            }).fail(function(){
                $('#patientNameDisplay').text('Patient #'+S.patientId);
                $('#patientMetaDisplay').text('Appt #'+S.appointmentId);
                $('#patientAvatar').text('P');
            });
        }

        /* ════════ PAST VISITS ════════ */
        function loadPatientHistory(){
            if (!S.patientId){ $('#historyLoadingLeft').hide(); $('#historyEmpty').show(); return; }
            $.getJSON('/OPDAppointment/GetPatientHistory?patientId='+S.patientId, function(visits){
                $('#historyLoadingLeft').hide();
                if (!visits||!visits.length){ $('#historyEmpty').show(); return; }
                $('#historyTimeline').html(visits.map(function(v){
                    var date = v.appointmentDate ? new Date(v.appointmentDate).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—';
                    var sc = (v.symptom||[]).slice(0,3).map(function(s){ return '<span class="visit-chip">'+h(s)+'</span>'; }).join('');
                    var mc = (v.medicines||[]).slice(0,2).map(function(m){ return '<span class="visit-chip med">'+h(m.medicineName||'')+'</span>'; }).join('');
                    return '<div class="history-visit-card"><div class="visit-date">'+date+'</div><div class="visit-meta">BP: '+(v.bp||'—')+' · Pulse: '+(v.pulse||'—')+'</div><div class="visit-chips">'+sc+mc+'</div></div>';
                }).join(''));
            }).fail(function(){ $('#historyLoadingLeft').hide(); $('#historyEmpty').show(); });
        }

        /* ════════ FULL MEDICAL HISTORY ════════ */
        function reloadFullHistory(){
            $.getJSON('/PatientHistory/GetFullHistory?patientId='+S.patientId, function(d){
                if (!d) return;
                _cond    = d.conditions    || [];
                _allergy = d.allergies     || [];
                _surg    = d.surgeries     || [];
                _fam     = d.familyHistory || [];
                _lab     = d.labResults    || [];
                renderConditions(); renderAllergies(); renderSurgeries(); renderFamilyHistory(); renderLabResults();
