        /* ════════ MEDICINES ════════ */
              /* ── SYRUP DETECTION HELPER ── */
        function isSyrupMedicine(name){
            var kw=['syrup','susp','suspension','linctus','elixir'];
            var lo=name.toLowerCase();
            return kw.some(function(k){return lo.includes(k);});
        }
        function calcTotalQty(m){
            var doses=(m.Morning==='1'?1:0)+(m.Afternoon==='1'?1:0)+(m.Evening==='1'?1:0);
            if(m.IsSyrup){
                var ml=doses*m.Days*5;
                var btl=Math.ceil(ml/100);
                return btl+(btl>1?' Btls':' Btl');
            }
            return doses*m.Days;
        }

        function filterMedicines(q){
            var dd=$('#medicineDropdown'); if(!q){dd.removeClass('show');return;}
            var m=S.allMedicines.filter(function(x){return x.name.toLowerCase().includes(q.toLowerCase());}).slice(0,12);
            if(!m.length){dd.removeClass('show');return;}
            dd.html(m.map(function(x){return '<div class="autocomplete-item" onclick="selectMedicine('+x.id+',\''+j(x.name)+'\')">'+h(x.name)+'</div>';}).join('')).addClass('show');
        }
        function selectMedicine(id,name){ $('#selectedMedicineId').val(id); $('#selectedMedicineName').text('✔ '+name); $('#medicineSearch').val(name); $('#medicineDropdown').removeClass('show'); }
        function toggleTiming(btn,field){ S.timing[field]=!S.timing[field]; $(btn).toggleClass('active',S.timing[field]); }
        function setFreq(btn,label,m,a,e){
            $('.freq-chip').removeClass('active'); $(btn).addClass('active');
            S.timing.morning=!!m; S.timing.afternoon=!!a; S.timing.evening=!!e;
            $('#tog_morning').toggleClass('active',!!m); $('#tog_afternoon').toggleClass('active',!!a); $('#tog_evening').toggleClass('active',!!e);
        }
        function addMedicine(){
            var id=parseInt($('#selectedMedicineId').val())||0, name=$('#medicineSearch').val().trim(), days=parseInt($('#rxDays').val())||1, when=$('#rxWhen').val();
            if(!id||!name){showToast('Select a medicine first','error');return;}
            if(S.medicines.some(function(m){return m.MedicineId===id;})){showToast('Already added','error');return;}
            var med={MedicineId:id,MedicineName:name,Morning:S.timing.morning?'1':'0',Afternoon:S.timing.afternoon?'1':'0',Evening:S.timing.evening?'1':'0',Days:days,When:when,IsSyrup:isSyrupMedicine(name)};
            S.medicines.push(med); renderRxTable(); updateMedicinesJson();
            $.get('/Patient/SaveMedicines',{Command:id,_Morning:med.Morning,_Afternoon:med.Afternoon,_Evening:med.Evening,_Days:days});
            $('#medicineSearch').val(''); $('#selectedMedicineId').val(0); $('#selectedMedicineName').text('');
            showToast(name+' added to Rx','success');
        }
        function removeMedicine(id){ S.medicines=S.medicines.filter(function(m){return m.MedicineId!==id;}); renderRxTable(); updateMedicinesJson(); $.get('/Patient/DeleteMedicines',{Command:id}); }
        function clearMedicines(){ S.medicines.forEach(function(m){$.get('/Patient/DeleteMedicines',{Command:m.MedicineId});}); S.medicines=[]; renderRxTable(); updateMedicinesJson(); }

        function renderRxTable(){
            if(!S.medicines.length){$('#rxTable').hide();$('#rxEmpty').show();return;}
            $('#rxEmpty').hide(); $('#rxTable').show();
            $('#rxTableBody').html(S.medicines.map(function(m,i){
                var freq=(m.Morning==='1'?1:0)+(m.Afternoon==='1'?1:0)+(m.Evening==='1'?1:0);
                var defaultQty=m.IsSyrup ? calcTotalQty(m) : (m.Quantity||freq*m.Days);
                var qtyDisplay=m.IsSyrup
                    ? '<span style="font-size:13px;font-weight:500;color:var(--clr-primary);padding:6px 8px;display:inline-block;">'+calcTotalQty(m)+'</span>'
                    : '<input type="number" class="days-input" value="'+(m.Quantity||freq*m.Days)+'" min="1" style="width:55px;" onchange="updateQty('+m.MedicineId+',this.value)"/>';
                return '<tr>' +
                    '<td>'+(i+1)+'</td>' +
                    '<td><strong>'+h(m.MedicineName)+'</strong></td>' +
                    '<td><span class="timing-toggle '+(m.Morning==='1'?'active':'')+'" style="cursor:default;">M</span></td>' +
                    '<td><span class="timing-toggle '+(m.Afternoon==='1'?'active':'')+'" style="cursor:default;">A</span></td>' +
                    '<td><span class="timing-toggle '+(m.Evening==='1'?'active':'')+'" style="cursor:default;">E</span></td>' +
                    '<td><span style="font-size:12px;color:var(--clr-muted);">'+h(m.When||'')+'</span></td>' +
                    '<td><input type="number" class="days-input" value="'+m.Days+'" min="1" onchange="updateDays('+m.MedicineId+',this.value)"/></td>' +
                    '<td>'+qtyDisplay+'</td>' +
                    '<td><button class="btn-delete-row" onclick="removeMedicine('+m.MedicineId+')">✕</button></td>' +
                    '</tr>';
            }).join(''));
        }

        function updateDays(id,val){
            var m=S.medicines.find(function(x){return x.MedicineId===id;});
            if(m){ m.Days=parseInt(val)||1; updateMedicinesJson(); renderRxTable(); }
        }
        function updateQty(id,val){
            var m=S.medicines.find(function(x){return x.MedicineId===id;});
            if(m){ m.Quantity=parseInt(val)||1; updateMedicinesJson(); }
        }
        function updateMedicinesJson(){
            $('#form_MedicinesJson').val(JSON.stringify(S.medicines.map(function(m){
                var f=(m.Morning==='1'?1:0)+(m.Afternoon==='1'?1:0)+(m.Evening==='1'?1:0);
                var qty=m.IsSyrup ? Math.ceil(f*m.Days*5/100) : (m.Quantity||f*m.Days);
                return{MedicineId:m.MedicineId,Morning:m.Morning,Afternoon:m.Afternoon,Evening:m.Evening,Days:m.Days,Quantity:qty};
            })));
        }
        function loadExistingMedicines(){
            $.getJSON('/Patient/GetMedicinesByOPDIdJson?opdId='+S.opdId,function(data){
                if(!data)return;
                S.medicines=data.map(function(m){
                    return{MedicineId:m.medicineId,MedicineName:m.medicineName,Morning:m.morning.toString(),Afternoon:m.afternoon.toString(),Evening:m.evening.toString(),Days:m.days,Quantity:m.quantity,When:m.when||'After Food',IsSyrup:isSyrupMedicine(m.medicineName)};
                });
                renderRxTable(); updateMedicinesJson();
            });
        }

        /* ════════ FOLLOW-UP ════════ */
        function setFollowup(days){ var d=new Date(); d.setDate(d.getDate()+days); $('#fld_followup').val(d.toISOString().split('T')[0]); $('.followup-chip').removeClass('active'); event.target.classList.add('active'); }

        /* ════════ SUBMIT ════════ */
        function submitOPD(mode){
            $('#form_BP').val($('#fld_bp').val().trim()); $('#form_Pulse').val($('#fld_pulse').val().trim());
            $('#form_Investigation').val($('#fld_investigation').val().trim()); $('#form_ReportDetail').val($('#fld_reportDetail').val().trim());
            $('#form_NextAppointmentDate').val($('#fld_followup').val());
            updateSymptomsJson(); updateMedicinesJson(); updateDiagnosisJson();
            $('#saveSpinner').show(); $('#btnSaveBottom').prop('disabled',true);
            $('#opdForm').submit();
        }
        function endVisit(){ if(confirm('End visit and mark as completed?')) submitOPD('end'); }
        var selectedReportUrl = null;
        function handleFileSelect(input){
            var file = input.files && input.files[0];
            if(!file) return;
            if(selectedReportUrl) URL.revokeObjectURL(selectedReportUrl);
            selectedReportUrl = URL.createObjectURL(file);
            $('#uploadLabel').text('📎 '+file.name);
            $('#selectedReportName').text(file.name);
            $('#viewSelectedReport').attr('href', selectedReportUrl);
            $('#selectedReportActions').css('display','flex');
        }
        function clearSelectedReport(event){
            if(event) event.stopPropagation();
            var input = document.getElementById('reportFileInput');
            if(input) input.value = '';
            if(selectedReportUrl) URL.revokeObjectURL(selectedReportUrl);
            selectedReportUrl = null;
            $('#uploadLabel').text('Click to upload report (PDF, JPG, PNG)');
            $('#viewSelectedReport').attr('href','#');
            $('#selectedReportName').text('');
            $('#selectedReportActions').hide();
        }

        /* ════════ TOAST ════════ */
        function showToast(msg,type){
            var $t=$('<div class="toast-custom '+(type||'success')+'">'+(type==='success'?'✓':'✕')+' '+h(msg)+'</div>');
            $('#toastContainer').append($t);
            setTimeout(function(){$t.fadeOut(400,function(){$t.remove();});},2500);
        }

        /* ════════ UTILS ════════ */
        function h(s){ return $('<div>').text(s||'').html(); }
        function j(s){ return (s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }

        function closeDropdownsOnClickOutside(){
            $(document).on('click',function(e){
                if(!$(e.target).closest('#symptomSearch,#symptomDropdown').length)  $('#symptomDropdown').removeClass('show');
                if(!$(e.target).closest('#medicineSearch,#medicineDropdown').length) $('#medicineDropdown').removeClass('show');
                if(!$(e.target).closest('#diagSearch,#diagDropdown').length)         $('#diagDropdown').removeClass('show');
            });
        }
        $('#fld_bp,#fld_pulse,#fld_investigation,#fld_reportDetail').on('input',function(){
            $('#autoSaveStatus').text('Unsaved changes...');
            clearTimeout(window._ast);
            window._ast=setTimeout(function(){$('#autoSaveStatus').text('');},3000);
        });
    </script>
}
