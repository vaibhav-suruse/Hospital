@model WebApplicationSampleTest2.Models.OPD
@{
    ViewData["Title"] = "OPD Consultation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --clr-primary: #556ee6;
        --clr-primary-lt: #eef1ff;
        --clr-primary-dk: #4458b8;
        --clr-success: #34c38f;
        --clr-success-lt: #e8f8f2;
        --clr-warning: #f1b44c;
        --clr-warning-lt: #fff8e8;
        --clr-danger: #f46a6a;
        --clr-danger-lt: #fff0f0;
        --clr-surface: #f8f8fb;
        --clr-border: #eff0f2;
        --clr-text: #495057;
        --clr-muted: #74788d;
        --clr-white: #ffffff;
        --radius-sm: 6px;
        --radius-md: 4px;
        --radius-lg: 6px;
        --shadow-sm: 0 1px 2px rgba(0,0,0,.04);
        --shadow-md: 0 4px 12px rgba(0,0,0,.08);
        --font-base: 'Poppins','Segoe UI',sans-serif;
        --font-mono: 'Roboto Mono',monospace;
    }

    .opd-toolbar,
    .opd-workspace {
        font-family: var(--font-base);
    }

    body.vertical-collpsed .vertical-menu {
        z-index: 1003;
    }

    .opd-toolbar {
        margin: 0 -12px;
        padding: 12px 20px;
        box-shadow: none;
    }

    .opd-toolbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--clr-white);
        border-bottom: 1px solid var(--clr-border);
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        box-shadow: var(--shadow-sm);
        font-family: var(--font-base);
    }

        .opd-toolbar .patient-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .opd-toolbar .patient-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--clr-primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 15px;
            flex-shrink: 0;
        }

        .opd-toolbar .patient-name {
            font-size: 15px;
            font-weight: 700;
            color: var(--clr-text);
            line-height: 1.2;
        }

        .opd-toolbar .patient-meta {
            font-size: 12px;
            color: var(--clr-muted);
        }

        .opd-toolbar .toolbar-actions {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

    .btn-toolbar-action {
        font-family: var(--font-base);
        font-size: 13px;
        font-weight: 500;
        padding: 7px 14px;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-text);
        cursor: pointer;
        transition: all .18s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-toolbar-action:hover {
            border-color: var(--clr-primary);
            color: var(--clr-primary);
            background: var(--clr-primary-lt);
        }

        .btn-toolbar-action.btn-primary-action {
            background: var(--clr-primary);
            color: #fff;
            border-color: var(--clr-primary);
        }

            .btn-toolbar-action.btn-primary-action:hover {
                background: var(--clr-primary-dk);
            }

        .btn-toolbar-action.btn-end-visit {
            background: var(--clr-success);
            color: #fff;
            border-color: var(--clr-success);
        }

            .btn-toolbar-action.btn-end-visit:hover {
                background: #2ca77a;
            }

        .btn-toolbar-action.btn-print {
            background: var(--clr-primary);
            color: #fff;
            border-color: var(--clr-primary);
        }

            .btn-toolbar-action.btn-print:hover {
                background: var(--clr-primary-dk);
            }

    .opd-workspace {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        height: calc(100vh - 145px);
        min-height: 620px;
        overflow: hidden;
        border: 1px solid var(--clr-border);
        background: var(--clr-white);
    }

    .opd-left {
        background: var(--clr-surface);
        border-right: 1px solid var(--clr-border);
        overflow-y: auto;
        padding: 0;
    }

        .opd-left::-webkit-scrollbar {
            width: 4px;
        }

        .opd-left::-webkit-scrollbar-thumb {
            background: var(--clr-border);
            border-radius: 4px;
        }

    .left-section {
        border-bottom: 1px solid var(--clr-border);
        padding: 14px 16px;
    }

    .left-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        color: var(--clr-muted);
        text-transform: uppercase;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Vitals */
    .vitals-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .vital-input-card {
        background: var(--clr-white);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-sm);
        padding: 8px 10px;
    }

        .vital-input-card label {
            font-size: 10px;
            font-weight: 600;
            color: var(--clr-muted);
            text-transform: uppercase;
            letter-spacing: .5px;
            display: block;
            margin-bottom: 3px;
        }

        .vital-input-card input {
            width: 100%;
            border: none;
            outline: none;
            font-size: 14px;
            font-weight: 600;
            color: var(--clr-text);
            background: transparent;
            font-family: var(--font-mono);
        }

        .vital-input-card .vital-unit {
            font-size: 10px;
            color: var(--clr-muted);
            margin-top: 1px;
        }

    /* History sections */
    .hist-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .hist-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        color: var(--clr-muted);
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .btn-add-hist {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1.5px solid var(--clr-primary);
        background: var(--clr-primary-lt);
        color: var(--clr-primary);
        cursor: pointer;
        transition: all .15s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-add-hist:hover {
            background: var(--clr-primary);
            color: #fff;
        }

    .hist-form-panel {
        background: var(--clr-white);
        border: 1.5px solid var(--clr-primary);
        border-radius: var(--radius-md);
        padding: 12px;
        margin-bottom: 10px;
        display: none;
    }

        .hist-form-panel.open {
            display: block;
        }

    .hist-form-row {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 8px;
    }

    .hist-form-label {
        font-size: 10px;
        font-weight: 600;
        color: var(--clr-muted);
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .hist-form-input, .hist-form-select, .hist-form-textarea {
        padding: 7px 10px;
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-family: var(--font-base);
        color: var(--clr-text);
        outline: none;
        width: 100%;
        min-width: 0;
        background: var(--clr-white);
        transition: border-color .15s;
        box-sizing: border-box;
    }

        .hist-form-input:focus, .hist-form-select:focus, .hist-form-textarea:focus {
            border-color: var(--clr-primary);
        }

    .hist-form-textarea {
        resize: vertical;
        min-height: 54px;
    }

    /* ✅ FIX: Changed to single column layout to prevent Status from being cut off */
    .hist-form-grid2 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
    }

    /* Only use 2-col where it truly fits */
    .hist-form-grid2-wide {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .hist-form-actions {
        display: flex;
        gap: 6px;
        margin-top: 4px;
    }

    .btn-hist-save {
        font-size: 12px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: var(--radius-sm);
        border: none;
        background: var(--clr-primary);
        color: #fff;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-hist-save:hover {
            background: var(--clr-primary-dk);
        }

    .btn-hist-cancel {
        font-size: 12px;
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-muted);
        cursor: pointer;
    }

        .btn-hist-cancel:hover {
            border-color: var(--clr-danger);
            color: var(--clr-danger);
        }

    .hist-item {
        background: var(--clr-white);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-sm);
        padding: 8px 10px;
        margin-bottom: 6px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .hist-item-body {
        flex: 1;
        min-width: 0;
    }

    .hist-item-title {
        font-size: 12px;
        font-weight: 600;
        color: var(--clr-text);
    }

    .hist-item-meta {
        font-size: 11px;
        color: var(--clr-muted);
        margin-top: 2px;
    }

    .hist-item-actions {
        display: flex;
        gap: 4px;
        flex-shrink: 0;
    }

    .btn-hist-edit, .btn-hist-del {
        width: 24px;
        height: 24px;
        border-radius: 5px;
        border: 1px solid var(--clr-border);
        background: var(--clr-white);
        cursor: pointer;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
    }

        .btn-hist-edit:hover {
            border-color: var(--clr-primary);
            background: var(--clr-primary-lt);
        }

        .btn-hist-del:hover {
            border-color: var(--clr-danger);
            background: var(--clr-danger-lt);
        }

    .status-badge {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 20px;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .status-active {
        background: var(--clr-success-lt);
        color: #2ca77a;
    }

    .status-resolved {
        background: #f1f5f9;
        color: #64748b;
    }

    .status-abnormal {
        background: var(--clr-danger-lt);
        color: var(--clr-danger);
    }

    /* Past visits */
    .history-timeline {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .history-visit-card {
        background: var(--clr-white);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-sm);
        padding: 10px 12px;
        cursor: pointer;
        transition: border-color .15s;
    }

        .history-visit-card:hover {
            border-color: var(--clr-primary);
        }

        .history-visit-card .visit-date {
            font-size: 12px;
            font-weight: 600;
            color: var(--clr-primary);
        }

        .history-visit-card .visit-meta {
            font-size: 11px;
            color: var(--clr-muted);
            margin-top: 3px;
        }

        .history-visit-card .visit-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 6px;
        }

    .visit-chip {
        font-size: 10px;
        padding: 2px 7px;
        border-radius: 20px;
        background: var(--clr-primary-lt);
        color: var(--clr-primary);
        font-weight: 500;
    }

        .visit-chip.med {
            background: var(--clr-success-lt);
            color: #2ca77a;
        }

    .private-notes-area {
        width: 100%;
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-sm);
        padding: 8px 10px;
        font-size: 13px;
        font-family: var(--font-base);
        color: var(--clr-text);
        background: var(--clr-white);
        resize: vertical;
        min-height: 80px;
        outline: none;
        transition: border-color .15s;
    }

        .private-notes-area:focus {
            border-color: var(--clr-primary);
        }

    /* Right panel */
    .opd-right {
        overflow-y: auto;
        background: var(--clr-white);
        padding: 0;
    }

        .opd-right::-webkit-scrollbar {
            width: 4px;
        }

        .opd-right::-webkit-scrollbar-thumb {
            background: var(--clr-border);
            border-radius: 4px;
        }

    .right-block {
        border-bottom: 1px solid var(--clr-border);
        padding: 18px 20px;
    }

        .right-block:last-child {
            border-bottom: none;
        }

    .block-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .block-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--clr-text);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .block-title .block-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: var(--clr-primary-lt);
            color: var(--clr-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }

    .block-actions {
        display: flex;
        gap: 6px;
    }

    .btn-block-action {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-muted);
        cursor: pointer;
        transition: all .15s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-block-action:hover {
            border-color: var(--clr-primary);
            color: var(--clr-primary);
        }

    .search-input-wrap {
        position: relative;
    }

        .search-input-wrap svg.search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--clr-muted);
            pointer-events: none;
        }

    .search-input {
        width: 100%;
        padding: 9px 12px 9px 34px;
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-md);
        font-size: 13px;
        font-family: var(--font-base);
        color: var(--clr-text);
        outline: none;
        transition: border-color .15s;
        background: var(--clr-surface);
    }

        .search-input:focus {
            border-color: var(--clr-primary);
            background: var(--clr-white);
        }

    .autocomplete-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: var(--clr-white);
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
        z-index: 200;
        max-height: 220px;
        overflow-y: auto;
        display: none;
    }

        .autocomplete-dropdown.show {
            display: block;
        }

    .autocomplete-item {
        padding: 9px 14px;
        font-size: 13px;
        cursor: pointer;
        color: var(--clr-text);
        transition: background .1s;
    }

        .autocomplete-item:hover {
            background: var(--clr-primary-lt);
            color: var(--clr-primary);
        }

    .chips-container {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 10px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        background: var(--clr-primary-lt);
        color: var(--clr-primary);
        border: 1px solid #c8d0fb;
    }

        .chip .chip-remove {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: rgba(37,99,235,.15);
            border: none;
            cursor: pointer;
            color: var(--clr-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            padding: 0;
        }

            .chip .chip-remove:hover {
                background: var(--clr-primary);
                color: #fff;
            }

    .diag-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        border: 1px solid;
    }

        .diag-chip.final {
            background: var(--clr-primary-lt);
            color: var(--clr-primary);
            border-color: #c8d0fb;
        }

        .diag-chip.provisional {
            background: var(--clr-warning-lt);
            color: #c58b2d;
            border-color: #f5d99c;
        }

        .diag-chip .chip-remove {
            width: 15px;
            height: 15px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            padding: 0;
            background: rgba(0,0,0,.1);
        }

    .btn-ddx-ai {
        font-size: 12px;
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--clr-primary);
        background: var(--clr-primary-lt);
        color: var(--clr-primary);
        cursor: pointer;
        transition: all .15s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-ddx-ai:hover {
            background: var(--clr-primary);
            color: #fff;
        }

    .vitals-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .field-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--clr-muted);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .field-input {
        padding: 9px 12px;
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-md);
        font-size: 14px;
        font-family: var(--font-mono);
        color: var(--clr-text);
        outline: none;
        transition: border-color .15s;
        width: 100%;
    }

        .field-input:focus {
            border-color: var(--clr-primary);
        }

    .field-textarea {
        padding: 10px 12px;
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-md);
        font-size: 13px;
        font-family: var(--font-base);
        color: var(--clr-text);
        outline: none;
        transition: border-color .15s;
        width: 100%;
        resize: vertical;
        min-height: 90px;
    }

        .field-textarea:focus {
            border-color: var(--clr-primary);
        }

    .rx-table {
        width: 100%;
        border-collapse: collapse;
    }

        .rx-table thead tr {
            background: var(--clr-surface);
        }

        .rx-table th {
            padding: 8px 10px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--clr-muted);
            border-bottom: 1.5px solid var(--clr-border);
            text-align: left;
            white-space: nowrap;
        }

        .rx-table td {
            padding: 10px;
            font-size: 13px;
            color: var(--clr-text);
            border-bottom: 1px solid var(--clr-border);
            vertical-align: middle;
        }

        .rx-table tbody tr:last-child td {
            border-bottom: none;
        }

        .rx-table tbody tr:hover td {
            background: var(--clr-surface);
        }

    .freq-chips {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
    }

    .freq-chip {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        border: 1.5px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-muted);
        cursor: pointer;
        transition: all .15s;
    }

        .freq-chip.active {
            background: var(--clr-primary);
            color: #fff;
            border-color: var(--clr-primary);
        }

    .timing-toggles {
        display: flex;
        gap: 4px;
    }

    .timing-toggle {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        border: 1.5px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-muted);
        cursor: pointer;
        transition: all .15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .timing-toggle.active {
            background: var(--clr-primary);
            color: #fff;
            border-color: var(--clr-primary);
        }

    .when-select {
        padding: 5px 8px;
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-family: var(--font-base);
        color: var(--clr-text);
        background: var(--clr-white);
        cursor: pointer;
        outline: none;
    }

        .when-select:focus {
            border-color: var(--clr-primary);
        }

    .days-input {
        width: 56px;
        padding: 5px 8px;
        border: 1.5px solid var(--clr-border);
        border-radius: var(--radius-sm);
        font-size: 12px;
        font-family: var(--font-mono);
        text-align: center;
        outline: none;
    }

        .days-input:focus {
            border-color: var(--clr-primary);
        }

    .btn-delete-row {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        border: 1px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
    }

        .btn-delete-row:hover {
            background: var(--clr-danger-lt);
            border-color: var(--clr-danger);
            color: var(--clr-danger);
        }

    .followup-chips {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .followup-chip {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        border: 1.5px solid var(--clr-border);
        background: var(--clr-white);
        color: var(--clr-muted);
        cursor: pointer;
        transition: all .15s;
    }

        .followup-chip:hover {
            border-color: var(--clr-primary);
            color: var(--clr-primary);
        }

        .followup-chip.active {
            background: var(--clr-primary);
            color: #fff;
            border-color: var(--clr-primary);
        }

    .save-bar {
        position: sticky;
        bottom: 0;
        background: var(--clr-white);
        border-top: 1px solid var(--clr-border);
        padding: 12px 24px;
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: flex-end;
    }

    .upload-area {
        border: 2px dashed var(--clr-border);
        border-radius: var(--radius-md);
        padding: 16px;
        text-align: center;
        cursor: pointer;
        transition: all .2s;
        background: var(--clr-surface);
    }

        .upload-area:hover {
            border-color: var(--clr-primary);
            background: var(--clr-primary-lt);
        }

        .upload-area input[type=file] {
            display: none;
        }

        .upload-area .upload-text {
            font-size: 13px;
            color: var(--clr-muted);
            margin-top: 6px;
        }

    .existing-file-link {
        font-size: 12px;
        color: var(--clr-primary);
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
    }

    .selected-file-actions {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
    }

    .selected-file-actions .file-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--clr-muted);
        font-size: 12px;
    }

    .selected-file-actions .file-action {
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--clr-primary);
        cursor: pointer;
        font-size: 12px;
        white-space: nowrap;
    }

    .toast-container-custom {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .toast-custom {
        padding: 12px 18px;
        border-radius: var(--radius-md);
        font-size: 13px;
        font-weight: 500;
        color: #fff;
        box-shadow: var(--shadow-md);
        animation: slideInToast .3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .toast-custom.success {
            background: #16a34a;
        }

        .toast-custom.error {
            background: #dc2626;
        }

    @@keyframes slideInToast {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .spinner-ring {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin .7s linear infinite;
        display: none;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .empty-state {
        text-align: center;
        padding: 14px 8px;
        color: var(--clr-muted);
        font-size: 12px;
    }

    .history-loading {
        text-align: center;
        padding: 20px;
        color: var(--clr-muted);
        font-size: 13px;
    }

    @@media(max-width:900px) {
        .opd-workspace {
            grid-template-columns: 1fr;
            height: auto;
            min-height: 0;
        }

        .opd-left {
            border-right: none;
            border-bottom: 1px solid var(--clr-border);
            max-height: 350px;
        }

        .vitals-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Keep the consultation workspace visually consistent with the Bootstrap
       cards, tabs and form controls used throughout the application. */
    .opd-toolbar {
        position: relative;
        margin: 0 -12px 0;
        padding: 14px 20px;
        border: 1px solid #eff0f2;
        border-bottom: 0;
        background: #fff;
        box-shadow: none;
    }

    .opd-toolbar .patient-avatar {
        width: 42px;
        height: 42px;
        border-radius: 4px;
        background: #eef1ff;
        color: #556ee6;
        font-size: 14px;
    }

    .opd-toolbar .patient-name {
        color: #495057;
        font-size: 16px;
        font-weight: 600;
    }

    .opd-toolbar .patient-meta {
        color: #74788d;
        font-size: 12px;
    }

    .opd-section-nav {
        display: flex;
        align-items: stretch;
        gap: 0;
        margin: 0 -12px;
        padding: 0 20px;
        min-height: 46px;
        border: 1px solid #eff0f2;
        border-bottom: 0;
        background: #fff;
        overflow-x: auto;
    }

    .opd-section-nav a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 12px 16px 10px;
        border-bottom: 2px solid transparent;
        color: #74788d;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
    }

    .opd-section-nav a:hover,
    .opd-section-nav a.active {
        color: #556ee6;
        border-bottom-color: #556ee6;
        background: #fff;
    }

    .opd-section-nav i {
        font-size: 12px;
    }

    .btn-toolbar-action {
        border-radius: 4px;
        border-color: #ced4da;
        color: #495057;
        font-family: inherit;
        font-size: 13px;
        padding: 7px 12px;
    }

    .opd-workspace {
        position: relative;
        display: grid;
        grid-template-columns: 290px minmax(0, 1fr);
        height: calc(100vh - 190px);
        min-height: 640px;
        border: 1px solid #eff0f2;
