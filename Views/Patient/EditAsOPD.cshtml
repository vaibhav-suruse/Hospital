        /* ════════ BMI ════════ */
        function initBMICalc(){
            $('#vit_weight,#vit_height').on('input',function(){
                var w=parseFloat($('#vit_weight').val()), hi=parseFloat($('#vit_height').val())/100;
                if(w>0&&hi>0){
                    var bmi=(w/(hi*hi)).toFixed(1);
                    var cat=bmi<18.5?'(Underweight)':bmi<25?'(Normal)':bmi<30?'(Overweight)':'(Obese)';
                    var col=bmi<18.5?'#d97706':bmi<25?'#16a34a':bmi<30?'#f59e0b':'#dc2626';
                    $('#bmiValue').text(bmi).css('color',col); $('#bmiCategory').text(cat).css('color',col); $('#bmiDisplay').show();
                } else { $('#bmiDisplay').hide(); }
            });
        }

        /* ════════ SYMPTOMS ════════ */
        function filterSymptoms(q){
            var dd=$('#symptomDropdown'); if(!q){dd.removeClass('show');return;}
            var m=S.allSymptoms.filter(function(s){return s.name.toLowerCase().includes(q.toLowerCase());}).slice(0,12);
            if(!m.length){dd.removeClass('show');return;}
            dd.html(m.map(function(s){return '<div class="autocomplete-item" onclick="addSymptom('+s.id+',\''+j(s.name)+'\')">'+h(s.name)+'</div>';}).join('')).addClass('show');
        }
        var _pendingSymptom = null;

        function addSymptom(id,name){
            if(S.symptoms.some(function(s){return s.id===id;})){showToast('Already added','error');return;}
            _pendingSymptom = {id:id, name:name};
            $('#symptomSearch').val(name);
            $('#symptomDropdown').removeClass('show');
            $('#btnAddSymptom').show();
            $('#symSinceVal').focus();
        }

        function confirmAddSymptom(){
            if(!_pendingSymptom){showToast('Select a symptom first','error');return;}
            var sv=parseInt($('#symSinceVal').val())||0, su=$('#symSinceUnit').val()||'Days';
            S.symptoms.push({id:_pendingSymptom.id,name:_pendingSymptom.name,since:sv,sinceUnit:su});
            renderSymptomChips(); updateSymptomsJson();
            $.get('/Patient/SaveSymtons',{Command:_pendingSymptom.id});
            showToast(_pendingSymptom.name+' added','success');
            _pendingSymptom = null;
            $('#symSinceVal').val(''); $('#symSinceUnit').val('Days');
            $('#symptomSearch').val(''); $('#symptomDropdown').removeClass('show');
            $('#btnAddSymptom').hide();
        }
        function removeSymptom(id){
            S.symptoms=S.symptoms.filter(function(s){return s.id!==id;}); renderSymptomChips(); updateSymptomsJson(); $.get('/Patient/DeleteSymtons',{Command:id});
        }
        function clearSymptoms(){ S.symptoms.forEach(function(s){$.get('/Patient/DeleteSymtons',{Command:s.id});}); S.symptoms=[]; renderSymptomChips(); updateSymptomsJson(); }
        function toHours(val, unit){
            if(!val) return null;
            if(unit==='Hours')  return val;
            if(unit==='Days')   return val*24;
            if(unit==='Months') return val*24*30;
            if(unit==='Years')  return val*24*365;
            return val;
        }
        function renderSymptomChips(){
            if(!S.symptoms.length){ $('#symptomChips').html('<div class="empty-state" style="padding:12px 0;"><div>Type to search, set Since, then click + Add</div></div>'); return; }
            $('#symptomChips').html(S.symptoms.map(function(s){
                var sl=s.since?(s.since+' '+s.sinceUnit):'';
                return '<span class="chip">'+h(s.name)+(sl?' <small style="opacity:.7;font-size:10px;">('+sl+')</small>':'')+'<button class="chip-remove" onclick="removeSymptom('+s.id+')">✕</button></span>';
            }).join(''));
        }
