            $.getJSON('/Patient/LoadExistingSymptomsJson?opdId='+S.opdId, function(data){
                if(!data)return;
                S.symptoms=data.map(function(s){return {id:s.symptomId,name:s.symptomName};});
                renderSymptomChips(); updateSymptomsJson();
            });
        }

