@model WebApplicationSampleTest2.Models.DischargeModel

<style>
    .card.border-0.shadow-sm {
        border-radius: 12px !important;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(15,23,42,0.07) !important;
    }

    .card-header.bg-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%) !important;
        border: none;
    }

    .card-header {
        font-weight: 600;
        letter-spacing: .2px;
    }

    table.table thead th, table.table thead.table-light th {
        background: #f8fafc;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #64748b;
        font-weight: 700;
        border-bottom: 2px solid #e2e8f0;
    }

    .allergy-banner {
        background: #fff5f5;
        border: 2px solid #fca5a5;
        border-radius: 10px;
        padding: .85rem 1.1rem;
    }

    .allergy-banner-title {
        color: #991b1b;
        font-weight: 700;
        margin-bottom: .5rem;
        font-size: .95rem;
    }

    .allergy-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #fff;
        border: 1px solid #fca5a5;
        color: #7f1d1d;
        padding: .35rem .75rem;
        border-radius: 20px;
        font-size: .85rem;
        margin: .2rem .3rem .2rem 0;
        font-weight: 500;
    }

        .allergy-chip.chip-severe {
            background: #fef2f2;
            border-color: #dc2626;
            box-shadow: 0 0 0 1px #dc2626 inset;
        }

    .chip-severity {
        font-weight: 700;
        margin-left: .2rem;
    }

    .no-allergy-banner {
        display: inline-flex;
        align-items: center;
        background: #f0fdf4;
        border: 1px solid #86efac;
        color: #166534;
        padding: .5rem 1rem;
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 500;
    }

    .dx-pill {
        display: inline-block;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e3a8a;
        padding: .3rem .7rem;
        border-radius: 20px;
        font-size: .85rem;
        margin: .15rem .25rem .15rem 0;
    }

        .dx-pill.dx-final {
            background: #f0fdf4;
            border-color: #86efac;
            color: #14532d;
        }
</style>

<div class="container-fluid">

    @* ── TOP BAR ── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            <i class="fas fa-file-medical-alt me-2 text-primary"></i>
            Discharge Summary
        </h4>
        <div class="d-flex gap-2">
            @* <a asp-controller="IPDAdmission"
               asp-action="Details"
               asp-route-id="@Model.IPDId"
               class="btn btn-secondary btn-sm">
                ← Back to IPD
            </a> *@

<a asp-controller="AdmissionNotes"
               asp-action="Index"
               asp-route-ipdId="@Model.IPDId"
               asp-route-patientId="@Model.PatientId"
               class="btn btn-sm btn-light">
                <i class="fas fa-arrow-left me-1"></i> Back
            </a>

            <a asp-controller="Discharge"
               asp-action="PrintSummary"
               asp-route-ipdId="@Model.IPDId"
               target="_blank"
               class="btn btn-primary btn-sm">
                <i class="fas fa-print me-1"></i> Print Summary
            </a>
        </div>
    </div>

    @* ── ALLERGY BANNER (always shown first - patient safety) ── *@
    @{
        var _allergies = ViewBag.Allergies as List<WebApplicationSampleTest2.Models.PatientAllergyModel>
        ?? new List<WebApplicationSampleTest2.Models.PatientAllergyModel>();
    }
    <div class="mb-3">
        @if (_allergies.Any())
        {
            <div class="allergy-banner">
                <div class="allergy-banner-title"><i class="fas fa-exclamation-triangle me-2"></i>Known Allergies</div>
                <div>
                    @foreach (var a in _allergies)
                    {
                        <span class="allergy-chip @(a.Severity == "Severe" ? "chip-severe" : "")">
                            <i class="fas fa-allergies"></i>
                            <strong>@a.AllergyName</strong>
                            @if (!string.IsNullOrWhiteSpace(a.Reaction))
                            {
                                <text> — @a.Reaction</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.Severity))
                            {
                                <span class="chip-severity">(@a.Severity)</span>
                            }
                        </span>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="no-allergy-banner"><i class="fas fa-check-circle me-2"></i>No known allergies recorded</div>
        }
    </div>

    @* ── STATUS BANNER ── *@
    <div class="alert @(Model.Status == "Discharged" ? "alert-success" : "alert-info") py-2 mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-check-circle me-1"></i>
                <strong>IPD No: @Model.AdmissionNumber</strong>
                &nbsp;|&nbsp; Status:
                <span class="badge @(Model.Status == "Discharged" ? "bg-success" : "bg-info")">@Model.Status</span>
                &nbsp;|&nbsp; Stay: <strong>@Model.TotalDaysStayed days</strong>
            </div>
            <div>
                Admitted: <strong>@Model.AdmissionDateTime.ToString("dd-MM-yyyy")</strong>
                @if (Model.ActualDischargeDateTime.HasValue)
                {
                    <span>&nbsp;→&nbsp; Discharged: <strong>@Model.ActualDischargeDateTime.Value.ToString("dd-MM-yyyy")</strong></span>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">

        @* ── PATIENT INFO ── *@
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-user me-2"></i><strong>Patient Information</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <p class="mb-2"><span class="text-muted small">Name</span><br /><strong>@Model.PatientName</strong></p>
                            <p class="mb-2"><span class="text-muted small">Gender</span><br /><strong>@Model.Gender</strong></p>
                            <p class="mb-0"><span class="text-muted small">Age</span><br /><strong>@Model.Age years</strong></p>
                        </div>
                        <div class="col-6">
                            <p class="mb-2"><span class="text-muted small">Phone</span><br /><strong>@(Model.PhoneNumber ?? "-")</strong></p>
                            <p class="mb-0"><span class="text-muted small">Address</span><br /><strong>@(Model.Address ?? "-")</strong></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── ADMISSION DETAILS ── *@
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-hospital me-2"></i><strong>Admission Details</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <p class="mb-2"><span class="text-muted small">Doctor</span><br /><strong>Dr. @Model.PrimaryDoctorName</strong></p>
<p class="mb-2"><span class="text-muted small">Ward / Bed</span><br /><strong>@(Model.WardName ?? "-") / @(Model.BedNumber ?? "-")</strong></p>
                            <p class="mb-2"><span class="text-muted small">Room</span><br /><strong>@(Model.RoomNumber ?? "-")</strong></p>
                            <p class="mb-0"><span class="text-muted small">Total Days</span><br /><span class="badge bg-primary fs-6">@Model.TotalDaysStayed days</span></p>
                        </div>
                        <div class="col-6">
                            <p class="mb-2"><span class="text-muted small">Admitted On</span><br /><strong>@Model.AdmissionDateTime.ToString("dd-MM-yyyy HH:mm")</strong></p>
                            <p class="mb-2"><span class="text-muted small">Discharged On</span><br /><strong>@(Model.ActualDischargeDateTime?.ToString("dd-MM-yyyy HH:mm") ?? "Not yet")</strong></p>
                            <p class="mb-0"><span class="text-muted small">Reason for Admission</span><br /><strong>@(Model.ReasonForAdmission ?? "-")</strong></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">

        @* ── DISCHARGE INFO ── *@
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-sign-out-alt me-2"></i><strong>Discharge Information</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <p class="mb-2">
                                <span class="text-muted small">Discharge Type</span><br />
                                <span class="badge @(Model.DischargeType == "Death" ? "bg-danger" : Model.DischargeType == "LAMA" ? "bg-warning text-dark" : Model.DischargeType == "Referral" ? "bg-info" : "bg-success") fs-6">
                                    @(Model.DischargeType ?? "-")
                                </span>
                            </p>
                            <p class="mb-0"><span class="text-muted small">Discharging Doctor</span><br /><strong>@(Model.DischargeDoctorName ?? "-")</strong></p>
                        </div>
                        <div class="col-6">
                            <p class="mb-2">
                                <span class="text-muted small">Condition at Discharge</span><br />
                                <span class="badge @(Model.DischargeCondition == "Good" ? "bg-success" : Model.DischargeCondition == "Fair" ? "bg-warning text-dark" : Model.DischargeCondition == "Poor" ? "bg-danger" : "bg-dark") fs-6">
                                    @(Model.DischargeCondition ?? "-")
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── FOLLOW UP ── *@
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-calendar-check me-2"></i><strong>Follow-up</strong>
                </div>
                <div class="card-body">
                    <p class="mb-2">
                        <span class="text-muted small">Follow-up Date</span><br />
                        <strong>@(Model.FollowUpDate.HasValue? Model.FollowUpDate.Value.ToString("dd-MM-yyyy") : "Not scheduled")</strong>
                    </p>
                    <p class="mb-0">
                        <span class="text-muted small">Follow-up Doctor</span><br />
                        <strong>@(string.IsNullOrEmpty(Model.FollowUpDoctorName) ? "N/A" : Model.FollowUpDoctorName)</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ── DIAGNOSIS & TREATMENT ── *@
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-stethoscope me-2"></i><strong>Final Diagnosis</strong>
                </div>
                <div class="card-body">
                    <p class="mb-0">@(string.IsNullOrEmpty(Model.FinalDiagnosis) ? "N/A" : Model.FinalDiagnosis)</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-notes-medical me-2"></i><strong>Treatment Summary</strong>
                </div>
                <div class="card-body">
                    <p class="mb-0">@(string.IsNullOrEmpty(Model.TreatmentSummary) ? "N/A" : Model.TreatmentSummary)</p>
                </div>
            </div>
        </div>
    </div>

    @* ── DIAGNOSIS: ADMISSION vs DISCHARGE, shown separately ── *@
    @{
        var admissionDx = ViewBag.AdmissionDiagnoses as List<WebApplicationSampleTest2.Models.DiagnosisModel>
        ?? new List<WebApplicationSampleTest2.Models.DiagnosisModel>();
        var dischargeDx = ViewBag.DischargeDiagnoses as List<WebApplicationSampleTest2.Models.DiagnosisModel>
        ?? new List<WebApplicationSampleTest2.Models.DiagnosisModel>();
    }
    @if (admissionDx.Any() || dischargeDx.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-diagnoses me-2"></i><strong>Diagnosis</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Admission Diagnosis (Provisional)</div>
                        @if (admissionDx.Any())
                        {
                            @foreach (var dx in admissionDx)
                            {
                                <span class="dx-pill">@dx.DiagnosisName@(dx.IsPrincipal ? " (Principal)" : "")</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Not recorded</span>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Discharge Diagnosis (Final)</div>
                        @if (dischargeDx.Any())
                        {
                            @foreach (var dx in dischargeDx)
                            {
                                <span class="dx-pill dx-final">@dx.DiagnosisName@(dx.IsPrincipal ? " (Principal)" : "")</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Not recorded</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── CHIEF COMPLAINTS & MEDICAL HISTORY (from admission) ── *@
    @{
        var complaints = ViewBag.ChiefComplaints as List<WebApplicationSampleTest2.Models.ChiefComplaintModel>
        ?? new List<WebApplicationSampleTest2.Models.ChiefComplaintModel>();
        var medHistory = ViewBag.MedicalHistory as List<WebApplicationSampleTest2.Models.PatientMedicalHistoryModel>
        ?? new List<WebApplicationSampleTest2.Models.PatientMedicalHistoryModel>();
    }
    @if (complaints.Any() || medHistory.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-history me-2"></i><strong>Clinical Background</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @if (complaints.Any())
                    {
                        <div class="col-md-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Chief Complaints</div>
                            <ul class="mb-0 ps-3 small">
                                @foreach (var c in complaints)
                                {
                                    <li>
                                        @c.ComplaintName
                                        @if (c.DurationValue.HasValue)
                                        {
                                            <span class="text-muted">— @c.DurationValue @c.DurationUnit</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    @if (medHistory.Any())
                    {
                        <div class="col-md-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Medical History</div>
                            <ul class="mb-0 ps-3 small">
                                @foreach (var h in medHistory)
                                {
                                    <li>
                                        @h.HistoryType
                                        @if (!string.IsNullOrWhiteSpace(h.Description))
                                        {
                                            <text>: @h.Description</text>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(h.Status))
                                        {
                                            <span class="text-muted">(@h.Status)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ── INSTRUCTIONS ── *@
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-clipboard-list me-2"></i><strong>Discharge Instructions</strong>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">@(string.IsNullOrEmpty(Model.DischargeInstructions) ? "N/A" : Model.DischargeInstructions)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-utensils me-2"></i><strong>Diet Instructions</strong>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">@(string.IsNullOrEmpty(Model.DietInstructions) ? "N/A" : Model.DietInstructions)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-running me-2"></i><strong>Activity Restrictions</strong>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">@(string.IsNullOrEmpty(Model.ActivityRestrictions) ? "N/A" : Model.ActivityRestrictions)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <i class="fas fa-sticky-note me-2"></i><strong>Special Notes</strong>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">@(string.IsNullOrEmpty(Model.SpecialNotes) ? "N/A" : Model.SpecialNotes)</p>
                </div>
            </div>
        </div>
    </div>

    @* ── DISCHARGE MEDICINES ── *@
    @if (Model.DischargeMedicines != null && Model.DischargeMedicines.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-pills me-2"></i><strong>Discharge Medicines</strong>
            </div>
            <div class="card-body p-2">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Medicine</th>
                            <th>Dosage</th>
                            <th class="text-center">M</th>
                            <th class="text-center">A</th>
                            <th class="text-center">E</th>
                            <th>Days</th>
                            <th>Route</th>
                            <th>Instructions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int mi = 1;
                        }
                        @foreach (var med in Model.DischargeMedicines)
                        {
                            <tr>
                                <td>@mi</td>
                                <td><strong>@med.MedicineName</strong></td>
                                <td>@(med.Dosage ?? "-")</td>
                                <td class="text-center">@(med.Morning ? "✔" : "-")</td>
                                <td class="text-center">@(med.Afternoon ? "✔" : "-")</td>
                                <td class="text-center">@(med.Evening ? "✔" : "-")</td>
                                <td>@(med.Days.HasValue? med.Days + " days" : "-")</td>
                                <td>@(med.Route ?? "-")</td>
                                <td>@(med.Instructions ?? "-")</td>
                            </tr>
                            mi++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── PROCEDURES PERFORMED (auto-pulled from Operations module) ── *@
    @{
        var procedures = ViewBag.Procedures as List<WebApplicationSampleTest2.Models.IPDOperationModel>
        ?? new List<WebApplicationSampleTest2.Models.IPDOperationModel>();
    }
    @if (procedures.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-procedures me-2"></i><strong>Procedures Performed</strong>
            </div>
            <div class="card-body p-2">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Procedure</th>
                            <th>Date</th>
                            <th>Surgeon</th>
                            <th>Anesthetist</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proc in procedures)
                        {
                            <tr>
                                <td><strong>@proc.OperationName</strong></td>
                                <td>@proc.OperationDate.ToString("dd MMM yyyy")</td>
                                <td>@(proc.SurgeonName ?? "-")</td>
                                <td>@(proc.AnesthesistName ?? "-")</td>
                                <td>@(proc.Notes ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── LAB RESULTS (auto-pulled from Lab Reports module) ── *@
    @{
        var labResults = ViewBag.LabResults as List<WebApplicationSampleTest2.Models.LabReportValueVM>
        ?? new List<WebApplicationSampleTest2.Models.LabReportValueVM>();
    }
    @if (labResults.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-flask me-2"></i><strong>Lab Results</strong>
            </div>
            <div class="card-body p-2">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Test</th>
                            <th>Result</th>
                            <th>Normal Range</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lab in labResults)
                        {
                            <tr>
                                <td>@lab.ParameterName</td>
                                <td><strong>@lab.ResultValue</strong> @lab.Unit</td>
                                <td>@(lab.NormalRangeText ?? "-")</td>
                                <td>@lab.ReportDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── RADIOLOGY REPORTS (auto-pulled from Radiology module) ── *@
    @{
        var radiologyReports = ViewBag.RadiologyReports as List<WebApplicationSampleTest2.Models.RadiologyReportModel>
        ?? new List<WebApplicationSampleTest2.Models.RadiologyReportModel>();
    }
    @if (radiologyReports.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-x-ray me-2"></i><strong>Radiology Reports</strong>
            </div>
            <div class="card-body p-2">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Title</th><th>Notes</th><th>Radiologist</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var rad in radiologyReports)
                        {
                            <tr>
                                <td><strong>@rad.Title</strong></td>
                                <td>@rad.Notes</td>
                                <td>@(rad.RadiologistName ?? "-")</td>
                                <td>@rad.ReportDateTime.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── DAILY VITALS ── *@
    @{
        var vitals = ViewBag.Vitals as List<WebApplicationSampleTest2.Models.IPDNurseVitals>
        ?? new List<WebApplicationSampleTest2.Models.IPDNurseVitals>();
    }
    @if (vitals.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-heartbeat me-2"></i>
                <strong>Daily Vitals</strong>
                <small class="ms-2 fw-normal opacity-75">(@vitals.Count records)</small>
            </div>
            <div class="card-body p-2">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table">
                        <tr>
                            <th>#</th>
                            <th>Date & Time</th>
                            <th>Temp</th>
                            <th>Pulse</th>
                            <th>BP</th>
                            <th>Resp</th>
                            <th>SpO₂</th>
                            <th>Notes</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int vi = 1;
                        }
                        @foreach (var v in vitals)
                        {
                            <tr class="@(v.IsAbnormal ? "table" : "")">
                                <td>@vi</td>
                                <td>@v.RecordedDateTime.ToString("dd-MM-yyyy HH:mm")</td>
                                <td>@(v.Temperature.HasValue? v.Temperature + "°" : "-")</td>
                                <td>@(v.Pulse.HasValue? v.Pulse.ToString() : "-")</td>
                                <td>@(v.Systolic.HasValue && v.Diastolic.HasValue ? $"{v.Systolic}/{v.Diastolic}" : "-")</td>
                                <td>@(v.RespirationRate.HasValue? v.RespirationRate.ToString() : "-")</td>
                                <td>@(v.OxygenSaturation.HasValue? v.OxygenSaturation + "%" : "-")</td>
                                <td>@(string.IsNullOrEmpty(v.Notes) ? "-" : v.Notes)</td>
                                <td>
                                    @if (v.IsAbnormal)
                                    {
                                        <span class="badge bg-warning text-dark">⚠ Abnormal</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Normal</span>
                                    }
                                </td>
                            </tr>
                            vi++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── DOCTOR ROUNDS ── *@
    @{
        var rounds = ViewBag.Rounds as List<WebApplicationSampleTest2.Models.IPDRoundPrintVM>
        ?? new List<WebApplicationSampleTest2.Models.IPDRoundPrintVM>();
    }
    @if (rounds.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <i class="fas fa-user-md me-2"></i>
                <strong>Doctor Rounds Summary</strong>
                <small class="ms-2 fw-normal opacity-75">(@rounds.Count rounds)</small>
            </div>
            <div class="card-body p-2">
                @{
                    int roundNo = 1;
                }
                @foreach (var round in rounds)
                {
                    <div class="card border mb-2">
                        <div class="card-header d-flex justify-content-between py-2"
                             style="background:#1f4e79; color:white;">
                            <span>
                                <strong>Round @roundNo</strong> —
                                @round.RoundType | @round.RoundDateTime.ToString("dd-MM-yyyy HH:mm")
                            </span>
                            <span>Dr. @round.DoctorName (@round.Specialization)</span>
                        </div>
                        <div class="card-body py-2">
                            @if (!string.IsNullOrEmpty(round.PatientCondition) || !string.IsNullOrEmpty(round.Diagnosis))
                            {
                                <p class="mb-2">
                                    @if (!string.IsNullOrEmpty(round.PatientCondition))
                                    {
                                        <span><strong>Condition:</strong> @round.PatientCondition</span>
                                        <span class="mx-2">|</span>
                                    }
                                    @if (!string.IsNullOrEmpty(round.Diagnosis))
                                    {
                                        <span><strong>Diagnosis:</strong> @round.Diagnosis</span>
                                    }
                                </p>
                            }
                            @if (round.Symptoms != null && round.Symptoms.Any())
                            {
                                <p class="mb-2">
                                    <strong>Symptoms:</strong>
                                    @string.Join(", ", round.Symptoms.Select(s =>
                                    string.IsNullOrEmpty(s.SubName) ? s.SymptomName : s.SymptomName + " (" + s.SubName + ")"))
                    </p>
                                        }
                            @if (round.Medicines != null && round.Medicines.Any())
                            {
                                <h6 class="text-primary mt-2">Medicines</h6>
                                <table class="table table-bordered table-sm">
                                    <thead class="table-light">
                                        <tr><th>#</th><th>Medicine</th><th>Type</th><th>Dosage</th><th>M</th><th>A</th><th>E</th><th>Days</th><th>Route</th><th>Instructions</th></tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rm = 1;
                                        }
                                        @foreach (var med in round.Medicines)
                                        {
                                            <tr>
                                                <td>@rm</td>
                                                <td><strong>@med.MedicineName</strong></td>
                                                <td>@med.MedicineType</td>
                                                <td>@(med.Dosage ?? "-")</td>
                                                <td>@(med.Morning ? "✔" : "–")</td>
                                                <td>@(med.Afternoon ? "✔" : "–")</td>
                                                <td>@(med.Evening ? "✔" : "–")</td>
                                                <td>@(med.Days.HasValue? med.Days + "d" : "-")</td>
                                                <td>@(med.Route ?? "-")</td>
                                                <td>@(med.MedicineInstructions ?? "-")</td>
                                            </tr>
                                            rm++;
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (round.Investigations != null && round.Investigations.Any())
                            {
                                <h6 class="text-primary mt-2">Investigations</h6>
                                <table class="table table-bordered table-sm">
                                    <thead class="table-light">
                                        <tr><th>#</th><th>Type</th><th>Test Name</th><th>Priority</th><th>Status</th><th>Instructions</th></tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int ri = 1;
                                        }
                                        @foreach (var inv in round.Investigations)
                                        {
                                            <tr>
                                                <td>@ri</td>
                                                <td>@inv.InvestigationType</td>
                                                <td><strong>@inv.TestName</strong></td>
                                                <td>
                                                    <span class="badge @(inv.Priority == "Emergency" ? "bg-danger" : inv.Priority == "Urgent" ? "bg-warning" : "bg-success")">
                                                        @inv.Priority
                                                    </span>
                                                </td>
                                                <td>@inv.Status</td>
                                                <td>@(inv.InvInstructions ?? "-")</td>
                                            </tr>
                                            ri++;
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (!string.IsNullOrEmpty(round.Instructions) || !string.IsNullOrEmpty(round.Notes))
                            {
                                <p class="mt-2 mb-0 text-muted small">
                                    @if (!string.IsNullOrEmpty(round.Instructions))
                                    {
                                        <span><strong>Instructions:</strong> @round.Instructions</span>
                                    }
                                    @if (!string.IsNullOrEmpty(round.Notes))
                                    {
                                        <span class="ms-3"><strong>Notes:</strong> @round.Notes</span>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                    roundNo++;
                }
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        @if (TempData["Success"] != null)
        {
                    <text>toastr.success("@TempData["Success"]");</text>
        }
    </script>
}









