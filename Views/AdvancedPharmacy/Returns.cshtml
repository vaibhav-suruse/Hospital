@using WebApplicationSampleTest2.Models
@{
    ViewData["Title"] = "Returns & Refunds";
    var returns = ViewBag.Returns as List<PharmacyReturn> ?? new List<PharmacyReturn>();
    var inventory = ViewBag.Inventory as List<InventoryModel> ?? new List<InventoryModel>();
}

<!-- ═══════════════════ HERO ═══════════════════ -->
<div class="pharm-hero d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <div class="pharm-hero-icon"><i class="bx bx-recycle"></i></div>
        <div>
            <h4>Returns &amp; Refunds</h4>
            <p>Process patient, supplier &amp; damage returns with automatic stock restock</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="pharm-alert success">
        <i class="fas fa-check-circle alert-icon"></i>
        <strong>@TempData["Success"]</strong>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="pharm-alert danger">
        <i class="fas fa-exclamation-triangle alert-icon"></i>
        <strong>@TempData["Error"]</strong>
    </div>
}

<div class="row">
    <!-- ══ LEFT: Return form ══ -->
    <div class="col-lg-5">
        <div class="card pharm-card">
            <div class="pharm-card-header grad-success">
                <h5><i class="bx bxs-cart-download me-2"></i>New Return</h5>
            </div>
            <div class="pharm-card-body">
                <form method="post" asp-action="Returns" id="returnForm">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-semibold">Return Type</label>
                            <select name="ReturnType" class="form-select">
                                <option value="Patient">Patient</option>
                                <option value="Supplier">Supplier</option>
                                <option value="Damage">Damage</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-semibold">Mobile Number</label>
                            <input type="text" name="MobileNumber" class="form-control" placeholder="Optional" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Customer Name</label>
                        <input type="text" name="CustomerName" class="form-control" placeholder="Customer name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason</label>
                        <textarea name="Reason" class="form-control" rows="2" placeholder="Reason for return"></textarea>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-semibold mb-0">Return Items</label>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addReturnRow()">
                            <i class="bx bx-plus me-1"></i> Add Item
                        </button>
                    </div>

                    <div id="returnItems">
                        <div class="return-row card card-body bg-light mb-2 py-2">
                            <select class="form-select form-select-sm med-select mb-1" onchange="calcReturn(this)">
                                <option value="">-- Medicine --</option>
                                @foreach (var item in inventory)
                                {
                                    <option value="@item.MedicineId" data-price="@item.SellingPrice">@item.MedicineName</option>
                                }
                            </select>
                            <div class="d-flex gap-2">
                                <input type="number" class="form-control form-control-sm qty-input" placeholder="Qty" min="1" oninput="calcReturn(this)" />
                                <input type="text" class="form-control form-control-sm refund-input text-end" placeholder="Refund" readonly />
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.return-row').remove(); calcTotals();"><i class="bx bx-x"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-light rounded">
                        <span class="fw-bold">Total Refund</span>
                        <span class="fw-bold fs-5" id="totalRefund" style="color:var(--pharm-primary)">₹0.00</span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-grad-success w-100">
                            <i class="bx bx-check-circle me-1"></i> Process Return
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ══ RIGHT: Return Log ══ -->
    <div class="col-lg-7">
        <div class="card pharm-card">
            <div class="pharm-card-header">
                <h5><i class="bx bx-history me-2" style="color:var(--pharm-primary)"></i>Return History</h5>
                <span class="pharm-badge badge-soft-primary">@returns.Count records</span>
            </div>
            <div class="pharm-card-body p-0">
                <div class="table-responsive">
                    <table class="table pharm-table mb-0">
                        <thead>
                            <tr>
                                <th>Return #</th>
                                <th>Customer</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Reason</th>
                                <th class="text-end">Refund</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (returns.Any())
                            {
                                foreach (var r in returns)
                                {
                                    var typeBadge = r.ReturnType == "Patient" ? "badge-soft-primary"
                                    : r.ReturnType == "Supplier" ? "badge-soft-info"
                                    : "badge-soft-danger";
                                    <tr>
                                        <td><strong style="color:var(--pharm-primary);font-size:12px;">@r.ReturnNumber</strong></td>
                                        <td>@(r.CustomerName ?? "—")</td>
                                        <td><span class="pharm-badge @typeBadge">@r.ReturnType</span></td>
                                        <td class="text-muted" style="font-size:12px;">@r.ReturnDate.ToString("dd-MM-yyyy")</td>
                                        <td class="text-muted" style="font-size:12px;">@(r.Reason ?? "—")</td>
                                        <td class="text-end fw-bold" style="color:var(--pharm-danger)">-₹@r.TotalRefund.ToString("F2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">No returns processed yet</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addReturnRow() {
            var html = `
                <div class="return-row card card-body bg-light mb-2 py-2">
                    <select class="form-select form-select-sm med-select mb-1" onchange="calcReturn(this)">
                        <option value="">-- Medicine --</option>
                        @foreach (var item in inventory)
                        {
                            <text><option value="@item.MedicineId" data-price="@item.SellingPrice">@item.MedicineName</option></text>
                        }
                    </select>
                    <div class="d-flex gap-2">
                        <input type="number" class="form-control form-control-sm qty-input" placeholder="Qty" min="1" oninput="calcReturn(this)" />
                        <input type="text" class="form-control form-control-sm refund-input text-end" placeholder="Refund" readonly />
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.return-row').remove(); calcTotals();"><i class="bx bx-x"></i></button>
                    </div>
                </div>`;
            document.getElementById('returnItems').insertAdjacentHTML('beforeend', html);
        }

        function calcReturn(el) {
            var row = el.closest('.return-row');
            var select = row.querySelector('.med-select');
            var qty = parseInt(row.querySelector('.qty-input').value) || 0;
            var price = parseFloat(select.options[select.selectedIndex]?.dataset?.price) || 0;
            var refund = qty * price;
            row.querySelector('.refund-input').value = refund.toFixed(2);
            calcTotals();
        }

        function calcTotals() {
            var total = 0;
            document.querySelectorAll('.refund-input').forEach(function(i) {
                total += parseFloat(i.value) || 0;
            });
            document.getElementById('totalRefund').textContent = '₹' + total.toFixed(2);
        }

        // On submit: build hidden items so the model binds
        document.getElementById('returnForm').addEventListener('submit', function(e) {
            var rows = document.querySelectorAll('.return-row');
            var valid = false;
            rows.forEach(function(row) {
                var medId = row.querySelector('.med-select').value;
                var qty = parseInt(row.querySelector('.qty-input').value) || 0;

                var hiddenId = document.createElement('input');
                hiddenId.type = 'hidden';
                hiddenId.name = 'Items[' + (currentIndex) + '].MedicineId';
                hiddenId.value = medId;
                row.appendChild(hiddenId);

                var hiddenQty = document.createElement('input');
                hiddenQty.type = 'hidden';
                hiddenQty.name = 'Items[' + (currentIndex) + '].Quantity';
                hiddenQty.value = qty;
                row.appendChild(hiddenQty);

                var hiddenAmt = document.createElement('input');
                hiddenAmt.type = 'hidden';
                hiddenAmt.name = 'Items[' + (currentIndex) + '].RefundAmount';
                hiddenAmt.value = parseFloat(row.querySelector('.refund-input').value) || 0;
                row.appendChild(hiddenAmt);

                var hiddenBatch = document.createElement('input');
                hiddenBatch.type = 'hidden';
                hiddenBatch.name = 'Items[' + (currentIndex) + '].BatchId';
                hiddenBatch.value = '';
                row.appendChild(hiddenBatch);

                if (medId && qty > 0) valid = true;
                currentIndex++;
            });
            if (!valid) {
                e.preventDefault();
                alert('Add at least one valid return item with quantity.');
            }
        });
        var currentIndex = 0;
    </script>
}
