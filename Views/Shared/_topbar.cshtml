<style>
    /* Fix: .vertical-menu (the sidebar) needs a high z-index of its own
       to support its hover-flyout submenus when collapsed, which means
       it sits above #page-topbar in the stacking order. Setting a high
       z-index on a *descendant* dropdown-menu doesn't help if its
       ancestor (#page-topbar) itself has a lower/equal z-index than the
       sidebar — the child z-index is trapped inside the parent's
       stacking context. So raise the topbar header itself. */
    #page-topbar {
        z-index: 1090 !important;
    }

    #page-topbar .top-menu-item .dropdown-menu {
        z-index: 99999 !important;
        position: absolute !important;
    }

    /* Sidebar hidden BY DEFAULT — pure CSS, applies immediately with no
       dependency on JS having run yet or on any stored preference. Content
       gets the full width. The topbar button below only ever ADDS the
       'sidebar-shown' class to bring it back; nothing hides it explicitly
       anymore, so there's no stale-preference or timing issue possible. */
    body:not(.sidebar-shown) .vertical-menu {
        display: none !important;
    }
    body:not(.sidebar-shown) .main-content {
        margin-left: 0 !important;
    }

    /* The full inline nav is desktop-only; below 992px it's replaced by the
       single "Menu" dropdown, since at ~350px only one item ever fit on screen
       and the rest scrolled out of sight. Exactly one of the two is visible
       at any width. */
    #page-topbar .top-menu-nav-mobile {
        display: none;
    }

    @@media (max-width: 991.98px) {
        #page-topbar .top-menu-nav {
            display: none !important;
        }
        #page-topbar .top-menu-nav-mobile {
            display: flex !important;
        }
        /* Keep the opened menu inside the screen and scrollable, since it now
           holds every nav item at once. */
        #page-topbar .top-menu-item .dropdown-menu {
            position: fixed !important;
            top: 70px !important; /* just below the topbar */
            left: .5rem !important;
            right: .5rem !important;
            max-height: 75vh;
            overflow-y: auto;
        }
    }
</style>
