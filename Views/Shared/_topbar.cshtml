<script>
    // Manual open/close for the Configuration/IPD/Medical topbar menus.
    // Deliberately NOT using Bootstrap's data-bs-toggle="dropdown" JS here —
    // this page loads Bootstrap's JS bundle twice (once via _Layout.cshtml,
    // once again in the page's own script block), and that double-load was
    // preventing Bootstrap's dropdown module from opening the menu. This
    // still relies on Bootstrap's CSS (.dropdown-menu / .show), just not its
    // JS, so it can't be broken by that conflict.
    document.addEventListener('click', function (e) {
        var toggle = e.target.closest('#page-topbar .top-menu-item > a.dropdown-toggle');

        // Close every other open menu in this group first
        document.querySelectorAll('#page-topbar .top-menu-item > .dropdown-menu.show').forEach(function (menu) {
            if (!toggle || menu !== toggle.nextElementSibling) {
                menu.classList.remove('show');
            }
        });

        if (toggle) {
            e.preventDefault();
            var menu = toggle.nextElementSibling;
            if (menu && menu.classList.contains('dropdown-menu')) {
                menu.classList.toggle('show');
            }
            return;
        }

        // Clicked outside any of these three menus entirely — close them all
        if (!e.target.closest('#page-topbar .top-menu-item')) {
            document.querySelectorAll('#page-topbar .top-menu-item > .dropdown-menu.show').forEach(function (menu) {
                menu.classList.remove('show');
            });
        }
    });
</script>

<script>
    // Full sidebar show/hide toggle (separate from the existing icon-only
    // collapse). The CSS above already defaults to hidden on its own — this
    // script's only job is to remember and re-apply an explicit "show it"
    // choice across page loads. New storage key (was 'hms-sidebar-hidden')
    // so any old saved value from earlier testing is ignored.
    (function () {
        var STORAGE_KEY = 'hms-sidebar-shown';

        function apply(shown) {
            document.body.classList.toggle('sidebar-shown', shown);
        }

        // Only ever turns it ON if the user previously chose to show it.
        // If nothing is saved, the CSS default (hidden) is already in effect
        // before this script even runs — nothing to do here in that case.
        apply(localStorage.getItem(STORAGE_KEY) === '1');

        document.addEventListener('DOMContentLoaded', function () {
            var btn = document.getElementById('sidebar-visibility-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var nowShown = !document.body.classList.contains('sidebar-shown');
                apply(nowShown);
                localStorage.setItem(STORAGE_KEY, nowShown ? '1' : '0');
            });
        });
    })();
</script>
