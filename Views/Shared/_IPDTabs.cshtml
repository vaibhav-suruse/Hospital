@model string
@{
    string active = Model ?? "AdmissionNotes";
    Func<string, string> cls = (key) => active == key ? "ipd-tab active" : "ipd-tab";


    string ipdIdRaw = Context.Request.Query["ipdId"].ToString();
    if (string.IsNullOrEmpty(ipdIdRaw))
    {
        ipdIdRaw = Context.Request.Query["ipId"].ToString();
    }
    // Safety net: some pages receive the admission id as a route value
    // (e.g. /Controller/Index/123) or under a differently-named parameter
    // (e.g. "id") rather than as ?ipdId=/?ipId= on the query string. Without
    // this fallback the tab bar silently defaults to ipdId=0, which then
    // 404s every Clinical Details link rendered from this page.
    if (string.IsNullOrEmpty(ipdIdRaw) && Context.Request.RouteValues.TryGetValue("ipdId", out var rvIpdId))
    {
        ipdIdRaw = rvIpdId?.ToString();
    }
    if (string.IsNullOrEmpty(ipdIdRaw) && Context.Request.RouteValues.TryGetValue("ipId", out var rvIpId))
    {
        ipdIdRaw = rvIpId?.ToString();
    }
    if (string.IsNullOrEmpty(ipdIdRaw) && Context.Request.RouteValues.TryGetValue("id", out var rvId))
    {
        ipdIdRaw = rvId?.ToString();
    }
    string ipdIdValue = string.IsNullOrEmpty(ipdIdRaw) ? "0" : ipdIdRaw;

    string patientIdRaw = Context.Request.Query["patientId"].ToString();
    string patientIdValue = string.IsNullOrEmpty(patientIdRaw) ? "0" : patientIdRaw;
}

<style>
    .ipd-tabbar {
        display: flex;
        justify-content: space-evenly;
        align-items: flex-start;
        flex-wrap: nowrap;
        overflow-x: auto;
        background: #fff;
        padding: 8px 16px;
        border-bottom: 1px solid #e5e5e5;
        gap: 6px;
    }

        .ipd-tabbar::-webkit-scrollbar {
            height: 5px;
        }

        .ipd-tabbar::-webkit-scrollbar-thumb {
            background: #d0d0d0;
            border-radius: 10px;
        }

    .ipd-tab,
    .ipd-dropdown-toggle {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        width: 115px;
        min-width: 90px;
        padding: 4px 4px;
        text-align: center;
        text-decoration: none;
        color: #4f63ff;
        font-size: 11px;
        font-weight: 500;
        line-height: 1.25;
        transition: .2s;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
    }

        .ipd-tab i,
        .ipd-dropdown-toggle > i {
            font-size: 18px;
            margin-bottom: 3px;
        }

        .ipd-tab:hover,
        .ipd-dropdown-toggle:hover {
            color: #222;
            text-decoration: none;
        }

        .ipd-tab.active,
        .ipd-dropdown-toggle.active {
            color: #222;
            border-bottom: 3px solid #6f42c1;
        }

    .dropdown {
        display: flex;
    }

    .dropdown-menu {
        margin-top: 8px;
        border: 0;
        border-radius: 8px;
        box-shadow: 0 6px 20px rgba(0,0,0,.15);
    }

    .dropdown-item {
        font-size: 14px;
        padding: 8px 18px;
    }

        .dropdown-item:hover {
            background: #f5f5f5;
        }

    .tab-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

    .tab-label {
        line-height: 1.2;
        text-align: center;
    }
    /* Icon colors matching screenshot */
    .icon-registration {
        color: #4a4ae0;
    }

    .icon-opconsult {
        color: #20c997;
    }

    .icon-admissionnotes {
        color: #6f42c1;
    }

    .icon-diagnosis {
        color: #28a745;
    }

    .icon-clinicaldetails {
        color: #fd7e14;
    }

    .icon-procedures {
        color: #dc3545;
    }

    .icon-dailynotes {
        color: #0d6efd;
    }

    .icon-otherdocs {
        color: #ffc107;
    }

    .icon-billingsheet {
        color: #20c997;
    }

    .icon-discharge {
        color: #fd7e14;
    }

    .icon-bedshift {
        color: #17a2b8;
    }
</style>

