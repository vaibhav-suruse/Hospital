@* ===================================================================
   This no longer calls the Bootstrap JS Dropdown component AT ALL.
   Every previous fix called bootstrap.Dropdown(...) and relied on
   window.bootstrap being the real Bootstrap library - but we only ever
   confirmed `typeof bootstrap === 'object'`, never that
   `bootstrap.Dropdown` itself exists. If something else on this page
   also defines a global named `bootstrap` (unrelated to the library),
   every previous script's own safety check
   (`if (!bootstrap.Dropdown) return;`) would silently no-op - which
   exactly matches what's been happening (no errors, nothing happens).

   This version depends on nothing but plain DOM APIs: it toggles a
   custom class ourselves and positions the menu with
   getBoundingClientRect() math. Bootstrap's CSS (just the visual
   classes, not its JS) is still used so the menu still looks the
   same. The window-capture click interception from the previous fix
   is kept, since that part was sound regardless of the bootstrap.js
   question.
   =================================================================== *@
<style>
    #ipdTabBar .dropdown-menu.ipd-open {
        display: block !important;
        position: fixed !important;
    }
</style>
<script>
    (function () {
        function closeAllMenus() {
            document.querySelectorAll('#ipdTabBar .dropdown-menu.ipd-open').forEach(function (m) {
                m.classList.remove('ipd-open');
            });
        }

        function openMenu(toggleEl, menuEl) {
            closeAllMenus();
            var rect = toggleEl.getBoundingClientRect();
            menuEl.style.top = (rect.bottom + 4) + 'px';
            menuEl.style.left = rect.left + 'px';
            menuEl.classList.add('ipd-open');
        }

        window.addEventListener('click', function (event) {
            var toggleEl = event.target.closest('#ipdTabBar .ipd-dropdown-toggle');

            if (toggleEl) {
                var menuEl = toggleEl.nextElementSibling;
                if (!menuEl || !menuEl.classList.contains('dropdown-menu')) return;

                event.preventDefault();
                event.stopPropagation();
                if (event.stopImmediatePropagation) event.stopImmediatePropagation();

                var alreadyOpen = menuEl.classList.contains('ipd-open');
                closeAllMenus();
                if (!alreadyOpen) openMenu(toggleEl, menuEl);
                return;
            }

            // Clicked somewhere else entirely - close any open menu,
            // unless the click was inside the open menu itself.
            if (!event.target.closest('#ipdTabBar .dropdown-menu')) {
                closeAllMenus();
            }
        }, true); // capture phase on window - earliest possible interception point

        window.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeAllMenus();
        });
    })();
</script>



