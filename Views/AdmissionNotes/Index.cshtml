        /* ══════════════════════════════════════════════════════
           ONE-CLICK CLINICAL FINDINGS
        ══════════════════════════════════════════════════════ */
        function loadFindingChips(field, targetInputId) {
            $.ajax({
                url: '/AdmissionNotes/GetClinicalFindings', type: 'GET',
                data: { fieldName: field },
                success: function (list) {
                    var wrap = $('#chips_' + field).empty();
                    (list || []).forEach(function (f) {
                        var chip = $('<span class="finding-chip"></span>').text(f.findingName)
                            .attr('title', f.findingText)
                            .on('click', function () { appendFinding(targetInputId, f.findingText); });
                        wrap.append(chip);
                    });
                    var addChip = $('<span class="finding-chip add-custom">+ Custom</span>')
                        .on('click', function () { addCustomFinding(field, targetInputId); });
                    wrap.append(addChip);
                }
            });
        }

        function appendFinding(inputId, text) {
            var $inp = $('#' + inputId);
            var cur = ($inp.val() || '').trim();
            $inp.val(cur ? (cur + ' ' + text) : text);
        }

        function addCustomFinding(field, targetInputId) {
            var name = prompt('Finding name (e.g. "Mild Wheeze"):');
            if (!name) return;
            var text = prompt('Text to insert when this is clicked:');
            if (!text) return;
            $.ajax({
                url: '/AdmissionNotes/SaveClinicalFinding', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ fieldName: field, findingName: name, findingText: text }),
                success: function (r) {
                    if (r.success) loadFindingChips(field, targetInputId);
                    else alert(r.message || 'Error saving finding.');
                }
            });
        }

        function initAllFindingChips() {
            [['CVS', 'sysCvs'], ['RS', 'sysRs'], ['CNS', 'sysCns'], ['ABDOMEN', 'sysAbdomen'],
             ['ENT', 'sysEnt'], ['SKIN', 'sysSkin'], ['MSK', 'sysMsk']].forEach(function (pair) {
                loadFindingChips(pair[0], pair[1]);
            });
        }

        /* ══════════════════════════════════════════════════════
           DEPARTMENT-BASED CLINICAL TEMPLATES
        ══════════════════════════════════════════════════════ */
        window.applyDepartmentTemplate = function () {
            var id = parseInt($('#deptTemplateSelect').val());
            if (!id) { alert('Select a department template first.'); return; }
            var tpl = (__deptTemplates || []).find(function (t) { return t.deptTemplateId === id; });
            if (!tpl) return;

            // Populate chief complaints (added one by one, then refreshed)
            var complaints = (tpl.commonComplaints || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            var chain = Promise.resolve();
            complaints.forEach(function (name) {
                chain = chain.then(function () {
                    return $.ajax({
                        url: '/AdmissionNotes/SaveChiefComplaint', type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ action: 'ADD', ipdId: ipdId, patientId: patientId, complaintName: name })
                    });
                });
            });

            // Populate examination findings (JSON: {"CVS":"...","RS":"..."})
            try {
                var findings = JSON.parse(tpl.examinationFindings || '{}');
                Object.keys(findings).forEach(function (field) {
                    var inputMap = { CVS: 'sysCvs', RS: 'sysRs', CNS: 'sysCns', ABDOMEN: 'sysAbdomen', ENT: 'sysEnt', SKIN: 'sysSkin', MSK: 'sysMsk' };
                    var targetId = inputMap[field];
                    if (targetId) $('#' + targetId).val(findings[field]);
                });
            } catch (e) { /* ignore malformed JSON */ }

            // Populate standard notes into Remarks (does not overwrite existing text — appends)
            if (tpl.standardNotes) {
                var cur = $('#txtRemarks').val() || '';
                $('#txtRemarks').val(cur ? (cur + '\n' + tpl.standardNotes) : tpl.standardNotes);
            }

            // Show suggested diagnoses as display-only chips (never auto-written to Diagnosis module)
            if (tpl.frequentDiagnosis) {
                var chips = tpl.frequentDiagnosis.split(',').map(function (d) {
                    return '<span class="dept-suggest-chip">' + d.trim() + '</span>';
                }).join(' ');
                $('#deptSuggestedDx').html('Suggested Dx (add via Diagnosis tab): ' + chips);
            }

            chain.then(function () { refreshAdmissionNotes(); })
                 .catch(function () { alert('Some complaints may not have saved — please check the list.'); refreshAdmissionNotes(); });
        };

