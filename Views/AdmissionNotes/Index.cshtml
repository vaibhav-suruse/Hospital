<!-- ══ MODAL: Add / Edit Template (shared) ═════════════════════════ -->
<div class="modal fade" id="tplModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tplModalTitle">Add Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tplId" value="0" />
                <input type="hidden" id="tplType" value="" />
                <div class="mb-2">
                    <label class="form-label">Template Name</label>
                    <input type="text" id="tplName" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Template Text</label>
                    <textarea id="tplText" class="form-control form-control-sm" rows="4"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary btn-sm" onclick="saveTpl()">Save</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        var ipdId     = parseInt(document.getElementById('hdnIpdId').value);
        var patientId = parseInt(document.getElementById('hdnPatientId').value);

        var allergyModal   = new bootstrap.Modal(document.getElementById('allergyModal'));
        var historyModal   = new bootstrap.Modal(document.getElementById('historyModal'));
        var tplModal       = new bootstrap.Modal(document.getElementById('tplModal'));
        var complaintModal = new bootstrap.Modal(document.getElementById('complaintModal'));
        var auditModal     = new bootstrap.Modal(document.getElementById('auditModal'));
        var viewDetailsModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));

        /* ─── helper ──────────────────────────────────────────── */
        function esc(t) {
            return (t || '').replace(/"/g, '&quot;').replace(/\n/g, '&#10;');
        }

        /* ─── Generic read-only "View Details" modal renderer ──── */
        function renderViewDetails(title, rows) {
            $('#viewDetailsTitle').text(title);
            var html = '';
            rows.forEach(function (pair) {
                var label = pair[0], value = pair[1];
                html += '<div class="vd-row" style="margin-bottom:8px;">' +
                    '<div class="field-label" style="margin-bottom:1px;">' + label + '</div>' +
                    '<div>' + (value === null || value === undefined || value === '' ? '<span class="text-muted">—</span>' : esc(String(value))) + '</div>' +
                    '</div>';
            });
            $('#viewDetailsBody').html(html);
            viewDetailsModal.show();
        }

        /* ─── Safe refresh: works whether this view is loaded
               inside the IPD tab shell (loadTab exists) or opened
               directly by URL (loadTab does not exist) ────────── */
        function refreshAdmissionNotes() {
            if (typeof window.loadTab === 'function') {
                try { window.loadTab('AdmissionNotes'); return; } catch (e) { /* fall through to reload */ }
            }
            location.reload();
        }
        function targetId(section) {
            return section === 'COMPLAINT'   ? '#txtCurrentComplaint'
                 : section === 'EXAMINATION' ? '#txtExamination'
                 : '#txtRemarks';
        }
        function listId(section) {
            return '#list' + section;
        }

        /* ─── Apply template text ─────────────────────────────── */
        window.applyTpl = function (section, el) {
            var text = $(el).closest('li').data('text') || '';
            var t    = targetId(section);
            var cur  = $(t).val();
            $(t).val(cur ? cur + '\n' + text : text);
        };

        /* ─── Save Notes (Examination) ────────────────────────── */
        window.saveNotes = function () {
            $.ajax({
                url: '/AdmissionNotes/SaveNotes', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ipdId: ipdId, patientId: patientId,
                    currentComplaint: null, // structured chief complaints saved individually
                    examination:      $('#txtExamination').val()
                }),
                success: function (r) { if (r.success) { markSaved(); alert(r.message); } },
                error:   function ()  { alert('Error saving notes.'); }
            });
        };

        /* ─── Save Remarks ────────────────────────────────────── */
        window.saveRemarks = function () {
            $.ajax({
                url: '/AdmissionNotes/SaveRemarks', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ipdId: ipdId, patientId: patientId,
                    remarks: $('#txtRemarks').val()
                }),
                success: function (r) { if (r.success) alert(r.message); },
                error:   function ()  { alert('Error saving remarks.'); }
            });
        };

        /* ─── Load Previous ───────────────────────────────────── */
        window.loadPrevious = function (section) {
            $.ajax({
                url: '/AdmissionNotes/LoadPrevious', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ patientId: patientId, ipdId: ipdId }),
                success: function (r) {
                    if (!r.success) { alert(r.message); return; }
                    if (section === 'COMPLAINT')   $('#txtCurrentComplaint').val(r.currentComplaint);
                    else                           $('#txtExamination').val(r.examination);
                }
            });
        };

        /* ─── Clear field ─────────────────────────────────────── */
        window.clearField = function (section) {
            if (!confirm('Are you sure?')) return;
            if (section === 'REMARKS') { $('#txtRemarks').val(''); return; }
            $.ajax({
                url: '/AdmissionNotes/ClearNotes', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ipdId: ipdId, field: section }),
                success: function (r) {
                    if (r.success) $(targetId(section)).val('');
                }
            });
        };

        var svgEdit = '<svg class="tpl-icon tpl-icon-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>';
        var svgDel  = '<svg class="tpl-icon tpl-icon-del" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>';

        /* ─── Search Templates ────────────────────────────────── */
        var stimer;
        window.searchTpl = function (section, val) {
            clearTimeout(stimer);
            stimer = setTimeout(function () {
                $.ajax({
                    url: '/AdmissionNotes/GetTemplates', type: 'GET',
                    data: { type: section, search: val },
                    success: function (list) {
                        var ul = $(listId(section)).empty();
                        list.forEach(function (t) {
                            ul.append(
                                '<li data-id="' + t.templateId + '" data-text="' + esc(t.templateText) + '">' +
                                    '<span class="tpl-name" onclick="applyTpl(\'' + section + '\',this)">' + t.templateName + '</span>' +
                                    '<span class="tpl-actions">' +
                                        svgEdit.replace('viewBox', 'onclick="editTpl(\'' + section + '\',' + t.templateId + ',\'' + t.templateName + '\',this)" viewBox') +
                                        svgDel.replace('viewBox', 'onclick="deleteTpl(' + t.templateId + ',this)" viewBox') +
                                    '</span>' +
                                '</li>'
                            );
                        });
                    }
                });
            }, 300);
        };

        /* ─── Template Modal Open (Add) ───────────────────────── */
        window.openTplModal = function (section) {
            $('#tplModalTitle').text('Add Template');
            $('#tplId').val(0); $('#tplType').val(section);
            $('#tplName').val(''); $('#tplText').val('');
            tplModal.show();
        };

        /* ─── Template Modal Open (Edit) ─────────────────────── */
        window.editTpl = function (section, id, name, el) {
            $('#tplModalTitle').text('Edit Template');
            $('#tplId').val(id); $('#tplType').val(section);
            $('#tplName').val(name);
            $('#tplText').val($(el).closest('li').data('text') || '');
            tplModal.show();
        };

        /* ─── Save Template ───────────────────────────────────── */
        window.saveTpl = function () {
            var id = parseInt($('#tplId').val());
            $.ajax({
                url: '/AdmissionNotes/SaveTemplate', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    action: id > 0 ? 'UPDATE' : 'ADD',
                    templateId:   id,
                    templateType: $('#tplType').val(),
                    templateName: $('#tplName').val(),
                    templateText: $('#tplText').val()
                }),
                success: function (r) {
                    if (r.success) { tplModal.hide(); refreshAdmissionNotes(); }
                }
            });
        };

        /* ─── Delete Template ─────────────────────────────────── */
        window.deleteTpl = function (id, el) {
            if (!confirm('Delete template?')) return;
            $.ajax({
                url: '/AdmissionNotes/SaveTemplate', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ action: 'DELETE', templateId: id }),
                success: function (r) { if (r.success) $(el).closest('li').remove(); }
            });
        };

        /* ─── Allergy Modal ───────────────────────────────────── */
        window.openAllergyModal = function () {
            $('#allergyModalTitle').text('Add Allergy');
            $('#algId').val(0);
            $('#algType').val('Drug'); $('#algName').val('');
            $('#algReaction').val(''); $('#algSeverity').val('Mild');
            $('#algDate').val(''); $('#algClinicalStatus').val('Active');
            $('#algVerifiedBy').val(''); $('#algRemarks').val('');
            allergyModal.show();
        };

        window.editAllergy = function (id) {
            var a = (__initialAllergies || []).find(function (x) { return x.allergyId === id; });
            if (!a) { alert('Could not find this allergy record.'); return; }
            $('#allergyModalTitle').text('Edit Allergy');
            $('#algId').val(a.allergyId);
            $('#algType').val(a.allergyType || 'Drug');
            $('#algName').val(a.allergyName || '');
            $('#algReaction').val(a.reaction || '');
            $('#algSeverity').val(a.severity || 'Mild');
            $('#algDate').val(a.dateIdentified ? a.dateIdentified.substring(0, 10) : '');
            $('#algClinicalStatus').val(a.clinicalStatus || 'Active');
            $('#algVerifiedBy').val(a.verifiedBy || '');
            $('#algRemarks').val(a.remarks || '');
            allergyModal.show();
        };

        window.viewAllergy = function (id) {
            var a = (__initialAllergies || []).find(function (x) { return x.allergyId === id; });
            if (!a) return;
            renderViewDetails('Allergy Details', [
                ['Type', a.allergyType], ['Allergen', a.allergyName], ['Reaction', a.reaction],
                ['Severity', a.severity], ['Date Identified', a.dateIdentified ? a.dateIdentified.substring(0, 10) : ''],
                ['Clinical Status', a.clinicalStatus], ['Verified By (User ID)', a.verifiedBy],
                ['Remarks', a.remarks], ['Recorded Date', a.recordedDate ? a.recordedDate.substring(0, 10) : '']
            ]);
        };

        window.saveAllergy = function () {
            if (!$('#algName').val().trim()) { alert('Allergen name is required.'); return; }
            var id = parseInt($('#algId').val()) || 0;
            $.ajax({
                url: '/AdmissionNotes/SaveAllergy', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    action: id > 0 ? 'UPDATE' : 'ADD', allergyId: id, patientId: patientId, ipdId: ipdId,
                    allergyType: $('#algType').val(),
                    allergyName: $('#algName').val(),
                    reaction:    $('#algReaction').val(),
                    severity:    $('#algSeverity').val(),
                    dateIdentified: $('#algDate').val() || null,
                    verifiedBy:  $('#algVerifiedBy').val() ? parseInt($('#algVerifiedBy').val()) : null,
                    clinicalStatus: $('#algClinicalStatus').val(),
                    remarks:     $('#algRemarks').val()
                }),
                success: function (r) {
                    if (r.success) { allergyModal.hide(); refreshAdmissionNotes(); }
                    else alert(r.message || 'Error saving allergy.');
                },
                error: function () { alert('Error saving allergy.'); }
            });
        };

        window.deleteAllergy = function (id, el) {
            if (!confirm('Delete this allergy?')) return;
            $.ajax({
                url: '/AdmissionNotes/SaveAllergy', type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ action: 'DELETE', allergyId: id }),
                success: function (r) {
                    if (r.success) {
                        $(el).closest('tr').remove();
                        if ($('#allergyBody tr').length === 0)
                            $('#allergyBody').html('<tr><td colspan="6" class="an-empty">No Allergies Added</td></tr>');
                        refreshCriticalBanner();
                        updateSectionProgress();
                    }
                }
            });
        };

        /* ─── Medical History Modal ───────────────────────────── */
        window.openHistoryModal = function () {
            $('#historyModalTitle').text('Add Medical History');
            $('#histId').val(0); $('#histType').val(''); $('#histDesc').val('');
            $('#histMedication').val('');
            $('#histYear').val(''); $('#histStatus').val('Active');
            $('#histControlStatus').val(''); $('#histFollowup').val(''); $('#histRemarks').val('');
            historyModal.show();
        };

        window.editHistory = function (id) {
            var h = (__initialMedicalHistory || []).find(function (x) { return x.historyId === id; });
            if (!h) { alert('Could not find this medical history record.'); return; }
            $('#historyModalTitle').text('Edit Medical History');
            $('#histId').val(h.historyId);
            $('#histType').val(h.historyType || '');
            $('#histDesc').val(h.description || '');
            $('#histMedication').val(h.medication || '');
            $('#histYear').val(h.sinceYear || '');
            $('#histStatus').val(h.status || 'Active');
            $('#histControlStatus').val(h.controlStatus || '');
            $('#histFollowup').val(h.lastFollowupDate ? h.lastFollowupDate.substring(0, 10) : '');
            $('#histRemarks').val(h.remarks || '');
            historyModal.show();
        };

        window.viewHistory = function (id) {
            var h = (__initialMedicalHistory || []).find(function (x) { return x.historyId === id; });
            if (!h) return;
            renderViewDetails('Medical History Details', [
                ['Condition/Type', h.historyType], ['Description', h.description], ['Medication', h.medication],
                ['Since Year', h.sinceYear], ['Status', h.status], ['Control Status', h.controlStatus],
                ['Last Follow-up', h.lastFollowupDate ? h.lastFollowupDate.substring(0, 10) : ''],
                ['Remarks', h.remarks], ['Recorded Date', h.recordedDate ? h.recordedDate.substring(0, 10) : '']
            ]);
        };

