            $('#prevPanelContent').html('<div class="prev-empty">Loading...</div>');
            $.ajax({
                url: '/AdmissionNotes/GetPreviousAdmission', type: 'GET',
                data: { patientId: patientId, ipdId: ipdId },
                success: renderPreviousPanel,
                error: function () { $('#prevPanelContent').html('<div class="prev-empty">Could not load previous admission.</div>'); }
            });
        };
        window.closePreviousPanel = function () {
            $('#prevOverlay').removeClass('show');
            $('#prevPanel').removeClass('show');
        };

        function diffLine(label, prevVal, curVal, onCopy) {
            var isDiff = (prevVal || '') !== (curVal || '') && prevVal;
            var cls = isDiff ? 'prev-diff' : '';
            var html = '<div class="' + cls + '" style="margin-bottom:6px;">' +
                '<strong>' + label + ':</strong> ' + (prevVal ? esc(prevVal) : '<span class="text-muted">—</span>');
            if (prevVal && onCopy) {
                html += ' <span class="prev-copy-btn" onclick="' + onCopy + '">Copy</span>';
            }
            html += '</div>';
            return html;
        }

        function renderPreviousPanel(p) {
            if (!p) { $('#prevPanelContent').html('<div class="prev-empty">No previous admission found for this patient.</div>'); return; }
            var html = '';
            html += '<div class="prev-section"><div class="prev-section-title">Admission #' + esc(p.admissionNumber) + '</div>' +
                '<div class="an-save-status">' + (p.admissionDate ? new Date(p.admissionDate).toLocaleDateString() : '') +
                ' → ' + (p.dischargeDate ? new Date(p.dischargeDate).toLocaleDateString() : 'Ongoing') + ' (' + esc(p.status) + ')</div></div>';

            html += '<div class="prev-section"><div class="prev-section-title">Complaint / Examination (free text)</div>' +
                diffLine('Complaint', p.previousCurrentComplaint, $('#txtCurrentComplaint').length ? $('#txtCurrentComplaint').val() : '', "copyToField('txtExamination', this)") +
                diffLine('Examination', p.previousExamination, $('#txtExamination').val(), "copyToField('txtExamination', this)") + '</div>';

            html += '<div class="prev-section"><div class="prev-section-title">Chief Complaints</div>';
            if (p.previousChiefComplaints && p.previousChiefComplaints.length) {
                p.previousChiefComplaints.forEach(function (c) {
                    html += '<div style="margin-bottom:4px;">• ' + esc(c.complaintName) +
                        (c.severity ? ' (' + c.severity + ')' : '') + '</div>';
                });
            } else { html += '<div class="text-muted">None recorded</div>'; }
            html += '</div>';

            html += '<div class="prev-section"><div class="prev-section-title">Allergies</div>';
            if (p.previousAllergies && p.previousAllergies.length) {
                p.previousAllergies.forEach(function (a) {
                    html += '<div style="margin-bottom:4px;">• ' + esc(a.allergyName) + ' — ' + esc(a.severity) + '</div>';
                });
            } else { html += '<div class="text-muted">None recorded</div>'; }
            html += '</div>';

            html += '<div class="prev-section"><div class="prev-section-title">Medical History</div>';
            if (p.previousMedicalHistory && p.previousMedicalHistory.length) {
                p.previousMedicalHistory.forEach(function (h) {
                    html += '<div style="margin-bottom:4px;">• ' + esc(h.historyType) + '</div>';
                });
            } else { html += '<div class="text-muted">None recorded</div>'; }
            html += '</div>';

            html += '<div class="prev-section"><div class="prev-section-title">Diagnosis (read-only, from Diagnosis tab)</div>';
            if (p.previousDiagnoses && p.previousDiagnoses.length) {
                p.previousDiagnoses.forEach(function (d) {
                    html += '<div style="margin-bottom:4px;">• ' + esc(d.diagnosisName) + ' (' + esc(d.diagnosisType) + (d.diagnosisSubtype ? ', ' + d.diagnosisSubtype : '') + ')</div>';
                });
            } else { html += '<div class="text-muted">None recorded</div>'; }
            html += '</div>';

            $('#prevPanelContent').html(html);
        }

        window.copyToField = function (fieldId, el) {
            var text = $(el).closest('div').text().replace('Copy', '').replace(/^[A-Za-z ]+:\s*/, '').trim();
            var $target = $('#' + fieldId);
            var cur = $target.val() || '';
            $target.val(cur ? (cur + '\n' + text) : text);
            markDirty();
        };

        /* ══════════════════════════════════════════════════════
           AUDIT TRAIL
        ══════════════════════════════════════════════════════ */
        window.openAuditLog = function () {
            auditModal.show();
            $('#auditLogBody').html('<div class="prev-empty">Loading...</div>');
            $.ajax({
                url: '/AdmissionNotes/GetAuditLog', type: 'GET',
                data: { ipdId: ipdId },
                success: function (list) {
                    if (!list || list.length === 0) {
                        $('#auditLogBody').html('<div class="prev-empty">No audit entries yet for this admission.</div>');
                        return;
                    }
                    var html = '';
                    list.forEach(function (a) {
                        html += '<div class="audit-row"><strong>[' + esc(a.entityType) + ' — ' + esc(a.action) + ']</strong> ' + esc(a.description) +
                            '<div class="audit-meta">' + new Date(a.changedDate).toLocaleString() +
                            (a.ipAddress ? ' • IP: ' + esc(a.ipAddress) : '') + '</div></div>';
                    });
                    $('#auditLogBody').html(html);
                },
                error: function () { $('#auditLogBody').html('<div class="prev-empty">Could not load audit history.</div>'); }
            });
        };

        /* ─── init phase 2 ─────────────────────────────────────── */
        initHpiFromServer();
        initExamFromServer();
        initAllFindingChips();

        /* ─── init ──────────────────────────────────────────────── */
        refreshCriticalBanner();
        updateSectionProgress();

    })();
</script>
