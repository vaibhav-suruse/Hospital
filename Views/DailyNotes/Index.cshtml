@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ============================================================
        // GLOBAL VARIABLES
        // ============================================================
        let currentTab = '@Model.ActiveTab';
        let deleteNoteId = 0;
        let deleteNoteType = '';
        let isSubmitting = false;
        let selectedMedicines = [];
        let selectedLabs = [];
        let selectedSymptoms = [];
        let vitalsChart = null;

        // ============================================================
        // BUTTON FUNCTIONS (called by onclick)
        // ============================================================
        function openAddDoctorModal() {
            resetDoctorForm();
            $('#doctorModalTitle').text('Add Doctor Note');
            $('#doctorSaveBtnText').text('Save');
            clearModalOrderPreviews();
            $('#doctorNoteModal').modal('show');
        }

        function openAddNurseModal() {
            resetNurseForm();
            $('#nurseModalTitle').text('Add Nurse Note');
            $('#nurseSaveBtnText').text('Save');
            $('#nurseNoteModal').modal('show');
        }

        function showHandoverReport() {
            $('#handoverModal').modal('show');
            $.getJSON('/DailyNotes/GetHandoverReport', { ipId: @Model.IpId }, function(response) {
                if (response.success) {
                    renderHandoverReport(response.data);
                } else {
                    $('#handoverBody').html('<div class="alert alert-danger">' + response.message + '</div>');
                }
            });
        }

        // ============================================================
        // DOCUMENT READY
        // ============================================================
        $(document).ready(function() {
            loadTemplates(currentTab);
            loadVitalsChart();

            $('#doctorSaveTemplate').change(function() {
                $('#doctorTemplateNameDiv').toggle(this.checked);
            });
            $('#nurseSaveTemplate').change(function() {
                $('#nurseTemplateNameDiv').toggle(this.checked);
            });

            $('#doctorNoteModal').on('hide.bs.modal', function(e) {
                if ($('#doctorNotes').val().trim() !== '' && !confirm('Discard unsaved changes?')) {
                    e.preventDefault();
                }
            });
            $('#nurseNoteModal').on('hide.bs.modal', function(e) {
                if ($('#nurseNotes').val().trim() !== '' && !confirm('Discard unsaved changes?')) {
                    e.preventDefault();
                }
            });
        });

        // ============================================================
        // TEMPLATES
        // ============================================================
        function switchTab(tab) { currentTab = tab; loadTemplates(tab); }

        function loadTemplates(type) {
            $.getJSON('/DailyNotes/GetTemplates', { type: type }, function(response) {
                if (response.success) {
                    let select = type === 'doctor' ? '#doctorTemplateSelect' : '#nurseTemplateSelect';
                    let $select = $(select);
                    $select.find('option:not(:first)').remove();
                    $.each(response.data, function(i, t) {
                        $select.append(`<option value="${t.templateId}" data-text="${escapeHtml(t.templateText)}">${escapeHtml(t.templateName)}</option>`);
                    });
                }
            });
        }

        function applyDoctorTemplate() {
            let text = $('#doctorTemplateSelect option:selected').data('text');
            if (text) $('#doctorNotes').val(text);
        }

        function applyNurseTemplate() {
            let text = $('#nurseTemplateSelect option:selected').data('text');
            if (text) $('#nurseNotes').val(text);
        }

        // ============================================================
        // VITALS CHART
        // ============================================================
        function loadVitalsChart() {
            $.getJSON('/DailyNotes/GetVitalsTrend', { ipId: @Model.IpId }, function(response) {
                if (response.success) {
                    renderVitalsChart(response.data);
                    updateLatestVitals(response.data.latestVitals);
                    showVitalsAlerts(response.data.alerts);
                }
            });
        }

        function renderVitalsChart(data) {
            if (!data.labels || data.labels.length === 0) {
                $('#vitalsChart').parent().html('<div class="text-center text-muted py-4">No vitals data available.</div>');
                return;
            }
            if (vitalsChart) vitalsChart.destroy();
            vitalsChart = new Chart(document.getElementById('vitalsChart'), {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [
                        { label: 'Temperature (°C)', data: data.temperature, borderColor: '#dc3545', tension: 0.3, yAxisID: 'y' },
                        { label: 'Pulse (bpm)', data: data.pulse, borderColor: '#0d6efd', tension: 0.3, yAxisID: 'y1' },
                        { label: 'BP Systolic', data: data.systolic, borderColor: '#198754', tension: 0.3, yAxisID: 'y1' },
                        { label: 'BP Diastolic', data: data.diastolic, borderColor: '#6f42c1', tension: 0.3, yAxisID: 'y1' },
                        { label: 'SpO₂ (%)', data: data.spo2, borderColor: '#fd7e14', tension: 0.3, yAxisID: 'y' }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        y: { type: 'linear', position: 'left', title: { display: true, text: 'Temp / SpO₂' } },
                        y1: { type: 'linear', position: 'right', title: { display: true, text: 'Pulse / BP' }, grid: { drawOnChartArea: false } }
                    }
                }
            });
        }

        function updateLatestVitals(v) {
            if (!v) return;
            if (v.temperature) { $('#vitalTemp h4').text(v.temperature + '°C'); if (v.temperature < 36 || v.temperature > 38) $('#vitalTemp').addClass('abnormal'); }
            if (v.pulse) { $('#vitalPulse h4').text(v.pulse + ' bpm'); if (v.pulse < 60 || v.pulse > 100) $('#vitalPulse').addClass('abnormal'); }
            if (v.systolic && v.diastolic) { $('#vitalBP h4').text(v.systolic + '/' + v.diastolic); if (v.systolic > 140 || v.diastolic > 90) $('#vitalBP').addClass('abnormal'); }
            if (v.oxygenSaturation) { $('#vitalSpO2 h4').text(v.oxygenSaturation + '%'); if (v.oxygenSaturation < 95) $('#vitalSpO2').addClass('abnormal'); }
            if (v.respirationRate) $('#vitalRR h4').text(v.respirationRate + '/min');
        }

        function showVitalsAlerts(alerts) {
            if (alerts && alerts.length > 0) {
                $('#alertCount').text(alerts.length + ' Alert(s)').show();
                $('#vitalsAlertMessage').html(alerts.map(a => '• ' + a.time + ': ' + a.message).join('<br>'));
                $('#vitalsAlertBanner').removeClass('d-none');
            } else {
                $('#alertCount').hide();
                $('#vitalsAlertBanner').addClass('d-none');
            }
        }

        // ============================================================
        // PENDING ORDERS
        // ============================================================
        // BUGFIX: previously these fetched IPD-wide "everything ever ordered"
        // data and cached it globally, then showed that same cache inside
        // BOTH the Add-New modal and the Edit modal. That's exactly why
        // "Add New Doctor Note" showed medicine added a day before under a
        // completely different note - it was never scoped to this note at
        // all. Now: Add New shows nothing (there's no round yet, it's a
        // fresh note), and Edit shows only what's actually linked to THIS
        // note's round, fetched via GetNoteDetail.
        function clearModalOrderPreviews() {
            $('#modalExistingMedicines').html('<small class="text-muted">This is a new note - nothing added yet.</small>');
            $('#modalExistingLabs').html('<small class="text-muted">This is a new note - nothing added yet.</small>');
            $('#modalExistingSymptoms').html('<small class="text-muted">This is a new note - nothing added yet.</small>');
        }

        function loadOrdersForNoteIntoModal(noteId) {
            $.getJSON('/DailyNotes/GetNoteDetail', { noteId: noteId }, function(r) {
                if (!r.success) return;

                if (!r.medicines || r.medicines.length === 0) {
                    $('#modalExistingMedicines').html('<small class="text-muted">No medicines added to this note.</small>');
                } else {
                    let html = '<div style="max-height:150px;overflow-y:auto;">';
                    $.each(r.medicines, function(i, m) {
                        html += `<div class="d-flex justify-content-between align-items-center mb-1 p-1 bg-light rounded"><div><strong>${escapeHtml(m.medicineName)}</strong><small class="text-muted d-block">${escapeHtml(m.dosage)}</small></div><span class="badge bg-warning text-dark">${escapeHtml(m.status)}</span></div>`;
                    });
                    $('#modalExistingMedicines').html(html + '</div>');
                }

                if (!r.labs || r.labs.length === 0) {
                    $('#modalExistingLabs').html('<small class="text-muted">No lab tests added to this note.</small>');
                } else {
                    let html = '<div style="max-height:150px;overflow-y:auto;">';
                    $.each(r.labs, function(i, l) {
                        let badge = l.priority === 'STAT' ? 'bg-danger' : l.priority === 'Urgent' ? 'bg-warning' : 'bg-info';
                        html += `<div class="d-flex justify-content-between align-items-center mb-1 p-1 bg-light rounded"><div><strong>${escapeHtml(l.testName)}</strong></div><span class="badge ${badge}">${escapeHtml(l.status)}</span></div>`;
                    });
                    $('#modalExistingLabs').html(html + '</div>');
                }

                if (!r.symptoms || r.symptoms.length === 0) {
                    $('#modalExistingSymptoms').html('<small class="text-muted">No symptoms added to this note.</small>');
                } else {
                    let html = '';
                    $.each(r.symptoms, function(i, s) {
                        html += `<span class="badge bg-warning text-dark me-1 mb-1 p-2">${escapeHtml(s.symptomName)}</span>`;
                    });
                    $('#modalExistingSymptoms').html(html);
                }
            });
        }

        // ============================================================
        // DOCTOR NOTES
        // ============================================================
        function editDoctorNote(id) {
            showLoading();
            $.getJSON('/DailyNotes/GetDoctorNoteById', { noteId: id }, function(r) {
                hideLoading();
                if (r.success) {
                    let n = r.data;
                    $('#doctorNoteId').val(n.noteId);
                    $('#ddlDoctor').val(n.createdBy || '');
                    $('#doctorTemperature').val(n.temperature || '');
                    $('#doctorPulse').val(n.pulse || '');
                    $('#doctorRespRate').val(n.respRate || '');
                    $('#doctorBpSystolic').val(n.bpSystolic || '');
                    $('#doctorBpDiastolic').val(n.bpDiastolic || '');
                    $('#doctorSpO2').val(n.spO2 || '');
                    $('#doctorNotes').val(n.notes || '');
                    $('#doctorNoteDate').val(n.noteDate ? n.noteDate.substring(0,10) : '');
                    $('#doctorNoteTime').val(n.noteTime ? n.noteTime.substring(0,5) : '');
                    if (n.templateId) $('#doctorTemplateSelect').val(n.templateId);
                    $('#doctorModalTitle').text('Edit Doctor Note');
                    $('#doctorSaveBtnText').text('Update');
                    // BUGFIX: previously this showed IPD-wide "everything ever
                    // ordered", which is exactly why editing one note could
                    // show a medicine added under a completely different note
                    // a day earlier. Now it shows only what's linked to THIS
                    // note's round.
                    selectedMedicines = []; selectedLabs = []; selectedSymptoms = [];
                    renderSelectedMedicines(); renderSelectedLabs(); renderSelectedSymptoms();
                    loadOrdersForNoteIntoModal(n.noteId);
                    $('#doctorNoteModal').modal('show');
                } else showToast('Error', r.message, 'danger');
            });
        }

        function saveDoctorNote() {
            if (isSubmitting) return;
            let notes = $('#doctorNotes').val().trim();
            if (!notes) { showToast('Error', 'Notes cannot be empty.', 'warning'); return; }

            // BUGFIX: the doctor dropdown now also identifies who authored the
            // note itself (previously this was silently set to the logged-in
            // account's Session UserId, which is why "Doctor:" was blank on
            // the Shift Handover report). So it's required for every note now,
            // not just when medicines/labs/symptoms are attached.
            if (!$('#ddlDoctor').val()) {
                showToast('Error', 'Please select a Doctor.', 'warning');
                return;
            }

            isSubmitting = true;
            $('#doctorSaveBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');
            let model = {
                noteId: parseInt($('#doctorNoteId').val()),
                ipId: parseInt($('#doctorIpId').val()),
                createdBy: parseInt($('#ddlDoctor').val()),
                temperature: $('#doctorTemperature').val() ? parseFloat($('#doctorTemperature').val()) : null,
                pulse: $('#doctorPulse').val() ? parseInt($('#doctorPulse').val()) : null,
                respRate: $('#doctorRespRate').val() ? parseInt($('#doctorRespRate').val()) : null,
                bpSystolic: $('#doctorBpSystolic').val() ? parseInt($('#doctorBpSystolic').val()) : null,
                bpDiastolic: $('#doctorBpDiastolic').val() ? parseInt($('#doctorBpDiastolic').val()) : null,
                spO2: $('#doctorSpO2').val() ? parseFloat($('#doctorSpO2').val()) : null,
                notes: notes,
                noteDate: $('#doctorNoteDate').val(),
                noteTime: $('#doctorNoteTime').val(),
                templateId: $('#doctorTemplateSelect').val() ? parseInt($('#doctorTemplateSelect').val()) : null,
                templateName: $('#doctorSaveTemplate').is(':checked') ? $('#doctorTemplateName').val() : null
            };
            $.ajax({
                url: '/DailyNotes/SaveDoctorNote',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function(r) {
                    isSubmitting = false;
                    $('#doctorSaveBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Save');
                    if (r.success) {
                        // The round returned here is THE round linked to this
                        // exact note - every medicine/lab/symptom added in this
                        // session gets tagged with it, so History can later
                        // show precisely what belongs to this note.
                        if (selectedMedicines.length > 0) saveMedicineOrders(r.noteId, r.roundId);
                        if (selectedLabs.length > 0) saveLabOrders(r.noteId, r.roundId);
                        if (selectedSymptoms.length > 0) saveSymptomOrders(r.roundId);

                        $('#doctorNotes').val('');
                        $('#doctorNoteModal').modal('hide');

                        showToast('Success', r.message, 'success');
                        refreshDoctorNotes();
                        selectedMedicines = []; selectedLabs = []; selectedSymptoms = [];
                        renderSelectedMedicines(); renderSelectedLabs(); renderSelectedSymptoms();
                    } else showToast('Error', r.message, 'danger');
                },
                error: function() {
                    isSubmitting = false;
                    $('#doctorSaveBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Save');
                    showToast('Error', 'An error occurred.', 'danger');
                }
            });
        }

                        function saveMedicineOrders(noteId, roundId) {
            // Get selected doctor ID from dropdown
            var selectedDoctorId = $('#ddlDoctor').val();

            if (!selectedDoctorId) {
                showToast('Error', 'Please select a doctor first', 'danger');
                return;
            }

            $.each(selectedMedicines, function(i, m) {
                $.ajax({
                    url: '/DailyNotes/OrderMedicine',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ipdId: @Model.IpId,
                        medicineId: m.medicineId,
                        dosage: m.dosage,
                        morning: m.morning,
                        afternoon: m.afternoon,
                        evening: m.evening,
                        frequency: m.frequency,
                        days: parseInt(m.duration) || 0,
                        route: m.route,
                        instructions: 'From Note #' + noteId,
                        doctorId: parseInt(selectedDoctorId),
                        roundId: roundId || 0
                    }),
                    async: false,
                    success: function(r) {
                        if (!r.success) showToast('Medicine order failed', r.message, 'danger');
                        else showToast('Success', 'Medicine ordered', 'success');
                    },
                    error: function(xhr) {
                        showToast('Medicine order failed', xhr.responseText || 'Request error', 'danger');
                    }
                });
            });
        }



        function saveLabOrders(noteId, roundId) {
            // Get selected doctor ID from dropdown (lab orders also need a doctor)
            var selectedDoctorId = $('#ddlDoctor').val();

            if (!selectedDoctorId) {
                showToast('Error', 'Please select a doctor first for lab orders', 'danger');
                return;
            }

            $.each(selectedLabs, function(i, l) {
                $.ajax({
                    url: '/DailyNotes/OrderLab',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        ipdId: @Model.IpId,
                        testName: l.testName,
                        investigationType: l.investigationType || 'Lab',
                        priority: l.priority,
                        instructions: l.instructions || 'From Note #' + noteId,
                        orderedBy: parseInt(selectedDoctorId),
                        roundId: roundId || 0
                    }),
                    async: false,
                    success: function(r) {
                        if (!r.success) showToast('Lab order failed', r.message, 'danger');
                        else showToast('Success', 'Lab test ordered', 'success');
                    },
                    error: function(xhr) {
                        showToast('Lab order failed', xhr.responseText || 'Request error', 'danger');
                    }
                });
            });
        }

