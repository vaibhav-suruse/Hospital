        // ============================================================
        // HISTORY / NOTE DETAIL
        // ============================================================
        function viewHistory(id, type) {
            $('#historyModalBody').html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i><p>Loading...</p></div>');
            $('#historyModal').modal('show');

            if (type === 'doctor') {
