        function searchMedicines(term) {
            if (term.length < 2) { $('#medicineResults').hide(); return; }
            $.getJSON('/DailyNotes/SearchMedicines', { searchTerm: term }, function(r) {
                if (r.success) {
                    let html = '';
                    $.each(r.data, function(i, m) {
                        html += `<a href="#" class="list-group-item list-group-item-action py-1" onclick="selectMedicine(${m.medicineId},'${escapeHtml(m.medicineName)}')">${escapeHtml(m.medicineName)} <small class="text-muted">(${m.type||'N/A'})</small></a>`;
                    });
                    $('#medicineResults').html(html).show();
                }
            });
        }

        function selectMedicine(id, name) {
            $('#selectedMedicineId').val(id);
            $('#selectedMedicineName').val(name);
            $('#medicineSearch').val(name);
            $('#medicineResults').hide();
        }

        function clearMedicineSearch() { $('#medicineSearch').val(''); $('#selectedMedicineId').val(0); $('#selectedMedicineName').val(''); $('#medicineResults').hide(); }

        function addMedicineToList() {
            let id = parseInt($('#selectedMedicineId').val());
            if (!id || id === 0) { showToast('Error', 'Please select a medicine.', 'warning'); return; }
            if (selectedMedicines.some(m => m.medicineId === id)) { showToast('Error', 'Already added.', 'warning'); return; }
            // The Dosage dropdown value is a Morning-Afternoon-Evening pattern
            // like "1-0-1". Parse it into real booleans so they actually get
            // saved into the Morning/Afternoon/Evening columns.
            let pattern = ($('#medicineDosage').val() || '').split('-');
            selectedMedicines.push({
                medicineId: id,
                medicineName: $('#selectedMedicineName').val(),
                dosage: $('#medicineDosage').val(),
                morning: pattern[0] === '1',
                afternoon: pattern[1] === '1',
                evening: pattern[2] === '1',
                frequency: $('#medicineFrequency').val(),
                duration: $('#medicineDuration').val() + ' ' + $('#medicineDurationUnit').val(),
                quantity: parseInt($('#medicineQuantity').val()),
                route: $('#medicineRoute').val()
            });
            renderSelectedMedicines();
            clearMedicineSearch();
            showToast('Success', 'Medicine added.', 'success');
        }

        function renderSelectedMedicines() {
            if (selectedMedicines.length === 0) { $('#selectedMedicinesList').html('<small class="text-muted">No medicines added.</small>'); return; }
            let html = '<table class="table table-sm table-bordered mt-2"><tr><th>Medicine</th><th>Dosage</th><th>Action</th></tr>';
            $.each(selectedMedicines, function(i, m) {
                html += `<tr><td>${escapeHtml(m.medicineName)}</td><td>${escapeHtml(m.dosage)} ${escapeHtml(m.frequency)}</td><td><button class="btn btn-sm btn-danger" onclick="removeMedicine(${i})"><i class="fas fa-trash"></i></button></td></tr>`;
            });
            $('#selectedMedicinesList').html(html + '</table>');
        }

        function removeMedicine(i) { selectedMedicines.splice(i, 1); renderSelectedMedicines(); }

