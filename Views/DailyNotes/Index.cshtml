        // Full detail for a single doctor's round: vitals recorded with the
        // note, the note text itself, and the medicines/labs/symptoms that
        // were added alongside it - i.e. everything that used to be spread
        // across 4 separate widgets at the top of the page, now scoped to
        // the specific note you clicked History on.
        // ============================================================
        // MAR (Medication Administration Record)
        // ============================================================
        function showMAR() {
            $('#marDate').val(new Date().toISOString().split('T')[0]);
            $('#marModal').modal('show');
            loadMAR();
        }

        function loadMAR() {
            $('#marBody').html('<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
            let date = $('#marDate').val();
            $.getJSON('/DailyNotes/GetMAR', { ipId: @Model.IpId, date: date }, function(r) {
                if (!r.success || !r.data || r.data.length === 0) {
                    $('#marBody').html('<p class="text-muted text-center py-3">No active medicines scheduled for this date.</p>');
                    return;
                }
                let html = '<table class="table table-sm align-middle"><thead><tr><th>Medicine</th><th>Dosage</th><th>Slot</th><th>Status</th><th>Given At</th><th>By</th><th>Action</th></tr></thead><tbody>';
                $.each(r.data, function(i, m) {
                    let badge = m.status === 'Given' ? 'bg-success' : m.status === 'Missed' ? 'bg-danger' : m.status === 'Refused' ? 'bg-warning text-dark' : 'bg-secondary';
                    let actions = m.status === 'Pending'
                        ? `<button class="btn btn-sm btn-success" onclick="recordAdministration(${m.marId},'Given')"><i class="fas fa-check"></i></button>
                           <button class="btn btn-sm btn-danger" onclick="recordAdministration(${m.marId},'Missed')"><i class="fas fa-times"></i></button>
                           <button class="btn btn-sm btn-warning" onclick="recordAdministration(${m.marId},'Refused')"><i class="fas fa-hand-paper"></i></button>`
                        : '<span class="text-muted small">Recorded</span>';
                    html += `<tr>
                        <td><strong>${escapeHtml(m.medicineName)}</strong></td>
                        <td>${escapeHtml(m.dosage || '')}</td>
                        <td>${escapeHtml(m.scheduledSlot)}</td>
                        <td><span class="badge ${badge}">${escapeHtml(m.status)}</span></td>
                        <td>${m.givenAt ? new Date(m.givenAt).toLocaleTimeString() : '-'}</td>
                        <td>${escapeHtml(m.givenByName || '-')}</td>
                        <td>${actions}</td>
                    </tr>`;
                });
                $('#marBody').html(html + '</tbody></table>');
            });
        }

        function recordAdministration(marId, status) {
            let nurseId = $('#ddlMarNurse').val();
            if (!nurseId) { showToast('Error', 'Please select the recording nurse.', 'warning'); return; }

            $.ajax({
                url: '/DailyNotes/RecordAdministration',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ marId: marId, status: status, givenBy: parseInt(nurseId) }),
                success: function(r) {
                    if (r.success) { showToast('Success', status + ' recorded.', 'success'); loadMAR(); }
                    else showToast('Error', r.message, 'danger');
                },
                error: function() { showToast('Error', 'An error occurred.', 'danger'); }
            });
        }

        // ============================================================
        // CURRENT MEDICATIONS (aggregate across the whole admission)
        // ============================================================
        function showCurrentMedications() {
            $('#currentMedsList').html('<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');
            $('#currentMedsModal').modal('show');
            $.getJSON('/DailyNotes/GetCurrentMedications', { ipId: @Model.IpId }, function(r) {
                if (!r.success || !r.data || r.data.length === 0) {
                    $('#currentMedsList').html('<p class="text-muted text-center py-3">No active medications for this patient.</p>');
                    return;
                }
                let html = '<table class="table table-sm"><thead><tr><th>Medicine</th><th>Dosage</th><th>Status</th><th></th></tr></thead><tbody>';
                $.each(r.data, function(i, m) {
                    html += `<tr>
                        <td><strong>${escapeHtml(m.medicineName)}</strong></td>
                        <td>${escapeHtml(m.dosage || '')}</td>
                        <td><span class="badge bg-warning text-dark">${escapeHtml(m.status)}</span></td>
                        <td><button class="btn btn-sm btn-outline-danger" onclick="discontinueMedicine(${m.orderId})"><i class="fas fa-ban"></i> Discontinue</button></td>
                    </tr>`;
                });
                $('#currentMedsList').html(html + '</tbody></table>');
            });
        }

        function discontinueMedicine(prescriptionId) {
            let doctorId = $('#ddlDiscontinueDoctor').val();
            if (!doctorId) { showToast('Error', 'Please select the discontinuing doctor.', 'warning'); return; }
            if (!confirm('Discontinue this medicine?')) return;

            $.ajax({
                url: '/DailyNotes/DiscontinueMedicine',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ prescriptionId: prescriptionId, doctorId: parseInt(doctorId) }),
                success: function(r) {
                    if (r.success) {
                        showToast('Success', 'Medicine discontinued.', 'success');
                        showCurrentMedications();
                    } else showToast('Error', r.message, 'danger');
                },
                error: function() {
                    showToast('Error', 'An error occurred.', 'danger');
                }
            });
        }

        function viewDoctorNoteDetail(noteId) {
            $.getJSON('/DailyNotes/GetNoteDetail', { noteId: noteId }, function(r) {
                if (!r.success) { $('#historyModalBody').html('<div class="text-center py-4"><p>' + escapeHtml(r.message || 'Not found.') + '</p></div>'); return; }

                let n = r.note;
                let vitalsHtml = (n.temperature || n.pulse || n.respRate || n.bpSystolic || n.spO2)
                    ? `<div class="row text-center mb-3">
                        <div class="col"><div class="border rounded p-2"><small class="text-muted">Temp</small><div><strong>${n.temperature ?? '-'}°F</strong></div></div></div>
                        <div class="col"><div class="border rounded p-2"><small class="text-muted">Pulse</small><div><strong>${n.pulse ?? '-'} bpm</strong></div></div></div>
                        <div class="col"><div class="border rounded p-2"><small class="text-muted">Resp</small><div><strong>${n.respRate ?? '-'}</strong></div></div></div>
                        <div class="col"><div class="border rounded p-2"><small class="text-muted">BP</small><div><strong>${n.bpSystolic ?? '-'}/${n.bpDiastolic ?? '-'}</strong></div></div></div>
                        <div class="col"><div class="border rounded p-2"><small class="text-muted">SpO2</small><div><strong>${n.spO2 ?? '-'}%</strong></div></div></div>
                       </div>`
                    : '<p class="text-muted">No vitals recorded with this note.</p>';

                let medsHtml = (!r.medicines || r.medicines.length === 0)
                    ? '<p class="text-muted mb-0">No medicines ordered with this note.</p>'
                    : r.medicines.map(m => `<div class="d-flex justify-content-between align-items-center mb-1 p-2 bg-light rounded"><div><strong>${escapeHtml(m.medicineName)}</strong><small class="text-muted d-block">${escapeHtml(m.dosage)} | ${escapeHtml(m.route || '')}</small></div><span class="badge bg-warning text-dark">${escapeHtml(m.status)}</span></div>`).join('');

                let labsHtml = (!r.labs || r.labs.length === 0)
                    ? '<p class="text-muted mb-0">No lab tests ordered with this note.</p>'
                    : r.labs.map(l => {
                        let badge = l.status === 'Completed' ? 'bg-success' : (l.priority === 'STAT' ? 'bg-danger' : 'bg-info');
                        let report = l.resultFilePath ? `<a href="${l.resultFilePath}" target="_blank" class="btn btn-sm btn-outline-info ms-2"><i class="fas fa-file-download"></i> View Report</a>` : '';
                        let abnormalFlag = l.isAbnormal ? '<span class="badge bg-danger ms-1"><i class="fas fa-exclamation-triangle"></i> Abnormal</span>' : '';
                        let rowClass = l.isAbnormal ? 'bg-danger bg-opacity-10 border border-danger' : 'bg-light';
                        return `<div class="mb-1 p-2 ${rowClass} rounded"><div class="d-flex justify-content-between align-items-center"><strong>${escapeHtml(l.testName)}</strong>${abnormalFlag}<span><span class="badge ${badge}">${escapeHtml(l.status)}</span>${report}</span></div>${l.result ? '<div class="small mt-1">' + escapeHtml(l.result) + '</div>' : ''}</div>`;
                      }).join('');

                let symptomsHtml = (!r.symptoms || r.symptoms.length === 0)
                    ? '<p class="text-muted mb-0">No symptoms recorded with this note.</p>'
                    : r.symptoms.map(s => `<span class="badge bg-warning text-dark me-1 mb-1 p-2">${escapeHtml(s.symptomName)}</span>`).join('');

                let html = `
                    <div class="mb-2 text-muted small">${n.noteDate ? new Date(n.noteDate).toLocaleDateString() : ''} ${n.noteTime ? n.noteTime.substring(0,5) : ''} - Dr. ${escapeHtml(n.doctorName || '')}</div>
                    <h6 class="fw-bold">Vitals</h6>
                    ${vitalsHtml}
                    <h6 class="fw-bold">Notes</h6>
                    <p>${escapeHtml(n.notes || '')}</p>
                    <h6 class="fw-bold mt-3"><i class="fas fa-pills text-primary"></i> Medicines</h6>
                    ${medsHtml}
                    <h6 class="fw-bold mt-3"><i class="fas fa-flask text-success"></i> Lab Tests</h6>
                    ${labsHtml}
                    <h6 class="fw-bold mt-3"><i class="fas fa-notes-medical text-warning"></i> Symptoms</h6>
                    ${symptomsHtml}
                    <hr>
                    <a href="#" onclick="viewEditAuditTrail(${noteId}, 'doctor'); return false;" class="small">View edit history for this note &raquo;</a>
                    <div id="editAuditTrailBody" class="mt-2"></div>
                `;
                $('#historyModalBody').html(html);
            });
        }

        // The original edit-audit-trail view (who changed what, when) -
        // still useful, now reachable as a link from the detail view above
        // for doctor notes, and used directly for nurse notes (which don't
        // have rounds/medicines/labs).
        function viewEditAuditTrail(id, type) {
            let target = type === 'doctor' ? '#editAuditTrailBody' : '#historyModalBody';
            $(target).html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i><p>Loading...</p></div>');
            $.getJSON('/DailyNotes/GetNoteHistory', { noteId: id, noteType: type }, function(r) {
                if (r.success && r.data.length > 0) {
                    let html = '';
                    $.each(r.data, function(i, item) {
                        html += `<div class="history-item"><div class="modified-by"><i class="fas fa-user"></i> ${escapeHtml(item.modifiedByName||'Unknown')}</div><div class="modified-at">${new Date(item.modifiedAt).toLocaleString()}</div><div class="change-summary">${escapeHtml(item.changeSummary||'No details')}</div><hr></div>`;
                    });
                    $(target).html(html);
                } else $(target).html('<div class="text-center py-4"><p>No edit history found.</p></div>');
            });
        }

        // ============================================================
        // HANDOVER REPORT
        // ============================================================
        function renderHandoverReport(data) {
            let html = `
                <div class="print-header" style="text-align:center;margin-bottom:20px;"><h3>SHIFT HANDOVER REPORT</h3><p>${new Date().toLocaleDateString()} ${new Date().toLocaleTimeString()}</p><hr></div>
                <div class="card mb-3"><div class="card-header bg-danger text-white"><strong>S - SITUATION</strong></div><div class="card-body">
                    <table class="table table-sm"><tr><td><strong>Patient:</strong></td><td>${escapeHtml(data.patientName)}</td></tr><tr><td><strong>IPD:</strong></td><td>${escapeHtml(data.admissionNumber)}</td></tr><tr><td><strong>Diagnosis:</strong></td><td>${escapeHtml(data.diagnosis)}</td></tr><tr><td><strong>Doctor:</strong></td><td>${escapeHtml(data.primaryDoctor)}</td></tr></table>
                </div></div>
                <div class="card mb-3"><div class="card-header bg-info text-white"><strong>B - BACKGROUND</strong></div><div class="card-body">
                    ${data.latestVitals ? `<div class="row">${['Temperature','Pulse','BP','SpO₂'].map((label,i) => `<div class="col-md-3 text-center"><div class="border rounded p-2"><small>${label}</small><h5>${[data.latestVitals.temperature||'-',data.latestVitals.pulse||'-',data.latestVitals.bp||'-',data.latestVitals.spo2||'-'][i]}${['°C',' bpm',' mmHg','%'][i]}</h5></div></div>`).join('')}</div>` : '<p>No vitals</p>'}
                </div></div>
                <div class="card mb-3"><div class="card-header bg-warning text-dark"><strong>A - ASSESSMENT</strong></div><div class="card-body">
                    <h6>Doctor Notes (${data.recentDoctorNotes.length})</h6>${data.recentDoctorNotes.length>0?data.recentDoctorNotes.map(n=>`<div class="p-2 bg-light rounded mb-1"><small>${escapeHtml(n.time)} - Dr.${escapeHtml(n.doctor)}</small><p class="mb-0">${escapeHtml(n.notes)}</p></div>`).join(''):'<p>None</p>'}
                    <hr><h6>Nurse Notes (${data.recentNurseNotes.length})</h6>${data.recentNurseNotes.length>0?data.recentNurseNotes.map(n=>`<div class="p-2 bg-light rounded mb-1"><small>${escapeHtml(n.time)} - Nurse ${escapeHtml(n.nurse)}</small><p class="mb-0">${escapeHtml(n.notes)}</p></div>`).join(''):'<p>None</p>'}
                </div></div>
                <div class="card mb-3"><div class="card-header bg-success text-white"><strong>R - RECOMMENDATION</strong></div><div class="card-body"><p>No pending orders.</p></div></div>
                <div class="card no-print"><div class="card-header"><strong>Sign-Off</strong></div><div class="card-body"><div class="row"><div class="col-md-6"><p><strong>Handover By:</strong> _________________</p><p><strong>Signature:</strong> _________________</p></div><div class="col-md-6"><p><strong>Received By:</strong> _________________</p><p><strong>Signature:</strong> _________________</p></div></div></div></div>`;
            $('#handoverBody').html(html);
        }

        // ============================================================
        // REFRESH
        // ============================================================
        function refreshNotes() { if (currentTab === 'doctor') refreshDoctorNotes(); else refreshNurseNotes(); }

        function refreshDoctorNotes() {
            showLoading();
            $.getJSON('/DailyNotes/GetDoctorNotesList', { ipId: @Model.IpId }, function(r) {
                hideLoading();
                if (r.success) renderDoctorNotes(r.data);
                else showToast('Error', r.message, 'danger');
            });
        }

        function refreshNurseNotes() {
            showLoading();
            $.getJSON('/DailyNotes/GetNurseNotesList', { ipId: @Model.IpId }, function(r) {
                hideLoading();
                if (r.success) renderNurseNotes(r.data);
                else showToast('Error', r.message, 'danger');
            });
        }

        function renderDoctorNotes(notes) {
            if (!notes || notes.length === 0) { $('#doctorNotesList').html('<div class="no-notes"><i class="fas fa-notes-medical"></i><h5>No Doctor Notes</h5></div>'); return; }
            let html = '';
            $.each(notes, function(i, n) {
                let v = '';
                if (n.temperature) v += `<span class="badge bg-info">Temp: ${n.temperature}°F</span>`;
                if (n.pulse) v += `<span class="badge bg-danger">Pulse: ${n.pulse} bpm</span>`;
                if (n.bpSystolic && n.bpDiastolic) v += `<span class="badge bg-success">BP: ${n.bpSystolic}/${n.bpDiastolic}</span>`;
                if (n.spO2) v += `<span class="badge bg-primary">SpO₂: ${n.spO2}%</span>`;
                html += `<div class="note-card"><div class="header"><span class="author"><i class="fas fa-user-md"></i> ${escapeHtml(n.doctorName||'Doctor')}</span><span class="datetime">${new Date(n.noteDate).toLocaleDateString()}</span></div>${v?'<div class="vitals">'+v+'</div>':''}<div class="notes-text">${escapeHtml(n.notes||'')}</div><div class="actions"><button class="btn btn-sm btn-outline-info" onclick="viewHistory(${n.noteId},'doctor')"><i class="fas fa-history"></i></button><button class="btn btn-sm btn-outline-primary" onclick="editDoctorNote(${n.noteId})"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger" onclick="deleteDoctorNote(${n.noteId})"><i class="fas fa-trash-alt"></i></button></div></div>`;
            });
            $('#doctorNotesList').html(html);
        }

        function renderNurseNotes(notes) {
            if (!notes || notes.length === 0) { $('#nurseNotesList').html('<div class="no-notes"><i class="fas fa-notes-medical"></i><h5>No Nurse Notes</h5></div>'); return; }
            let html = '';
            $.each(notes, function(i, n) {
                html += `<div class="note-card"><div class="header"><span class="author"><i class="fas fa-user-nurse"></i> ${escapeHtml(n.nurseName||'Nurse')}</span><span class="datetime">${new Date(n.noteDate).toLocaleDateString()}</span></div><div class="notes-text">${escapeHtml(n.notes||'')}</div><div class="actions"><button class="btn btn-sm btn-outline-info" onclick="viewHistory(${n.noteId},'nurse')"><i class="fas fa-history"></i></button><button class="btn btn-sm btn-outline-primary" onclick="editNurseNote(${n.noteId})"><i class="fas fa-edit"></i></button><button class="btn btn-sm btn-outline-danger" onclick="deleteNurseNote(${n.noteId})"><i class="fas fa-trash-alt"></i></button></div></div>`;
            });
            $('#nurseNotesList').html(html);
        }

        // ============================================================
        // UTILITIES
        // ============================================================
        function showLoading() { $('#loadingOverlay').addClass('active'); }
        function hideLoading() { $('#loadingOverlay').removeClass('active'); }

        function showToast(title, message, type) {
            let bg = type === 'success' ? '#28a745' : type === 'danger' ? '#dc3545' : type === 'warning' ? '#ffc107' : '#17a2b8';
            let color = type === 'warning' ? '#000' : '#fff';
            $('#toastTitle').text(title);
            $('#toastMessage').text(message);
            $('#toastNotification').css('background-color', bg).css('color', color);
            new bootstrap.Toast($('#toastNotification')[0], { delay: 3000 }).show();
        }

        function escapeHtml(text) { if (!text) return ''; const d = document.createElement('div'); d.textContent = text; return d.innerHTML; }

        function resetDoctorForm() {
            $('#doctorNoteId').val(0);
            $('#ddlDoctor').val('');
            $('#doctorTemperature,#doctorPulse,#doctorRespRate,#doctorBpSystolic,#doctorBpDiastolic,#doctorSpO2,#doctorNotes').val('');
            $('#doctorNoteDate').val(new Date().toISOString().split('T')[0]);
            $('#doctorNoteTime').val(new Date().toTimeString().substring(0,5));
            $('#doctorTemplateSelect').val('');
            $('#doctorSaveTemplate').prop('checked', false);
            $('#doctorTemplateNameDiv').hide();
            $('#doctorTemplateName').val('');
            selectedMedicines = []; selectedLabs = []; selectedSymptoms = [];
            renderSelectedMedicines(); renderSelectedLabs(); renderSelectedSymptoms();
        }

        function resetNurseForm() {
            $('#nurseNoteId').val(0);
            $('#ddlNurse').val('');
            $('#nurseNotes').val('');
            $('#nurseNoteDate').val(new Date().toISOString().split('T')[0]);
            $('#nurseNoteTime').val(new Date().toTimeString().substring(0,5));
            $('#nurseTemplateSelect').val('');
            $('#nurseSaveTemplate').prop('checked', false);
            $('#nurseTemplateNameDiv').hide();
            $('#nurseTemplateName').val('');
        }
    </script>
}
