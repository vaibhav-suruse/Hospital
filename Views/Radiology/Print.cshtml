@* Views/Radiology/Print.cshtml *@
@model WebApplicationSampleTest2.Models.RadiologyReportsVM
@{
    Layout = null;
    var hospital = ViewBag.Hospital as WebApplicationSampleTest2.Models.Hospital;
    bool singleReport = Model.Reports.Count == 1;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Radiology Report - @Model.Admission.PatientName</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
            color: #000;
            margin: 24px;
        }

        h2, h4 {
            margin: 4px 0;
        }

        .letterhead {
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 3px solid #000;
            padding-bottom: 10px;
            margin-bottom: 8px;
        }

            .letterhead img {
                height: 60px;
                width: auto;
            }

            .letterhead .hosp-name {
                font-size: 20px;
                font-weight: bold;
            }

            .letterhead .hosp-meta {
                font-size: 12px;
                color: #333;
            }

        .header {
            text-align: center;
            padding-bottom: 8px;
            margin-bottom: 12px;
            border-bottom: 1px solid #999;
        }

        .patient-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .report-block {
            border: 2px solid #333;
            padding: 10px;
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .report-heading {
            background: #333;
            color: #fff;
            padding: 6px 10px;
            font-size: 15px;
            font-weight: bold;
            margin: -10px -10px 10px -10px;
            display: flex;
            justify-content: space-between;
        }

        .report-meta {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 12px;
            color: #333;
        }

        .report-notes {
            white-space: pre-wrap;
            margin-top: 6px;
        }

        .signature-row {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
        }

        .signature-box {
            width: 45%;
            border-top: 1px solid #000;
            text-align: center;
            padding-top: 4px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="no-print" style="text-align:right; margin-bottom:10px;">
        <button onclick="window.print()">Print</button>
    </div>

    @if (hospital != null)
    {
        <div class="letterhead">
            @if (!string.IsNullOrWhiteSpace(hospital.Logo))
            {
                <img src="@hospital.Logo" alt="Logo" />
            }
            <div>
                <div class="hosp-name">@hospital.Name</div>
                <div class="hosp-meta">
                    @hospital.Address
                    @(!string.IsNullOrWhiteSpace(hospital.PhoneNumber) ? " • Ph: " + hospital.PhoneNumber : "")
                    @(!string.IsNullOrWhiteSpace(hospital.RegistrationNumber) ? " • Reg No: " + hospital.RegistrationNumber : "")
                </div>
            </div>
        </div>
    }

    <div class="header">
        <h2>Radiology Report</h2>
        <div>@(singleReport? Model.Reports[0].Title : "Full Report History")</div>
    </div>

    <div class="patient-info">
        <div>
            <strong>Patient:</strong> @Model.Admission.PatientName<br />
            <strong>Admission #:</strong> @Model.Admission.AdmissionNumber<br />
        </div>
        <div>
            <strong>Admitted:</strong> @Model.Admission.AdmissionDateTime.ToString("dd MMM yyyy hh:mm tt")<br />
            <strong>Attending Doctor:</strong> @Model.Admission.DoctorName<br />
        </div>
        <div>
            <strong>Printed:</strong> @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
        </div>
    </div>

    @if (Model.Reports.Count == 0)
    {
        <p>No radiology report found.</p>
    }
    else
    {
        foreach (var r in Model.Reports)
        {
            <div class="report-block">
                <div class="report-heading">
                    <span>@r.Title</span>
                    <span>@r.ReportDateTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
                <div class="report-meta">
                    <span><strong>Radiologist:</strong> @(r.RadiologistName ?? "-")</span>
                    <span><strong>Entered By:</strong> @(r.EnteredByName ?? "-")</span>
                </div>
                <div class="report-notes">@r.Notes</div>
            </div>
        }
    }

    <div class="signature-row">
        <div class="signature-box">Radiologist's Signature</div>
        <div class="signature-box">Doctor's Signature</div>
    </div>
</body>
</html>
