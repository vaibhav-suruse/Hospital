@* Views/LabReports/Print.cshtml *@
@model WebApplicationSampleTest2.Models.LabReportsVM
@{
    Layout = null;
    var valuesByDay = (Dictionary<int, List<WebApplicationSampleTest2.Models.LabReportValueVM>>)ViewBag.ValuesByDay;
    int? singleDay = ViewBag.SingleDay as int?;
    var hospital = ViewBag.Hospital as WebApplicationSampleTest2.Models.Hospital;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Lab Report - @Model.Admission.PatientName</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
            color: #000;
            margin: 24px;
        }

        h2, h4 {
            margin: 4px 0;
        }

        .letterhead {
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 3px solid #000;
            padding-bottom: 10px;
            margin-bottom: 8px;
        }

            .letterhead img {
                height: 60px;
                width: auto;
            }

            .letterhead .hosp-name {
                font-size: 20px;
                font-weight: bold;
            }

            .letterhead .hosp-meta {
                font-size: 12px;
                color: #333;
            }

        .header {
            text-align: center;
            padding-bottom: 8px;
            margin-bottom: 12px;
            border-bottom: 1px solid #999;
        }

        .patient-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
        }

        th, td {
            border: 1px solid #666;
            padding: 4px 6px;
            font-size: 12px;
            text-align: left;
        }

        th {
            background: #eee;
        }

        .day-block {
            border: 2px solid #333;
            padding: 10px;
            margin-bottom: 24px;
            page-break-inside: avoid;
        }

        .day-heading {
            background: #333;
            color: #fff;
            padding: 6px 10px;
            font-size: 16px;
            font-weight: bold;
            margin: -10px -10px 10px -10px;
        }

        .abnormal {
            color: #c00;
            font-weight: bold;
        }

        .signature-row {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
        }

        .signature-box {
            width: 45%;
            border-top: 1px solid #000;
            text-align: center;
            padding-top: 4px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="no-print" style="text-align:right; margin-bottom:10px;">
        <button onclick="window.print()">Print</button>
    </div>

    @if (hospital != null)
    {
        <div class="letterhead">
            @if (!string.IsNullOrWhiteSpace(hospital.Logo))
            {
                <img src="@hospital.Logo" alt="Logo" />
            }
            <div>
                <div class="hosp-name">@hospital.Name</div>
                <div class="hosp-meta">
                    @hospital.Address
                    @(!string.IsNullOrWhiteSpace(hospital.PhoneNumber) ? " • Ph: " + hospital.PhoneNumber : "")
                    @(!string.IsNullOrWhiteSpace(hospital.RegistrationNumber) ? " • Reg No: " + hospital.RegistrationNumber : "")
                </div>
            </div>
        </div>
    }

    <div class="header">
        <h2>Inpatient Lab Report</h2>
        <div>@(singleDay.HasValue ? "Day " + singleDay.Value : "Full Stay Summary - Day by Day")</div>
    </div>

    <div class="patient-info">
        <div>
            <strong>Patient:</strong> @Model.Admission.PatientName<br />
            <strong>Admission #:</strong> @Model.Admission.AdmissionNumber<br />
        </div>
        <div>
            <strong>Admitted:</strong> @Model.Admission.AdmissionDateTime.ToString("dd MMM yyyy hh:mm tt")<br />
            <strong>Attending Doctor:</strong> @Model.Admission.DoctorName<br />
        </div>
        <div>
            <strong>Printed:</strong> @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
        </div>
    </div>

    @foreach (var day in valuesByDay.Keys.OrderBy(d => d))
    {
        var dayDate = Model.Admission.AdmissionDateTime.Date.AddDays(day - 1);
        var dayValues = valuesByDay[day];

        <div class="day-block">
            <div class="day-heading">Day @day &ndash; @dayDate.ToString("dd MMM yyyy")</div>
            <table>
                <thead><tr><th>Category</th><th>Parameter</th><th>Value</th><th>Unit</th><th>Normal Range</th><th>Status</th><th>Entered By</th></tr></thead>
                <tbody>
                    @if (dayValues.Count == 0)
                    {
                        <tr><td colspan="7">No lab values logged on this day</td></tr>
                    }
                    else
                    {
                        foreach (var v in dayValues)
                        {
                            bool flagAbnormal = v.AbnormalFlag == "High" || v.AbnormalFlag == "Low" || v.AbnormalFlag == "Abnormal";
                            <tr>
                                <td>@v.CategoryName</td>
                                <td>@v.ParameterName</td>
                                <td class="@(flagAbnormal ? "abnormal" : "")">@v.ResultValue</td>
                                <td>@v.Unit</td>
                                <td>@v.RangeDisplay</td>
                                <td class="@(flagAbnormal ? "abnormal" : "")">@(v.AbnormalFlag ?? "-")</td>
                                <td>@v.EnteredByName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="signature-row">
        <div class="signature-box">Pathologist / Lab In-Charge Signature</div>
        <div class="signature-box">Doctor's Signature</div>
    </div>
</body>
</html>
