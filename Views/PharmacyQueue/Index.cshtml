﻿@{
    ViewData["Title"] = "OPD Medicine Queue";
}

<!-- ═══════════════════ HERO ═══════════════════ -->
<div class="pharm-hero d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <div class="pharm-hero-icon"><i class="bx bx-user-check"></i></div>
        <div>
            <h4>OPD Medicine Queue</h4>
            <p>Real-time prescriptions from doctors — dispense &amp; bill instantly</p>
        </div>
    </div>
    <div class="live-pill"><span class="live-dot"></span><span>Live — refreshes every 8s</span></div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card pharm-card">
            <div class="pharm-card-body">

                <!-- Stats row -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card pharm-stat mb-0">
                            <div class="pharm-stat-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="pharm-stat-label">Total</div>
                                    <div class="pharm-stat-value" id="statTotal">0</div>
                                </div>
                                <div class="pharm-stat-icon pg-dark"><i class="bx bxs-collection"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card pharm-stat mb-0">
                            <div class="pharm-stat-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="pharm-stat-label">Pending</div>
                                    <div class="pharm-stat-value text-warning" id="statPending">0</div>
                                </div>
                                <div class="pharm-stat-icon pg-warning"><i class="bx bxs-hourglass"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card pharm-stat mb-0">
                            <div class="pharm-stat-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="pharm-stat-label">Dispensed</div>
                                    <div class="pharm-stat-value" style="color:var(--pharm-success)" id="statDispensed">0</div>
                                </div>
                                <div class="pharm-stat-icon pg-success"><i class="bx bxs-check-shield"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card pharm-stat mb-0">
                            <div class="pharm-stat-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="pharm-stat-label">Billed</div>
                                    <div class="pharm-stat-value" style="color:var(--pharm-info)" id="statBilled">0</div>
                                </div>
                                <div class="pharm-stat-icon pg-info"><i class="bx bxs-receipt"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabs -->
                <ul class="nav pharm-tabs mb-3" id="pharmaTabs">
                    <li class="nav-item"><button class="nav-link active" id="tabAll" onclick="setTab('all')">All</button></li>
                    <li class="nav-item"><button class="nav-link" id="tabPending" onclick="setTab('Pending')">Pending</button></li>
                    <li class="nav-item"><button class="nav-link" id="tabDispensed" onclick="setTab('Dispensed')">Dispensed</button></li>
                    <li class="nav-item"><button class="nav-link" id="tabBilled" onclick="setTab('Billed')">Billed</button></li>
                </ul>

                <!-- Queue Table -->
                <div class="table-responsive">
                    <table class="table pharm-table align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th class="text-center">Medicines</th>
                                <th>Summary</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="queueBody">
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <span class="spinner-border spinner-border-sm me-2"></span>Loading prescriptions...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ PRESCRIPTION DETAIL MODAL ═══════════════ -->
<div class="modal fade pharm-modal" id="prescModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header primary">
                <h5 class="modal-title">
                    <i class="fas fa-prescription-bottle me-2"></i>
                    Prescription — <span id="modalPatientName"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Patient info strip -->
            <div class="px-4 py-3 bg-light border-bottom">
                <div class="row">
                    <div class="col-md-6">
                        <small class="text-muted">Doctor</small>
                        <div class="fw-bold" id="modalDoctorName"></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Prescribed at</small>
                        <div class="fw-bold" id="modalCreatedAt"></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Status</small>
                        <div id="modalStatusBadge"></div>
                    </div>
                </div>
            </div>

            <div class="modal-body" id="prescModalBody">
                <div class="text-center py-4 text-muted">
                    <span class="spinner-border spinner-border-sm me-2"></span>Loading...
                </div>
            </div>

            <div class="modal-footer" id="prescModalFooter" style="display:none;">
                <button class="btn btn-grad-success" id="btnDispense">
                    <i class="fas fa-check me-1"></i> Mark All Dispensed
                </button>
                <a href="#" class="btn btn-grad-primary" id="btnGenerateBill">
                    <i class="fas fa-file-invoice-dollar me-1"></i> Generate Medicine Bill
                </a>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var allItems       = [];
        var currentTab     = 'all';
        var selectedNotifId = null;

        // ── LOAD QUEUE ────────────────────────────────────────────
        function loadQueue() {
            $.ajax({
                url:  '/PharmacyQueue/GetQueueData',
                type: 'GET',
                success: function(data) {
                    allItems = Array.isArray(data) ? data : [];
                    renderTable();
                    updateStats();
                },
                error: function() {
                    document.getElementById('queueBody').innerHTML =
                        '<tr><td colspan="8" class="text-center text-danger py-3">Failed to load. Please refresh.</td></tr>';
                }
            });
        }

        // ── RENDER TABLE ──────────────────────────────────────────
        function renderTable() {
            var tbody    = document.getElementById('queueBody');
            var filtered = currentTab === 'all'
                ? allItems
                : allItems.filter(function(x) {
                    return (x.status || '').toLowerCase() === currentTab.toLowerCase();
                });

            if (!filtered.length) {
                tbody.innerHTML =
                    '<tr><td colspan="8" class="text-center text-muted py-5">No prescriptions in this category</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map(function(item, idx) {
                return buildRow(item, idx + 1);
            }).join('');
        }

        function buildRow(item, idx) {
            var status = item.status || 'Pending';

            var badge = '';
            if      (status === 'Pending')   badge = '<span class="pharm-badge badge-soft-warning"><i class="bx bxs-hourglass me-1"></i>Pending</span>';
            else if (status === 'Dispensed') badge = '<span class="pharm-badge badge-soft-success"><i class="bx bxs-check-circle me-1"></i>Dispensed</span>';
            else if (status === 'Billed')    badge = '<span class="pharm-badge badge-soft-primary"><i class="bx bxs-receipt me-1"></i>Billed</span>';
            else if (status === 'Cancelled') badge = '<span class="pharm-badge badge-soft-danger"><i class="bx bx-x-circle me-1"></i>Cancelled</span>';
            else                             badge = '<span class="pharm-badge badge-soft-dark">' + esc(status) + '</span>';

            var medCount = item.medicineCount > 0
                ? '<span class="pharm-badge badge-soft-info">' + item.medicineCount + ' med' +
                  (item.medicineCount > 1 ? 's' : '') + '</span>'
                : '<span class="text-muted">—</span>';

            var summary = item.medicinesSummary
                ? '<small class="text-muted">' + esc(item.medicinesSummary) + '</small>'
                : '<small class="text-muted">—</small>';

            // Patient avatar initial
            var initial = (item.patientName || '?').trim().charAt(0).toUpperCase();
            var patientHtml =
                '<div class="d-flex align-items-center gap-2">' +
                '<span class="pharm-avatar pg-primary">' + initial + '</span>' +
                '<strong>' + esc(item.patientName) + '</strong>' +
                '</div>';

            var actionBtns =
                '<button class="btn btn-sm btn-outline-primary" onclick="openPrescription(' + item.notificationId + ')">' +
                '<i class="fas fa-eye"></i></button>';

            if (status === 'Dispensed') {
                actionBtns +=
                    ' <a href="/PharmacyQueue/MedicineBill?notificationId=' + item.notificationId + '"' +
                    ' class="btn btn-sm btn-grad-primary">' +
                    '<i class="fas fa-file-invoice-dollar"></i></a>';
            }

            return '<tr>' +
                '<td><span class="text-muted">' + idx + '</span></td>' +
                '<td>' + patientHtml + '</td>' +
                '<td>Dr. ' + esc(item.doctorName || '—') + '</td>' +
                '<td class="text-center">' + medCount + '</td>' +
                '<td><small class="text-truncate-2">' + summary + '</small></td>' +
                '<td><small class="text-muted">' + esc(item.timeAgo || item.createdAt) + '</small></td>' +
                '<td>' + badge + '</td>' +
                '<td class="text-center">' + actionBtns + '</td>' +
            '</tr>';
        }

        // ── STATS ─────────────────────────────────────────────────
        function updateStats() {
            document.getElementById('statTotal').textContent     = allItems.length;
            document.getElementById('statPending').textContent   = allItems.filter(function(x){ return x.status === 'Pending';   }).length;
            document.getElementById('statDispensed').textContent = allItems.filter(function(x){ return x.status === 'Dispensed'; }).length;
            document.getElementById('statBilled').textContent    = allItems.filter(function(x){ return x.status === 'Billed';    }).length;
        }

        // ── TAB SWITCH ────────────────────────────────────────────
        window.setTab = function(tab) {
            currentTab = tab;
            document.querySelectorAll('#pharmaTabs .nav-link').forEach(function(b) {
                b.classList.remove('active');
            });
            var map = {
                'all':       'tabAll',
                'Pending':   'tabPending',
                'Dispensed': 'tabDispensed',
                'Billed':    'tabBilled'
            };
            if (map[tab]) document.getElementById(map[tab]).classList.add('active');
            renderTable();
        };

        // ── OPEN PRESCRIPTION MODAL ───────────────────────────────
        window.openPrescription = function(notificationId) {
            selectedNotifId = notificationId;

            document.getElementById('prescModalBody').innerHTML =
                '<div class="text-center py-4 text-muted">' +
                '<span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>';
            document.getElementById('prescModalFooter').style.display = 'none';
            document.getElementById('modalPatientName').textContent = '';
            document.getElementById('modalDoctorName').textContent  = '';
            document.getElementById('modalCreatedAt').textContent   = '';
            document.getElementById('modalStatusBadge').innerHTML   = '';

            new bootstrap.Modal(document.getElementById('prescModal')).show();

            $.ajax({
                url:  '/PharmacyQueue/GetPrescription',
                type: 'GET',
                data: { notificationId: notificationId },
                success: function(d) {
                    if (!d.success) {
                        document.getElementById('prescModalBody').innerHTML =
                            '<div class="pharm-alert danger"><i class="fas fa-exclamation-circle alert-icon"></i><div>' + esc(d.message) + '</div></div>';
                        return;
                    }
                    renderPrescModal(d);
                },
                error: function() {
                    document.getElementById('prescModalBody').innerHTML =
                        '<div class="pharm-alert danger"><i class="fas fa-exclamation-circle alert-icon"></i><div>Could not load prescription.</div></div>';
                }
            });
        };

        function renderPrescModal(d) {
            document.getElementById('modalPatientName').textContent = d.patientName;
            document.getElementById('modalDoctorName').textContent  = 'Dr. ' + (d.doctorName || '—');
            document.getElementById('modalCreatedAt').textContent   = d.createdAt;

            var statusHtml = '';
            if (d.status === 'Pending')   statusHtml = '<span class="pharm-badge badge-soft-warning"><i class="bx bxs-hourglass me-1"></i>Pending</span>';
            else if (d.status === 'Dispensed') statusHtml = '<span class="pharm-badge badge-soft-success"><i class="bx bxs-check-circle me-1"></i>Dispensed</span>';
            else if (d.status === 'Billed') statusHtml = '<span class="pharm-badge badge-soft-primary"><i class="bx bxs-receipt me-1"></i>Billed</span>';
            document.getElementById('modalStatusBadge').innerHTML = statusHtml;

            var medsHtml = '';
            if (d.medicines && d.medicines.length > 0) {
                medsHtml =
                    '<div class="table-responsive">' +
                    '<table class="table pharm-table table-bordered-table table-sm mb-0">' +
                    '<thead>' +
                    '<tr>' +
                    '<th>#</th><th>Medicine</th><th>Type</th>' +
                    '<th class="text-center">Morning</th><th class="text-center">Afternoon</th><th class="text-center">Evening</th>' +
                    '<th class="text-center">Days</th><th class="text-center">Qty</th><th class="text-center">Stock</th>' +
                    '<th class="text-end">Rate</th><th class="text-end">Total</th>' +
                    '</tr>' +
                    '</thead><tbody>';

                var hasStockWarning = false;

                d.medicines.forEach(function(m, i) {
                    var tick  = '<i class="fas fa-check-circle text-success"></i>';
                    var cross = '<span class="text-muted">—</span>';

                    var stockBadge = '';
                    var rowClass   = '';
                    if (m.stockStatus === 'outofstock') {
                        stockBadge = '<span class="pharm-badge badge-soft-danger">Out of Stock</span>';
                        rowClass   = 'table-danger';
                        hasStockWarning = true;
                    } else if (m.stockStatus === 'partial') {
                        stockBadge = '<span class="pharm-badge badge-soft-warning">Only ' + m.availableStock + ' / ' + m.totalQty + '</span>';
                        rowClass   = 'table-warning';
                        hasStockWarning = true;
                    } else {
                        stockBadge = '<span class="pharm-badge badge-soft-success">' + m.availableStock + ' in stock</span>';
                    }

                    medsHtml +=
                        '<tr class="' + rowClass + '">' +
                        '<td>' + (i + 1) + '</td>' +
                        '<td><strong>' + esc(m.medicineName) + '</strong></td>' +
                        '<td><span class="pharm-badge badge-soft-dark">' + esc(m.medicineType || 'Tablet') + '</span></td>' +
                        '<td class="text-center">' + (m.morning ? tick : cross) + '</td>' +
                        '<td class="text-center">' + (m.afternoon ? tick : cross) + '</td>' +
                        '<td class="text-center">' + (m.evening   ? tick : cross) + '</td>' +
                        '<td class="text-center">' + m.days + ' days</td>' +
                        '<td class="text-center"><strong>' + m.totalQty + '</strong></td>' +
                        '<td class="text-center">' + stockBadge + '</td>' +
                        '<td class="text-end">₹' + m.sellingPrice.toFixed(2) + '</td>' +
                        '<td class="text-end"><strong>₹' + m.lineTotal.toFixed(2) + '</strong></td>' +
                        '</tr>';
                });

                var grandTotal = d.medicines.reduce(function(s, m) { return s + m.lineTotal; }, 0);
                medsHtml +=
                    '<tr class="tfoot-total">' +
                    '<td colspan="10" class="text-end">Estimated Total</td>' +
                    '<td class="text-end">₹' + grandTotal.toFixed(2) + '</td>' +
                    '</tr></tbody></table></div>';

                if (hasStockWarning) {
                    medsHtml = '<div class="pharm-alert warn d-flex align-items-center mb-3"><i class="fas fa-exclamation-triangle alert-icon"></i>' +
                        '<div><strong>Stock Alert:</strong> Some medicines have insufficient stock. Dispense what is available and inform the patient about pending medicines.</div>' +
                        '</div>' + medsHtml;
                }
            } else {
                medsHtml = '<div class="pharm-alert info"><i class="fas fa-info-circle alert-icon"></i><div>No medicines found for this prescription.</div></div>';
            }

            document.getElementById('prescModalBody').innerHTML = medsHtml;

            var footer      = document.getElementById('prescModalFooter');
            footer.style.display = '';
            var dispenseBtn = document.getElementById('btnDispense');
            var billBtn     = document.getElementById('btnGenerateBill');

            if (d.status === 'Pending') {
                dispenseBtn.style.display = '';
                billBtn.style.display     = 'none';
                dispenseBtn.onclick = function() { markDispensed(d.notificationId); };
            } else if (d.status === 'Dispensed') {
                dispenseBtn.style.display = 'none';
                billBtn.style.display     = '';
                billBtn.href = '/PharmacyQueue/MedicineBill?notificationId=' + d.notificationId;
            } else {
                dispenseBtn.style.display = 'none';
                billBtn.style.display     = 'none';
            }
        }

        // ── MARK DISPENSED ────────────────────────────────────────
        function markDispensed(notificationId) {
            if (!confirm('Mark all medicines as dispensed for this patient?')) return;
            var btn = document.getElementById('btnDispense');
            btn.disabled    = true;
            btn.textContent = 'Saving...';

            $.ajax({
                url:  '/PharmacyQueue/MarkDispensed',
                type: 'POST',
                data: { notificationId: notificationId,
                        __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val() },
                success: function(res) {
                    if (res.success) {
                        loadQueue();
                        bootstrap.Modal.getInstance(document.getElementById('prescModal')).hide();
                        if (typeof toastr !== 'undefined') toastr.success('Medicines marked as dispensed!');
                    } else {
                        btn.disabled  = false;
                        btn.innerHTML = '<i class="fas fa-check me-1"></i> Mark All Dispensed';
                        alert(res.message || 'Could not dispense.');
                    }
                },
                error: function() {
                    btn.disabled  = false;
                    btn.innerHTML = '<i class="fas fa-check me-1"></i> Mark All Dispensed';
                    alert('Server error. Please try again.');
                }
            });
        }

        function esc(s) {
            return (s || '').toString()
                .replace(/&/g,'&amp;').replace(/</g,'<').replace(/>/g,'>');
        }

        $(document).ready(function() {
            loadQueue();
            setInterval(loadQueue, 8000);
        });
    </script>

    @Html.AntiForgeryToken()
}

