                            <div class="d-flex gap-3 mb-2">
                                <div class="form-check"><input class="form-check-input" type="radio" name="FoodInstruction" value="Before Food"><label class="form-check-label">Before Food</label></div>
                                <div class="form-check"><input class="form-check-input" type="radio" name="FoodInstruction" value="After Food"><label class="form-check-label">After Food</label></div>
                                <div class="form-check"><input class="form-check-input" type="radio" name="FoodInstruction" value="None" checked><label class="form-check-label">None</label></div>
                            </div>
                            <label class="form-label">Duration</label>
