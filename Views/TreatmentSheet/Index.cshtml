                            <div class="form-check"><input class="form-check-input duration-radio" type="radio" name="DurationType" value="Add Till Discontinued"><label class="form-check-label">Add Till Discontinued</label></div>
                            <div class="form-check"><input class="form-check-input duration-radio" type="radio" name="DurationType" value="SOS"><label class="form-check-label">S.O.S.</label></div>
                            <label class="form-label mt-3">Qty</label>
