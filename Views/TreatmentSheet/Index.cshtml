@model WebApplicationSampleTest2.Models.TreatmentSheetVM
@{
    ViewData["Title"] = "Treatment Sheet";
    int ipdId = Model.Admission.IPDId;
    ViewBag.IPDId = ipdId;
}

<div class="container-fluid">


    <form id="globalTokenForm">@Html.AntiForgeryToken()</form>

    <div id="pageAlert"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <i class="fas fa-file-medical me-1"></i>
                <strong>Inpatient Treatment Sheet</strong>
                <span class="ms-2 opacity-75">
                    @Model.Admission.PatientName
                    <small>(Adm# @Model.Admission.AdmissionNumber)</small>
                </span>
            </div>
            <div>
                <a asp-controller="TreatmentSheet" asp-action="Print" asp-route-ipdId="@ipdId"
                   target="_blank" class="btn btn-sm btn-light me-1">
                    <i class="fas fa-print me-1"></i> Print Full Sheet
                </a>
                <a asp-controller="InpatientDocument" asp-action="Index" asp-route-ipId="@ipdId" asp-route-patientId="@Model.Admission.PatientId" class="btn btn-sm btn-light">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>

        <div class="card-body">

            @* ── Allergy safety banner ─────────────────────────────── *@
            @if (Model.Allergies != null && Model.Allergies.Count > 0)
            {
                bool anyCritical = Model.Allergies.Any(a => a.IsCritical);
                <div class="alert @(anyCritical ? "alert-danger" : "alert-warning") d-flex align-items-start gap-2 mb-3">
                    <i class="fas fa-triangle-exclamation mt-1"></i>
                    <div>
                        <strong>Known Allergies:</strong>
                        @string.Join("  •  ", Model.Allergies.Select(a => $"{a.AllergyName} ({a.AllergyType}, {a.Severity})"))
                    </div>
                </div>
            }

            @* ================= DAY TABS - drive every section below ================= *@
            <ul class="nav nav-tabs" id="dayTabs" role="tablist">
                @for (int day = 1; day <= Model.TotalDays; day++)
                {
                    var dayDate = Model.Admission.AdmissionDateTime.Date.AddDays(day - 1);
                    bool isActive = day == Model.ActiveDay;
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isActive ? "active" : "") day-tab-btn" data-day="@day" type="button">
                            Day @day
                            <div class="small @(isActive ? "text-white-50" : "text-muted")">@dayDate.ToString("dd MMM")</div>
                        </button>
                    </li>
                }
            </ul>
            <div class="border border-top-0 rounded-bottom p-3 mb-4">

                @* ================= GENERAL ORDERS ================= *@
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="fas fa-clipboard-list me-1 text-primary"></i> General Order</h6>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addGeneralOrderModal">
                        <i class="fas fa-plus me-1"></i> Add Order
                    </button>
                </div>
                <div id="generalOrdersContainer" class="mb-4">
                    @await Html.PartialAsync("_GeneralOrdersPartial", Model.GeneralOrders)
                </div>

                @* ================= MEDICATIONS ================= *@
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="fas fa-pills me-1 text-success"></i> Medications</h6>
                    <div>
                        <a asp-action="Print" asp-route-ipdId="@ipdId" target="_blank" class="btn btn-sm btn-outline-secondary me-1">
                            <i class="fas fa-print me-1"></i> Print Medicine
                        </a>
                        <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addMedicineModal">
                            <i class="fas fa-plus me-1"></i> Add Medicine
                        </button>
                    </div>
                </div>
                <div id="medicationsContainer" class="mb-4">
                    @await Html.PartialAsync("_MedicationsPartial", Model.Medications)
                </div>

                @* ================= INVESTIGATIONS ================= *@
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="fas fa-flask me-1 text-secondary"></i> Investigations</h6>
                    <button class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#addInvestigationModal">
                        <i class="fas fa-plus me-1"></i> Add Investigation
                    </button>
                </div>
                <div id="investigationsContainer" class="mb-4">
                    @await Html.PartialAsync("_InvestigationsPartial", Model.Investigations)
                </div>

                @* ================= MAR (Medication Administration Record) ================= *@
                <h6 class="mb-2"><i class="fas fa-notes-medical me-1 text-danger"></i> Medication Administration Record (MAR)</h6>
                <div id="marTabContent">
                    <div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div> Loading MAR...</div>
                </div>

            </div>

        </div>
    </div>
</div>

@* ============================= ADD MODALS ============================= *@

<div class="modal fade" id="addGeneralOrderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="addGeneralOrderForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IPDId" value="@ipdId" />
                <input type="hidden" name="dayNumber" id="goDayNumber" value="@Model.ActiveDay" />
                <div class="modal-header"><h5 class="modal-title">Add New General Order</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="alert alert-light border py-1 px-2 mb-3 small" id="goAddingForDayLabel">Adding for <strong>Day @Model.ActiveDay</strong></div>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label">Order Details</label>
                            <textarea name="OrderDetails" id="goDetails" class="form-control" rows="3" required placeholder="e.g. IV NS 500 ml with Inj. Cone, Inj. Ondem, Inj. Dexona"></textarea>
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" id="goSaveTemplate" name="saveAsTemplate" value="true">
                                <label class="form-check-label" for="goSaveTemplate">Save as Template</label>
                            </div>
                            <input type="text" id="goTemplateName" name="templateName" class="form-control mt-1 d-none" placeholder="Template Name">
                            <label class="form-label mt-3">Priority</label>
                            <select name="Priority" class="form-select">
                                <option value="Routine">Routine</option>
                                <option value="Urgent">Urgent</option>
                                <option value="STAT">STAT</option>
                            </select>
                            <label class="form-label mt-3">Ordering Doctor</label>
                            <select name="DoctorId" class="form-select" asp-items="ViewBag.Doctors" required><option value="">-- Select --</option></select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Templates</label>
                            <input type="text" id="goTemplateSearch" class="form-control mb-2" placeholder="Search Template">
                            <div id="goTemplateList" class="list-group" style="max-height:260px; overflow-y:auto;"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="goSubmitAddBtn" class="btn btn-outline-primary"><i class="fas fa-plus me-1"></i> Submit &amp; Add</button>
                    <button type="button" id="goSubmitBtn" class="btn btn-primary"><i class="fas fa-check me-1"></i> Submit</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

