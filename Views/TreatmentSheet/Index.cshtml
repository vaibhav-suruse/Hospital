@section Scripts {
    <script>
        var ipdId = @ipdId;
        var currentDay = @Model.ActiveDay;

        function getGlobalToken() {
            return document.querySelector('#globalTokenForm input[name="__RequestVerificationToken"]').value;
        }

        function showAlert(message, type) {
            var box = document.getElementById('pageAlert');
            box.innerHTML = '<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show py-2">' +
                message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
            setTimeout(function () { box.innerHTML = ''; }, 4000);
        }

        // Generic helper: submit a <form> element via fetch (multipart/form-data,
        // so the form's own @@Html.AntiForgeryToken() hidden field is included
        // automatically) and hand back the parsed JSON result.
        function ajaxSubmitForm(url, formEl, callback) {
            var fd = new FormData(formEl);
            fetch(url, { method: 'POST', body: fd })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) { callback(res); }
                    else { showAlert(res.message || 'Something went wrong.', 'danger'); }
                })
                .catch(function (err) { showAlert('Request failed: ' + err, 'danger'); });
        }

        // Generic helper for one-click row actions (Discontinue / Delete / Set
        // Status) that don't have their own visible <form> - builds a small
        // FormData payload and attaches the page-wide antiforgery token.
        function ajaxPost(url, dataObj, callback) {
            var fd = new FormData();
            for (var k in dataObj) fd.append(k, dataObj[k]);
            fd.append('__RequestVerificationToken', getGlobalToken());
            fetch(url, { method: 'POST', body: fd })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) { callback(res); }
                    else { showAlert(res.message || 'Something went wrong.', 'danger'); }
                })
                .catch(function (err) { showAlert('Request failed: ' + err, 'danger'); });
        }

        function reloadGeneralOrders() {
            fetch('@Url.Action("GeneralOrdersPartial", "TreatmentSheet")?ipdId=' + ipdId + '&dayNumber=' + currentDay, { cache: 'no-store' })
                .then(function (r) { return r.text(); })
                .then(function (html) { document.getElementById('generalOrdersContainer').innerHTML = html; })
                .catch(function () { showAlert('Could not refresh General Orders. Please reload the page.', 'danger'); });
        }
        function reloadMedications() {
            fetch('@Url.Action("MedicationsPartial", "TreatmentSheet")?ipdId=' + ipdId + '&dayNumber=' + currentDay, { cache: 'no-store' })
                .then(function (r) { return r.text(); })
                .then(function (html) { document.getElementById('medicationsContainer').innerHTML = html; wireMedicationDrag(); })
                .catch(function () { showAlert('Could not refresh Medications. Please reload the page.', 'danger'); });
        }
        function reloadInvestigations() {
            fetch('@Url.Action("InvestigationsPartial", "TreatmentSheet")?ipdId=' + ipdId + '&dayNumber=' + currentDay, { cache: 'no-store' })
                .then(function (r) { return r.text(); })
                .then(function (html) { document.getElementById('investigationsContainer').innerHTML = html; })
                .catch(function () { showAlert('Could not refresh Investigations. Please reload the page.', 'danger'); });
        }
        function reloadMAR() {
            var target = document.getElementById('marTabContent');
            target.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div> Loading MAR...</div>';
            fetch('@Url.Action("DayMAR", "TreatmentSheet")?ipdId=' + ipdId + '&dayNumber=' + currentDay, { cache: 'no-store' })
                .then(function (r) { return r.text(); })
                .then(function (html) { target.innerHTML = html; })
                .catch(function () { target.innerHTML = '<div class="alert alert-danger">Could not load MAR for this day.</div>'; });
        }

        // Keep every Add modal's "Adding for Day N" hint and hidden dayNumber
        // field in sync with whichever day tab is currently selected.
        function syncDayLabelsAndHiddenFields() {
            document.getElementById('goDayNumber').value = currentDay;
            document.getElementById('medDayNumber').value = currentDay;
            document.getElementById('invDayNumber').value = currentDay;
            var label = 'Adding for <strong>Day ' + currentDay + '</strong>';
            document.getElementById('goAddingForDayLabel').innerHTML = label;
            document.getElementById('medAddingForDayLabel').innerHTML = label;
            document.getElementById('invAddingForDayLabel').innerHTML = label;
        }

        // One day-tab bar now drives all four sections at once.
        function loadDay(day) {
            currentDay = day;
            document.querySelectorAll('.day-tab-btn').forEach(function (btn) {
                btn.classList.toggle('active', parseInt(btn.dataset.day) === day);
            });
            syncDayLabelsAndHiddenFields();
            reloadGeneralOrders();
            reloadMedications();
            reloadInvestigations();
            reloadMAR();
        }
        document.querySelectorAll('.day-tab-btn').forEach(function (btn) {
            btn.addEventListener('click', function () { loadDay(parseInt(btn.dataset.day)); });
        });

        function closeModal(id) {
            var el = document.getElementById(id);
            var inst = bootstrap.Modal.getInstance(el);
            if (inst) { inst.hide(); }
            cleanupStrayModalBackdrops();
        }

        // Bootstrap occasionally leaves a stray .modal-backdrop (and the
        // body's "modal-open" lock, which is exactly what makes the page look
        // greyed-out and stop scrolling) behind after a modal is hidden right
        // around an AJAX DOM swap elsewhere on the page. This runs after every
        // hide - via any path: our own Submit/Submit&Add buttons, the modal's
        // own Cancel/X button, or clicking the backdrop - and forcibly clears
        // the leftover backdrop/body-lock whenever no modal is actually open.
        function cleanupStrayModalBackdrops() {
            setTimeout(function () {
                if (!document.querySelector('.modal.show')) {
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('overflow');
                    document.body.style.removeProperty('padding-right');
                    document.querySelectorAll('.modal-backdrop').forEach(function (bd) { bd.remove(); });
                }
            }, 350); // just past Bootstrap's ~300ms fade-out transition
        }
        document.addEventListener('hidden.bs.modal', cleanupStrayModalBackdrops);

        // =====================================================================
        // GENERAL ORDER - templates, add (+ Submit & Add), edit, status, delete
        // =====================================================================
        var goTemplateSearch = document.getElementById('goTemplateSearch');
        var goTemplateList = document.getElementById('goTemplateList');
        var goDetails = document.getElementById('goDetails');

        function loadGoTemplates(term) {
            fetch('@Url.Action("SearchGeneralOrderTemplates", "TreatmentSheet")?term=' + encodeURIComponent(term || ''), { cache: 'no-store' })
                .then(r => r.json())
                .then(data => {
                    goTemplateList.innerHTML = '';
                    (data || []).forEach(function (t) {
                        var a = document.createElement('a');
                        a.href = '#'; a.className = 'list-group-item list-group-item-action py-1';
                        a.textContent = t.templateName;
                        a.onclick = function (e) { e.preventDefault(); goDetails.value = t.templateText; };
                        goTemplateList.appendChild(a);
                    });
                });
        }
        goTemplateSearch.addEventListener('input', function () { loadGoTemplates(this.value); });
        document.getElementById('addGeneralOrderModal').addEventListener('shown.bs.modal', function () { loadGoTemplates(''); });
        document.getElementById('goSaveTemplate').addEventListener('change', function () {
            document.getElementById('goTemplateName').classList.toggle('d-none', !this.checked);
        });

        function resetAddGeneralOrderForm() {
            document.getElementById('addGeneralOrderForm').reset();
            document.getElementById('goTemplateName').classList.add('d-none');
        }

        document.getElementById('goSubmitBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("AddGeneralOrder", "TreatmentSheet")', document.getElementById('addGeneralOrderForm'), function () {
                reloadGeneralOrders(); showAlert('General order added.'); closeModal('addGeneralOrderModal'); resetAddGeneralOrderForm();
            });
        });
        document.getElementById('goSubmitAddBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("AddGeneralOrder", "TreatmentSheet")', document.getElementById('addGeneralOrderForm'), function () {
                reloadGeneralOrders(); showAlert('General order added - add another below.');
                resetAddGeneralOrderForm(); goDetails.focus();
            });
        });

        document.getElementById('editGoSubmitBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("EditGeneralOrder", "TreatmentSheet")', document.getElementById('editGeneralOrderForm'), function () {
                reloadGeneralOrders(); showAlert('General order updated.'); closeModal('editGeneralOrderModal');
            });
        });

        document.getElementById('generalOrdersContainer').addEventListener('click', function (e) {
            var editBtn = e.target.closest('.go-edit-btn');
            if (editBtn) {
                document.getElementById('editGoId').value = editBtn.dataset.id;
                document.getElementById('editGoDetails').value = editBtn.dataset.details;
                document.getElementById('editGoPriority').value = editBtn.dataset.priority;
                new bootstrap.Modal(document.getElementById('editGeneralOrderModal')).show();
                return;
            }
            var statusBtn = e.target.closest('.go-status-btn');
            if (statusBtn) {
                ajaxPost('@Url.Action("SetGeneralOrderStatus", "TreatmentSheet")',
                    { id: statusBtn.dataset.id, status: statusBtn.dataset.status, ipdId: ipdId },
                    function () { reloadGeneralOrders(); showAlert('Order marked ' + statusBtn.dataset.status + '.'); });
                return;
            }
            var delBtn = e.target.closest('.go-delete-btn');
            if (delBtn) {
                if (!confirm('Remove this order?')) return;
                ajaxPost('@Url.Action("DeleteGeneralOrder", "TreatmentSheet")',
                    { id: delBtn.dataset.id, ipdId: ipdId },
                    function () { reloadGeneralOrders(); showAlert('Order removed.'); });
            }
        });

        // =====================================================================
        // MEDICINE - search, add (+ Submit & Add), edit, discontinue, reorder
        // =====================================================================
        var medSearch = document.getElementById('medSearch');
        var medSearchResults = document.getElementById('medSearchResults');
        var medMedicineId = document.getElementById('medMedicineId');

        medSearch.addEventListener('input', function () {
            var term = this.value;
            medMedicineId.value = '';
            if (!term || term.length < 2) { medSearchResults.innerHTML = ''; return; }
            fetch('@Url.Action("SearchMedicine", "TreatmentSheet")?term=' + encodeURIComponent(term), { cache: 'no-store' })
                .then(r => r.json())
                .then(data => {
                    medSearchResults.innerHTML = '';
                    (data || []).slice(0, 10).forEach(function (m) {
                        var a = document.createElement('a');
                        a.href = '#'; a.className = 'list-group-item list-group-item-action py-1';
                        a.textContent = m.medicineName;
                        a.onclick = function (e) {
                            e.preventDefault();
                            medSearch.value = m.medicineName;
                            medMedicineId.value = m.medicineId;
                            medSearchResults.innerHTML = '';
                        };
                        medSearchResults.appendChild(a);
                    });
                });
        });

        document.querySelectorAll('.duration-radio').forEach(function (r) {
            r.addEventListener('change', function () { document.getElementById('medDays').disabled = (this.value !== 'Duration'); });
        });
        document.querySelectorAll('.edit-duration-radio').forEach(function (r) {
            r.addEventListener('change', function () { document.getElementById('editMedDays').disabled = (this.value !== 'Duration'); });
        });

        function resetAddMedicineForm() {
            var keepDoctor = document.getElementById('medDoctorId').value;
            document.getElementById('addMedicineForm').reset();
            medSearchResults.innerHTML = '';
            medMedicineId.value = '';
            document.getElementById('medDoctorId').value = keepDoctor; // same doctor is doing the round - keep it selected
        }

        document.getElementById('medSubmitBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("AddMedicine", "TreatmentSheet")', document.getElementById('addMedicineForm'), function () {
                reloadMedications(); showAlert('Medicine added.'); closeModal('addMedicineModal'); resetAddMedicineForm();
            });
        });
        document.getElementById('medSubmitAddBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("AddMedicine", "TreatmentSheet")', document.getElementById('addMedicineForm'), function () {
                reloadMedications(); showAlert('Medicine added - add another below.');
                resetAddMedicineForm(); medSearch.focus();
            });
        });

        document.getElementById('editMedSubmitBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("EditMedicine", "TreatmentSheet")', document.getElementById('editMedicineForm'), function () {
                reloadMedications(); showAlert('Medicine order updated.'); closeModal('editMedicineModal');
            });
        });

        document.getElementById('medicationsContainer').addEventListener('click', function (e) {
            var editBtn = e.target.closest('.med-edit-btn');
            if (editBtn) {
                var d = editBtn.dataset;
                document.getElementById('editMedId').value = d.id;
                document.getElementById('editMedMedicineId').value = d.medicineId;
                document.getElementById('editMedNameLabel').textContent = d.medicineName;
                document.getElementById('editMedDosage').value = d.dosage || '';
                document.getElementById('editMedRoute').value = d.route || 'Oral';
                document.getElementById('editMedMorning').checked = (d.morning === 'true');
                document.getElementById('editMedAfternoon').checked = (d.afternoon === 'true');
                document.getElementById('editMedEvening').checked = (d.evening === 'true');
                document.getElementById('editMedFrequencyText').value = d.frequencyText || '';
                document.getElementById('editMedInstructions').value = d.instructions || '';
                document.getElementById('editMedQty').value = d.qty || '';

                var food = d.foodInstruction || 'None';
                document.getElementById('editMedFoodBefore').checked = (food === 'Before Food');
                document.getElementById('editMedFoodAfter').checked = (food === 'After Food');
                document.getElementById('editMedFoodNone').checked = (food !== 'Before Food' && food !== 'After Food');

                var dur = d.durationType || 'Duration';
                document.getElementById('editMedDurFixed').checked = (dur === 'Duration');
                document.getElementById('editMedDurTillDisc').checked = (dur === 'Add Till Discontinued');
                document.getElementById('editMedDurSos').checked = (dur === 'SOS');
                document.getElementById('editMedDays').value = d.days || '';
                document.getElementById('editMedDays').disabled = (dur !== 'Duration');

                new bootstrap.Modal(document.getElementById('editMedicineModal')).show();
                return;
            }
            var discBtn = e.target.closest('.med-discontinue-btn');
            if (discBtn) {
                if (!confirm('Discontinue this medicine?')) return;
                ajaxPost('@Url.Action("DiscontinueMedicine", "TreatmentSheet")',
                    { prescriptionId: discBtn.dataset.id, ipdId: ipdId },
                    function () { reloadMedications(); showAlert('Medicine discontinued.'); });
            }
        });

        function wireMedicationDrag() {
            var tbody = document.getElementById('medicationsTbody');
            if (!tbody) return;
            var dragRow = null;
            tbody.querySelectorAll('tr[data-id]').forEach(function (row) {
                row.setAttribute('draggable', 'true');
                row.addEventListener('dragstart', function () { dragRow = row; });
                row.addEventListener('dragover', function (e) { e.preventDefault(); });
                row.addEventListener('drop', function (e) {
                    e.preventDefault();
                    if (!dragRow || dragRow === row) return;
                    var rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
                    var dragIdx = rows.indexOf(dragRow), dropIdx = rows.indexOf(row);
                    if (dragIdx < dropIdx) row.after(dragRow); else row.before(dragRow);

                    var orderedIds = Array.from(tbody.querySelectorAll('tr[data-id]')).map(r => parseInt(r.dataset.id)).filter(Boolean);
                    fetch('@Url.Action("ReorderMedicines", "TreatmentSheet")?ipdId=' + ipdId, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(orderedIds)
                    });
                });
            });
        }

        // =====================================================================
        // INVESTIGATIONS - add (+ Submit & Add), edit, delete
        // =====================================================================
        function resetAddInvestigationForm() {
            var keepDoctor = document.querySelector('#addInvestigationForm select[name="doctorId"]').value;
            document.getElementById('addInvestigationForm').reset();
            document.querySelector('#addInvestigationForm select[name="doctorId"]').value = keepDoctor;
        }

        document.getElementById('invSubmitBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("AddInvestigation", "TreatmentSheet")', document.getElementById('addInvestigationForm'), function () {
                reloadInvestigations(); showAlert('Investigation ordered.'); closeModal('addInvestigationModal'); resetAddInvestigationForm();
            });
        });
        document.getElementById('invSubmitAddBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("AddInvestigation", "TreatmentSheet")', document.getElementById('addInvestigationForm'), function () {
                reloadInvestigations(); showAlert('Investigation ordered - add another below.');
                resetAddInvestigationForm(); document.getElementById('invTestName').focus();
            });
        });

        document.getElementById('editInvSubmitBtn').addEventListener('click', function () {
            ajaxSubmitForm('@Url.Action("EditInvestigation", "TreatmentSheet")', document.getElementById('editInvestigationForm'), function () {
                reloadInvestigations(); showAlert('Investigation updated.'); closeModal('editInvestigationModal');
            });
        });

        document.getElementById('investigationsContainer').addEventListener('click', function (e) {
            var editBtn = e.target.closest('.inv-edit-btn');
            if (editBtn) {
                var d = editBtn.dataset;
                document.getElementById('editInvId').value = d.id;
                document.getElementById('editInvType').value = d.type;
                document.getElementById('editInvTestName').value = d.testName;
                document.getElementById('editInvPriority').value = d.priority;
                document.getElementById('editInvInstructions').value = d.instructions || '';
                new bootstrap.Modal(document.getElementById('editInvestigationModal')).show();
                return;
            }
            var delBtn = e.target.closest('.inv-delete-btn');
            if (delBtn) {
                if (!confirm('Cancel this investigation?')) return;
                ajaxPost('@Url.Action("DeleteInvestigation", "TreatmentSheet")',
                    { id: delBtn.dataset.id, ipdId: ipdId },
                    function () { reloadInvestigations(); showAlert('Investigation cancelled.'); });
            }
        });

        // =====================================================================
        // MAR record handler (dose Given/Missed/Refused) - delegated since the
        // grid is swapped in via reloadMAR() every time the day tab changes.
        // =====================================================================
        var marTabContent = document.getElementById('marTabContent');
        marTabContent.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'marNurseGlobal' && e.target.value) {
                e.target.classList.remove('is-invalid');
                var nurseWarning = document.getElementById('marNurseWarning');
                if (nurseWarning) nurseWarning.classList.add('d-none');
            }
        });
        marTabContent.addEventListener('click', function (e) {
            var btn = e.target.closest('.mar-record-btn');
            if (!btn) return;
            var marId = btn.dataset.marId;
            var status = btn.dataset.status;
            var nurseSelect = document.getElementById('marNurseGlobal');
            var nurseWarning = document.getElementById('marNurseWarning');
            var nurseId = nurseSelect ? nurseSelect.value : '';
            if (!nurseId) {
                if (nurseWarning) nurseWarning.classList.remove('d-none');
                if (nurseSelect) { nurseSelect.classList.add('is-invalid'); nurseSelect.focus(); }
                return;
            }
            if (nurseWarning) nurseWarning.classList.add('d-none');
            if (nurseSelect) nurseSelect.classList.remove('is-invalid');
            fetch('@Url.Action("RecordAdministration", "TreatmentSheet")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ MarId: parseInt(marId), Status: status, GivenBy: parseInt(nurseId) })
            })
            .then(r => r.json())
            .then(function (res) {
                if (res.success) reloadMAR();
                else showAlert(res.message || 'Could not record.', 'danger');
            });
        });

        // Initial load: MAR grid for whichever day is active on page load.
        // (General Orders / Medications / Investigations are already rendered
        // server-side for that same day, so they don't need a first fetch.)
        reloadMAR();
        wireMedicationDrag();
    </script>
}
