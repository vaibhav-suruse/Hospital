                    <button type="button" id="medSubmitBtn" class="btn btn-success"><i class="fas fa-check me-1"></i> Submit</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

