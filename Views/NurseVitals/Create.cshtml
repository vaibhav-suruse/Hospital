@* Views/NurseVitals/Create.cshtml *@
@model WebApplicationSampleTest2.Models.IPDNurseVitals
@{
    ViewData["Title"] = "";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span><i class="fas fa-heartbeat me-1"></i> Add Nurse Vitals</span>
            <div>
                <span id="overallStatusPill" class="badge bg-light text-dark me-2">Awaiting readings</span>
                <button type="button" class="btn btn-sm btn-light" onclick="copyPrevious()">
                    <i class="fas fa-copy me-1"></i> Copy Previous Reading
                </button>
            </div>
        </div>
        <div class="card-body">

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info py-2"><i class="fas fa-info-circle me-1"></i> @TempData["Info"]</div>
            }

            <form asp-action="Create" method="post" id="vitalsForm">
                <div asp-validation-summary="All" class="text-danger"></div>
                <partial name="_NurseVitalsFormFields" model="Model" />

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save Vitals
                    </button>
                    <a asp-controller="IPDAdmission"
                       asp-action="Details"
                       asp-route-id="@Model.IPDId"
                       class="btn btn-secondary ms-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_NurseVitalsFormScripts" model="Model" />
