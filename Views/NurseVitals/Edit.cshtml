@* Views/NurseVitals/Edit.cshtml *@
@model WebApplicationSampleTest2.Models.IPDNurseVitals
@{
    ViewData["Title"] = "Edit Nurse Vitals";
    int activeDay = ViewBag.ActiveDay != null ? (int)ViewBag.ActiveDay : 0;
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-heartbeat me-1"></i> Edit Nurse Vitals
                <span id="overallStatusPill" class="badge bg-light text-dark ms-3">Awaiting readings</span>
            </div>
            <div>
                <button type="button" class="btn btn-sm btn-light me-2" onclick="copyPrevious()">
                    <i class="fas fa-copy me-1"></i> Copy Previous Reading
                </button>
                <a asp-controller="NurseVitals"
                   asp-action="Timeline"
                   asp-route-ipdId="@Model.IPDId"
                   asp-route-activeDay="@activeDay"
                   class="btn btn-sm btn-light">
                    <i class="fas fa-arrow-left me-1"></i> Back to Timeline
                </a>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" id="vitalsForm">
                <div asp-validation-summary="All" class="text-danger"></div>
                <partial name="_NurseVitalsFormFields" model="Model" />

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save Changes
                    </button>
                    <a asp-controller="NurseVitals"
                       asp-action="Timeline"
                       asp-route-ipdId="@Model.IPDId"
                       asp-route-activeDay="@activeDay"
                       class="btn btn-secondary ms-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_NurseVitalsFormScripts" model="Model" />
