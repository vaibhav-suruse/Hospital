        function applyLanguage(lang) {
            var dict = T[lang] || T['en'];
            document.getElementById('lbl-lang').textContent = dict['lbl-lang'];
            document.querySelectorAll('[data-key]').forEach(function (el) {
                var k = el.getAttribute('data-key');
                if (dict[k]) el.textContent = dict[k];
            });
        }

        /* ── PDF DOWNLOAD ── */
        function downloadPDF() {
            var el = document.getElementById('billContent');
            html2canvas(el, { scale: 2 }).then(function (canvas) {
                var { jsPDF } = window.jspdf;
                var pdf = new jsPDF('p', 'mm', 'a4');
                var pw = pdf.internal.pageSize.getWidth();
                var ph = pdf.internal.pageSize.getHeight();
                var imgData = canvas.toDataURL('image/png');
                var imgH = (canvas.height * pw) / canvas.width;
                var pos = 0;
                pdf.addImage(imgData, 'PNG', 0, pos, pw, imgH);
                var left = imgH - ph;
                while (left > 0) {
                    pos = left - imgH;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, pos, pw, imgH);
                    left -= ph;
                }
                pdf.save('Bill_' + '@billNumber' + '.pdf');
            });
        }
