@model List<InventoryModel>

<!-- ═══════════════════ HERO ═══════════════════ -->
<div class="pharm-hero d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <div class="pharm-hero-icon"><i class="bx bx-box"></i></div>
        <div>
            <h4>Inventory Management</h4>
            <p>Monitor medicine stock, batch expiry &amp; reorder levels</p>
        </div>
    <div class="d-flex">
        <form method="get" asp-action="Index" class="d-flex me-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2" placeholder="Search medicine..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-search"></i> Search</button>
        </form>
        <a class="btn btn-light btn-sm" asp-controller="Inventory" asp-action="Create">
            <i class="bx bx-plus me-1"></i> Add Medicine
        </a>
    </div>

<div class="card pharm-card">
    <div class="pharm-card-header">
        <h5><i class="bx bx-collection me-2" style="color:var(--pharm-primary)"></i>Medicines &amp; Stock</h5>
        <span class="pharm-badge badge-soft-primary">@(Model?.Count ?? 0) records</span>
    </div>
    <div class="pharm-card-body p-0">
        <div class="table-responsive">
            <table class="table pharm-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Medicine</th>
                        <th>Category</th>
                        <th>Stock Level</th>
                        <th>Unit</th>
                        <th>Expiry</th>
                        <th class="text-end">MRP</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            bool isLow = item.Status == "Low Stock";
                            int stockPct = Math.Min(item.Stock, 100);
                            <tr>
                                <td><span class="text-muted">#@i</span></td>
                                <td><strong>@item.MedicineName</strong></td>
                                <td><span class="pharm-badge badge-soft-info">@item.CategoryName</span></td>
                                <td style="width:170px">
                                    <div class="d-flex justify-content-between fs-7 mb-1">
                                        <span class="fw-bold @(isLow ? "text-danger" : "text-success")">@item.Stock</span>
                                        <span class="text-muted">@item.Unit</span>
                                    </div>
                                    <div class="stock-progress">
                                        <div class="bar @(isLow ? "bg-danger" : "bg-success")" style="width:@(stockPct)%"></div>
                                </td>
                                <td>@item.Unit</td>
                                <td class="text-muted">@item.ExpiryDate?.ToString("MM/yyyy")</td>
                                <td class="text-end fw-semibold">₹@item.MRP</td>
                                <td>@item.SupplierName</td>
                                <td>
                                    @if (isLow)
                                    {
                                        <span class="pharm-badge badge-soft-danger"><i class="bx bx-error-circle me-1"></i>Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="pharm-badge badge-soft-success"><i class="bx bx-check-circle me-1"></i>In Stock</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-controller="Inventory" asp-route-batchId="@item.BatchId" asp-route-medicineId="@item.MedicineId" class="btn btn-sm btn-outline-primary"><i class="bx bx-edit"></i></a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@item.BatchId','@item.MedicineId')"><i class="bx bx-trash"></i></button>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade pharm-modal" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header danger">
                <h5 class="modal-title"><i class="bx bx-trash me-2"></i> Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this record?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-grad-danger" id="confirmDeleteBtn">Delete</button>
            </div>
    </div>

@section Scripts {
    <script>
        var deleteUrl = '';

        function confirmDelete(batchId, medicineId) {
            deleteUrl = '/Inventory/Delete?batchId=' + batchId + '&medicineId=' + medicineId;
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            window.location.href = deleteUrl;
        });
    </script>
}
